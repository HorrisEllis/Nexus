use "../field.eg" as F
use "../causal.eg" as C

let empty = F.field({ a: 1, b: 2, c: 3, d: 4 }, [])

test "a declared cause is causal; time order alone is not (CF1's flaw cannot recur)" {
  expect C.cause(empty, "a", "b", "explicit").verdict.admitted == true
  let t = C.cause(empty, "a", "b", "time")
  expect t.verdict.admitted == false
  expect len(t.field.relations) == 0, "no edge from a time guess"
}

test "a cycle and a diamond are refused and named" {
  let f1 = C.cause(empty, "a", "b", "explicit").field
  let f2 = C.cause(f1, "b", "c", "rule").field
  let cyc = C.cause(f2, "c", "a", "explicit")
  expect cyc.verdict.admitted == false
  expect find_text(cyc.verdict.why, "cycle") >= 0
  let dia = C.cause(f2, "a", "c", "explicit")
  expect dia.verdict.admitted == false
  expect find_text(dia.verdict.why, "diamond") >= 0
}

test "chain walks back to the root; reaches sees through others" {
  let f1 = C.cause(empty, "a", "b", "explicit").field
  let f2 = C.cause(f1, "b", "c", "explicit").field
  let f3 = C.cause(f2, "c", "d", "adapter").field
  expect C.chain(f3, "d") == ["c", "b", "a"]
  expect C.reaches(f3, "a", "d") == true
  expect C.reaches(f3, "d", "a") == false
}

test "sigma and delta measure deviation and gaps" {
  expect C.sigma([2, 2, 2], 5) == 0, "no variation: no deviation"
  expect C.sigma([1, 3], 5) == 3
  expect C.delta(10, 7) == 3
  expect C.delta(7, 10) == 3
}
