// language.eg — CIE15: the rest of the language natively, one line per feature as it lands; native.test holds it equal to eg run.
let xs = 1..5
print(xs, len(0..0))
expect len(xs) == 4, "four"
print(upper("abc"), lower("XyZ"), ["a", "b"] |> map(upper))
try { expect 1 == 2 } else e { print(e.message) }
try { expect 1 == 2, "one is not two" } else e { print(e.message) }
try { expect 3 } else e { print(e.message) }
// record, gap, promote, gaps(), random() and uid() (CIE15): the seeded generator draws the same numbers natively, so a gap's id, and the
// ledger's hashes that carry it, are equal
print(random(), uid("x"), uid())
record "note" { said: "hello" }
gap "a test gap" pressure 0.4 type logical
promote "idea" with proof false
print(gaps() |> map(fn(g) = "{g.id} {g.type}/{g.pressure}"))
// whatif (CIE15): the branch's records are put back, one whatif entry is kept, and the branch's draw is not the world's
let branch = whatif {
  record "inside" { n: 1 }
  random()
}
print("branch drew", branch, "the world draws", random())
for e in ledger() { print(e.seq, e.kind, e.hash) }
