// lang/native/lower.eg — CIE4 slice b (Nexus phase CIE4_native_components): a program's compartments, top-level on handlers and emits,
// rewritten into calls to lang/cie/world.eg, so the native compiler builds them with no new runtime. The rewrite is the one written by hand
// in lang/test/world/counter.world.eg; native.test 'world' holds the two to the same ledger, hash for hash, as the interpreter.
// James, 2026-11-06: "the moment js is removed from emerge it becomes the replacement. focus on that first. no more js, we focus on .eg"
//
//   lower(ast, version) → ast        unchanged when the program declares no compartment, on handler or emit
//
//   compartment C { id, state { … }, constraint k hard|soft [cost n] { e }, on "s" (p) { … }, fn f() { … } }
//     → fn __C_f() { let state = __world.state_of("C") … }       a lens: reads a copy
//       let __h_C_0 = fn(__s, p) { var state = __s … }           a handler: writes its working copy
//       __world.declare({ name, id, state, constraints: [{ name, hard, cost, check: fn(state) = e }], handlers: [{ signal, run }] })
//   on "s" (p) { … }      → __world.listen("s", fn(p) { … })
//   emit "s" { … }        → __world.signal("s", { … })
//   C.state · C.f(…) · spent() · ledger() · ledger_verify()
//                        → __world.state_of("C") · __C_f(…) · __world.spent() · __world.entries() · __world.verify()
//   first: use "<cie>/world.eg" as __world and __world.start(0, version); last: __world.finish() (the closing checkpoint)

let W = "__world"
let RX = "__regex"
let REGEX_PATH = "<cie>/regex.eg"
let JSONM = "__json"
let JSON_PATH = "<cie>/json.eg"
fn is_parse_json(n) = has(n, "type") and n.type == "Call" and n.callee.type == "Ident" and n.callee.name == "parse_json" and len(n.args) == 1
fn uses_parse_json(n) {
  if type_of(n) == "list" {
    for x in n { if uses_parse_json(x) { return true } }
    return false
  }
  if type_of(n) != "map" { return false }
  if is_parse_json(n) { return true }
  for k, v in n { if uses_parse_json(v) { return true } }
  return false
}
let SORT = "__sort"
let SORT_PATH = "<cie>/sort.eg"
/** a call to the builtin sort_by (not a fn the program defines itself) */
fn is_sort_by(n, own) = has(n, "type") and n.type == "Call" and n.callee.type == "Ident" and n.callee.name == "sort_by" and not own and (len(n.args) == 2 or len(n.args) == 3)
fn uses_sort_by(n, own) {
  if type_of(n) == "list" {
    for x in n { if uses_sort_by(x, own) { return true } }
    return false
  }
  if type_of(n) != "map" { return false }
  if is_sort_by(n, own) { return true }
  for k, v in n { if uses_sort_by(v, own) { return true } }
  return false
}
/** does any node below n use the matches operator? */
fn uses_matches(n) {
  if type_of(n) == "list" {
    for x in n { if uses_matches(x) { return true } }
    return false
  }
  if type_of(n) != "map" { return false }
  if has(n, "type") and n.type == "Binary" and n.op == "matches" { return true }
  for k, v in n { if uses_matches(v) { return true } }
  return false
}
/** text matches pattern → __regex.search(text, pattern): lang/cie/regex.eg, JavaScript's RegExp semantics in Emerge (CIE15) */
var OWN_SORT_BY = false
fn rx_only(n) {
  if type_of(n) == "list" {
    var out = []
    for x in n { out[len(out)] = rx_only(x) }
    return out
  }
  if type_of(n) != "map" { return n }
  // parse_json(text) → __json.parse(text): lang/native/json.eg, the JSON reader in Emerge (CIE6, found writing the checker's judge)
  if is_parse_json(n) { return mk("Call", n, { callee: mk("Member", n, { obj: mk("Ident", n, { name: JSONM }), name: "parse" }), args: rx_only(n.args) }) }
  if is_sort_by(n, OWN_SORT_BY) {
    var args = rx_only(n.args)
    if len(args) == 2 { args = push(args, mk("Str", n, { parts: ["asc"] })) }
    return mk("Call", n, { callee: mk("Member", n, { obj: mk("Ident", n, { name: SORT }), name: "by" }), args: args })
  }
  if has(n, "type") and n.type == "Binary" and n.op == "matches" {
    return mk("Call", n, { callee: mk("Member", n, { obj: mk("Ident", n, { name: RX }), name: "search" }), args: [rx_only(n.l), rx_only(n.r)] })
  }
  var out = {}
  for k, v in n { out[k] = rx_only(v) }
  return out
}
let WORLD_PATH = "<cie>/world.eg"

fn mk(type, at, fields) {
  var m = { type: type, line: at.line, col: at.col }
  for k, v in fields { m[k] = v }
  return m
}
fn ident(at, n) = mk("Ident", at, { name: n })
fn str_(at, s) = mk("Str", at, { parts: [s] })
fn call(at, callee, args) = mk("Call", at, { callee: callee, args: args })
fn wcall(at, fname, args) = call(at, mk("Member", at, { obj: ident(at, W), name: fname }), args)
fn ent(k, v) = { key: k, value: v }
fn map_(at, entries) = mk("Map", at, { entries: entries })
fn list_(at, items) = mk("List", at, { items: items })
fn stmt(at, ex) = mk("ExprStmt", at, { expr: ex })
fn param(at, n) = { name: n, type: null, line: at.line, col: at.col }
fn block(at, body) = mk("Block", at, { body: body })
fn lam(at, params, body) = mk("Lambda", at, { name: null, params: params, ret: null, body: block(at, body) })
fn let_(at, kind, name, ex) = mk("Let", at, { kind: kind, name: name, vtype: null, expr: ex })
fn opt_str(at, s) {
  if s == null { return mk("Null", at, {}) }
  return str_(at, s)
}

/** does any node below n have one of these types? */
fn uses_world(n) {
  if type_of(n) == "list" {
    for x in n { if uses_world(x) { return true } }
    return false
  }
  if type_of(n) != "map" { return false }
  if has(n, "type") and (n.type == "Compartment" or n.type == "On" or n.type == "Emit" or n.type == "EmitOut" or n.type == "Send" or n.type == "Wire" or n.type == "Contract" or n.type == "Record" or n.type == "Gap" or n.type == "Promote" or n.type == "Axiom" or n.type == "Whatif" or n.type == "Test" or n.type == "Kind" or n.type == "Spawn" or n.type == "Despawn") { return true }
  if has(n, "type") and n.type == "Call" and n.callee.type == "Ident" and has(WORLD_BUILTINS, n.callee.name) { return true }
  if has(n, "type") and n.type == "Call" and n.callee.type == "Ident" and (n.callee.name == "ledger" or n.callee.name == "spent" or n.callee.name == "ledger_verify") and len(n.args) == 0 { return true }
  for k, v in n { if uses_world(v) { return true } }
  return false
}

var comps = {}
var FILE = "<input>"
var KINDS = {}
var MODULES = {}
var HAS_TEMPLATES = false
let HANDLE_MEMBERS = { state: 1, id: 1, name: 1, intent: 1, namespace: 1, version: 1, uuid: 1, hooks: 1, template: 1, kinds: 1 }
/** is n a name the lowering resolves statically (a declared compartment, a module, the world)? */
fn static_obj(n) = n.type == "Ident" and (has(comps, n.name) or has(MODULES, n.name) or n.name == W)
/** a constraint's cost: its own, or its type's default_cost from primitives.eg (lang/runtime.js), 1 for every type there today */
fn cost_of(k) {
  if k.cost == null { return 1 }
  return k.cost
}
/** a kind and its parents, in order, once each (the checker's flatKind names) */
fn kind_names(name, acc) {
  var out = acc
  if out contains name or not has(KINDS, name) { return out }
  out = push(out, name)
  for p in KINDS[name].parents { out = kind_names(p.name, out) }
  return out
}
fn kinds_of(c) {
  var out = []
  for k in c.kinds { out = kind_names(k.name, out) }
  return out
}
/** the state fields the kinds type, each once, with the kind that typed it */
fn typed_of(names) {
  var out = []
  var seen = {}
  for k in names {
    for f in KINDS[k].state {
      if not has(seen, f.name) {
        seen[f.name] = true
        out = push(out, { name: f.name, type: f.type.name, nullable: f.type.nullable, kind: k })
      }
    }
  }
  return out
}
let WORLD_BUILTINS = { ledger: 1, spent: 1, ledger_verify: 1, components: 1, gaps: 1, random: 1, uid: 1 }
let MEMBERS = { id: 1, name: 1, intent: 1, namespace: 1, version: 1, uuid: 1, hooks: 1, template: 1, kinds: 1 }

/** rewrite one node and everything below it */
fn rw(n) {
  if type_of(n) == "list" {
    var out = []
    for x in n { out[len(out)] = rw(x) }
    return out
  }
  if type_of(n) != "map" { return n }
  if has(n, "type") {
    let t = n.type
    // lang/parser.js's State node: inside a compartment it is the state binding each handler and fn opens with
    if t == "State" { return mk("Ident", n, { name: "state" }) }
    if t == "Whatif" {
      // the block's last expression is the branch's value
      var body = rw(n.body.body)
      if len(body) > 0 and body[len(body) - 1].type == "ExprStmt" {
        let last = body[len(body) - 1]
        body[len(body) - 1] = mk("Return", last, { expr: last.expr })
      }
      return wcall(n, "whatif_branch", [lam(n, [], body), mk("Num", n, { value: n.line })])
    }
    if t == "Record" {
      var p = mk("Null", n, {})
      if n.payload != null { p = rw(n.payload) }
      return stmt(n, wcall(n, "record_entry", [rw(n.name), p]))
    }
    if t == "Gap" { return stmt(n, wcall(n, "open_gap", [rw(n.msg), rw(n.pressure), opt_str(n, n.gtype), mk("Num", n, { value: n.line }), str_(n, FILE)])) }
    if t == "Promote" { return stmt(n, wcall(n, "promote_value", [rw(n.value), rw(n.proof), mk("Num", n, { value: n.line }), str_(n, FILE)])) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "gaps" and len(n.args) == 0 { return wcall(n, "gaps", []) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "random" and len(n.args) == 0 { return wcall(n, "random", []) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "uid" and len(n.args) <= 1 {
      var a = [str_(n, "id")]
      if len(n.args) == 1 { a = [rw(n.args[0])] }
      return wcall(n, "uid", a)
    }
    if t == "EmitOut" {
      var p = mk("Null", n, {})
      if n.payload != null { p = rw(n.payload) }
      return stmt(n, wcall(n, "emit_out", [str_(n, n.hook), p]))
    }
    if t == "Send" {
      if has(n, "expr") { raise("{n.line}:{n.col}: send to an instance's hook is not in the native subset yet") }
      var p = mk("Null", n, {})
      if n.payload != null { p = rw(n.payload) }
      return stmt(n, wcall(n, "send_in", [str_(n, n.comp), str_(n, n.hook), p]))
    }
    if t == "Wire" { return stmt(n, wcall(n, "connect", [end_(n, n.from), end_(n, n.to), mk("Num", n, { value: n.line })])) }
    if t == "Spawn" { return wcall(n, "spawn_of", [str_(n, n.template), list_(n, rw(n.args))]) }
    if t == "Despawn" { return stmt(n, wcall(n, "despawn_of", [rw(n.expr)])) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "is_kind" and len(n.args) == 2 { return wcall(n, "is_kind_of", rw(n.args)) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "instances" and len(n.args) == 1 { return wcall(n, "instances_of", rw(n.args)) }
    // handles exist only where templates do: there, a member read or a method call on a value is asked of the world, which answers for an
    // instance (live, or an error if stale) and for a plain map alike
    if HAS_TEMPLATES and t == "Member" and not static_obj(n.obj) and has(HANDLE_MEMBERS, n.name) {
      return wcall(n, "member_any", [rw(n.obj), str_(n, n.name)])
    }
    if HAS_TEMPLATES and t == "Call" and n.callee.type == "Member" and not static_obj(n.callee.obj) {
      return wcall(n, "call_any", [rw(n.callee.obj), str_(n, n.callee.name), list_(n, rw(n.args))])
    }
    if t == "Emit" {
      var p = mk("Null", n, {})
      if n.payload != null { p = rw(n.payload) }
      return stmt(n, wcall(n, "signal", [rw(n.name), p]))
    }
    if t == "Member" and n.obj.type == "Ident" and has(comps, n.obj.name) and n.name == "state" {
      return wcall(n, "state_of", [str_(n, n.obj.name)])
    }
    if t == "Member" and n.obj.type == "Ident" and has(comps, n.obj.name) and has(MEMBERS, n.name) {
      return wcall(n, "member_of", [str_(n, n.obj.name), str_(n, n.name)])
    }
    if t == "Call" and n.callee.type == "Member" and n.callee.obj.type == "Ident" and has(comps, n.callee.obj.name) {
      return call(n, ident(n, "__" + n.callee.obj.name + "_" + n.callee.name), rw(n.args))
    }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "spent" and len(n.args) == 0 { return wcall(n, "spent", []) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "ledger" and len(n.args) == 0 { return wcall(n, "entries", []) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "components" and len(n.args) == 0 { return wcall(n, "components_graph", []) }
    if t == "Call" and n.callee.type == "Ident" and n.callee.name == "ledger_verify" and len(n.args) == 0 { return wcall(n, "verify", []) }
  }
  var out = {}
  for k, v in n { out[k] = rw(v) }
  return out
}

/** a wire end as data: { signal } or { comp, hook } */
fn end_(at, e) {
  if has(e, "signal") { return map_(at, [ent("signal", str_(at, e.signal))]) }
  if has(e, "expr") { return wcall(at, "end_of", [rw(e.expr), str_(at, e.hook)]) }
  if not has(comps, e.comp) { return wcall(at, "end_of", [ident(at, e.comp), str_(at, e.hook)]) }
  return map_(at, [ent("comp", str_(at, e.comp)), ent("hook", str_(at, e.hook))])
}
/** a shape { fields: [{ name, type: { name, nullable } }] } as data: [{ name, type, nullable }], or null */
fn shape_(at, sh) {
  if sh == null { return mk("Null", at, {}) }
  var fs = []
  for f in sh.fields {
    fs[len(fs)] = map_(at, [ent("name", str_(at, f.name)), ent("type", str_(at, f.type.name)), ent("nullable", mk("Bool", at, { value: f.type.nullable }))])
  }
  return list_(at, fs)
}
/** any value the parser kept as data (the contract's raw block) as a literal */
fn lit(at, v) {
  let t = type_of(v)
  if v == null { return mk("Null", at, {}) }
  if t == "string" { return str_(at, v) }
  if t == "num" { return mk("Num", at, { value: v }) }
  if t == "bool" { return mk("Bool", at, { value: v }) }
  if t == "list" {
    var items = []
    for x in v { items[len(items)] = lit(at, x) }
    return list_(at, items)
  }
  var es = []
  for k, x in v { es[len(es)] = ent(k, lit(at, x)) }
  return map_(at, es)
}
/** the state fields an expression reads (state.x), in order, once each: a constraint over a null one is a gap */
fn reads_of(n, acc) {
  var out = acc
  if type_of(n) == "list" {
    for x in n { out = reads_of(x, out) }
    return out
  }
  if type_of(n) != "map" { return out }
  if has(n, "type") and n.type == "Member" and (n.obj.type == "State" or (n.obj.type == "Ident" and n.obj.name == "state")) and not (out contains n.name) { out = push(out, n.name) }
  for k, v in n { out = reads_of(v, out) }
  return out
}
fn push_all(xs, ys) {
  var out = xs
  for y in ys { out[len(out)] = y }
  return out
}

fn lower_comp(c) {
  if c.isTemplate { return lower_template(c) }
  var items = []
  for f in c.fns {
    let body = push_all([let_(f, "let", "state", wcall(f, "state_of", [str_(f, c.name)]))], rw(f.body.body))
    items[len(items)] = mk("FnDecl", f, { name: "__" + c.name + "_" + f.name, params: f.params, ret: f.ret, body: block(f, body) })
  }
  var handlers = []
  var i = 0
  for h in c.handlers {
    let hn = "__h_" + c.name + "_" + str(i)
    var p = "__ev"
    if h.param != null { p = h.param }
    let body = push_all([let_(h, "var", "state", ident(h, "__s"))], rw(h.body.body))
    items[len(items)] = let_(h, "let", hn, lam(h, [param(h, "__s"), param(h, p)], body))
    handlers[len(handlers)] = map_(h, [ent("signal", str_(h, h.signal)), ent("run", ident(h, hn))])
    i += 1
  }
  var ins = []
  var j = 0
  for h in c.ins {
    let hn = "__in_" + c.name + "_" + str(j)
    var p = "__ev"
    if h.param != null { p = h.param }
    let body = push_all([let_(h, "var", "state", ident(h, "__s"))], rw(h.body.body))
    items[len(items)] = let_(h, "let", hn, lam(h, [param(h, "__s"), param(h, p)], body))
    ins[len(ins)] = map_(h, [ent("name", str_(h, h.name)), ent("shape", shape_(h, h.shape)), ent("run", ident(h, hn))])
    j += 1
  }
  var outs = []
  for o in c.outs { outs[len(outs)] = map_(c, [ent("name", str_(c, o.name)), ent("shape", shape_(c, o.shape))]) }
  var cons = []
  for k in c.constraints {
    let check = lam(c, [param(c, "state")], [mk("Return", c, { expr: rw(k.expr) })])
    cons[len(cons)] = map_(c, [ent("name", str_(c, k.name)), ent("hard", mk("Bool", c, { value: k.ctype == "hard" })),
      ent("cost", mk("Num", c, { value: cost_of(k) })), ent("boundary", mk("Bool", c, { value: k.boundary })), ent("check", check),
      ent("reads", lit(c, reads_of(k.expr, [])))])
  }
  var fields = []
  for f in c.state { fields[len(fields)] = ent(f.name, rw(f.expr)) }
  var spec_entries = [ent("name", str_(c, c.name)), ent("id", opt_str(c, c.id)), ent("intent", opt_str(c, c.intent)), ent("state", map_(c, fields)),
    ent("constraints", list_(c, cons)), ent("handlers", list_(c, handlers))]
  if c.isComponent {
    spec_entries = push_all(spec_entries, [ent("component", mk("Bool", c, { value: true })), ent("namespace", opt_str(c, c.namespace)),
      ent("version", opt_str(c, c.version)), ent("uuid", opt_str(c, c.uuid)), ent("ins", list_(c, ins)), ent("outs", list_(c, outs))])
    let kn = kinds_of(c)
    spec_entries = push_all(spec_entries, [ent("kinds", lit(c, kn)), ent("typed_state", lit(c, typed_of(kn)))])
  }
  let spec = map_(c, spec_entries)
  items[len(items)] = stmt(c, wcall(c, "declare", [spec]))
  return items
}

/** template T(p…) is K { … } → define_template("T", arity, fn(__args) { let __id = __args[0]; let p = __args[1] … return spec }): the
 *  handlers, hooks, constraints and lens fns are closures in the spec, so they see the instance's parameters */
fn lower_template(c) {
  let binds = fn(at, offset) {
    var out = []
    var i = 0
    for p in c.params {
      out = push(out, let_(at, "let", p.name, mk("Index", at, { obj: ident(at, "__args"), index: mk("Num", at, { value: i + offset }) })))
      i += 1
    }
    return out
  }
  var ins = []
  for h in c.ins {
    var p = "__ev"
    if h.param != null { p = h.param }
    let body = push_all([let_(h, "var", "state", ident(h, "__s"))], rw(h.body.body))
    ins = push(ins, map_(h, [ent("name", str_(h, h.name)), ent("shape", shape_(h, h.shape)), ent("run", lam(h, [param(h, "__s"), param(h, p)], body))]))
  }
  var outs = []
  for o in c.outs { outs = push(outs, map_(c, [ent("name", str_(c, o.name)), ent("shape", shape_(c, o.shape))])) }
  var cons = []
  for k in c.constraints {
    let check = lam(c, [param(c, "state")], [mk("Return", c, { expr: rw(k.expr) })])
    cons = push(cons, map_(c, [ent("name", str_(c, k.name)), ent("hard", mk("Bool", c, { value: k.ctype == "hard" })),
      ent("cost", mk("Num", c, { value: cost_of(k) })), ent("boundary", mk("Bool", c, { value: k.boundary })), ent("check", check),
      ent("reads", lit(c, reads_of(k.expr, [])))]))
  }
  var fns = []
  for f in c.fns {
    var fbody = [let_(f, "let", "state", ident(f, "__state"))]
    var i = 0
    for fp in f.params {
      fbody = push(fbody, let_(f, "let", fp.name, mk("Index", f, { obj: ident(f, "__fargs"), index: mk("Num", f, { value: i }) })))
      i += 1
    }
    fns = push(fns, ent(f.name, lam(f, [param(f, "__state"), param(f, "__fargs")], push_all(fbody, rw(f.body.body)))))
  }
  var fields = []
  for f in c.state { fields = push(fields, ent(f.name, rw(f.expr))) }
  let kn = kinds_of(c)
  let name_expr = mk("Str", c, { parts: [c.name + "(", ident(c, "__id"), ")"] })
  let spec = map_(c, [ent("name", name_expr), ent("id", ident(c, "__id")), ent("intent", opt_str(c, c.intent)), ent("state", map_(c, fields)),
    ent("constraints", list_(c, cons)), ent("handlers", list_(c, [])), ent("component", mk("Bool", c, { value: true })),
    ent("namespace", opt_str(c, c.namespace)), ent("version", opt_str(c, c.version)), ent("ins", list_(c, ins)), ent("outs", list_(c, outs)),
    ent("fns", map_(c, fns)), ent("kinds", lit(c, kn)), ent("typed_state", lit(c, typed_of(kn)))])
  let factory_body = push_all(push_all([let_(c, "let", "__id", mk("Index", c, { obj: ident(c, "__args"), index: mk("Num", c, { value: 0 }) }))], binds(c, 1)),
    [mk("Return", c, { expr: spec })])
  return [stmt(c, wcall(c, "define_template", [str_(c, c.name), mk("Num", c, { value: len(c.params) }), lam(c, [param(c, "__args")], factory_body)]))]
}

fn lower_on(o) {
  var p = "__ev"
  if o.param != null { p = o.param }
  return stmt(o, wcall(o, "listen", [str_(o, o.signal), lam(o, [param(o, p)], rw(o.body.body))]))
}

fn lower(ast, version, test_mode) {
  OWN_SORT_BY = false
  for it in ast.items { if it.type == "FnDecl" and it.name == "sort_by" { OWN_SORT_BY = true } }
  let rx = uses_matches(ast.items)
  let pj = uses_parse_json(ast.items)
  // sort_by lives in the prelude since 2026-11-07 (optional parameters); the <cie>/sort.eg rewrite it replaced is archived
  let sb = false
  var src = ast
  if rx or sb or pj {
    var uses = []
    if pj { uses = push(uses, mk("Use", ast, { path: JSON_PATH, alias: JSONM })) }
    if rx { uses = push(uses, mk("Use", ast, { path: REGEX_PATH, alias: RX })) }
    if sb { uses = push(uses, mk("Use", ast, { path: SORT_PATH, alias: SORT })) }
    var with_rx = {}
    for k, v in ast { with_rx[k] = v }
    with_rx.items = push_all(uses, rx_only(ast.items))
    src = with_rx
  }
  if not uses_world(src.items) and not test_mode { return src }
  return lower_world(src, version, test_mode)
}
fn lower_world(ast, version, test_mode) {
  comps = {}
  KINDS = {}
  MODULES = {}
  HAS_TEMPLATES = false
  if has(ast, "file") and ast.file != null { FILE = ast.file }
  for it in ast.items {
    if it.type == "Kind" { KINDS[it.name] = { parents: it.parents, state: it.state } }
    if it.type == "Use" { MODULES[it.alias] = true }
    MODULES[RX] = true
    MODULES[JSONM] = true
    MODULES[SORT] = true
    if it.type == "Compartment" and it.isTemplate { HAS_TEMPLATES = true }
  }
  for it in ast.items { if it.type == "Compartment" and not it.isTemplate { comps[it.name] = true } }
  let at = ast
  // the contract: given to start (genesis carries its hash); its roads wired after the later of the contract and the last compartment, as the
  // interpreter's roadsPoint does
  var contract = null
  var roads_after = -1
  var k = 0
  for it in ast.items {
    if it.type == "Contract" {
      contract = it
      roads_after = k
    }
    k += 1
  }
  if contract != null {
    k = 0
    for it in ast.items {
      if it.type == "Compartment" and k > roads_after { roads_after = k }
      k += 1
    }
  }
  var raw = mk("Null", at, {})
  if contract != null { raw = lit(at, contract.raw) }
  var items = [mk("Use", at, { path: WORLD_PATH, alias: W }), stmt(at, wcall(at, "start", [mk("Num", at, { value: 0 }), str_(at, version), raw]))]
  var tests = []
  var has_axioms = false
  for it in ast.items { if it.type == "Axiom" { has_axioms = true } }
  k = 0
  for it in ast.items {
    if it.type == "Kind" {
      // a kind is a schema: the checker holds components to it, the lowering takes its names and typed state (KINDS); nothing runs
    } else if it.type == "Test" {
      // eg test: run after the program (below); eg run: skipped, as the interpreter does
      if test_mode { tests[len(tests)] = it }
    } else if it.type == "Axiom" {
      items[len(items)] = stmt(it, wcall(it, "declare_axiom", [str_(it, it.name), mk("Num", it, { value: it.line }), lam(it, [], [mk("Return", it, { expr: rw(it.expr) })])]))
    } else if it.type == "Contract" {
      // nothing here: its raw block went to start
    } else if it.type == "Compartment" {
      items = push_all(items, lower_comp(it))
    } else if it.type == "On" {
      items[len(items)] = lower_on(it)
    } else {
      items[len(items)] = rw(it)
    }
    if contract != null and k == roads_after { items[len(items)] = stmt(contract, wcall(contract, "roads", [mk("Num", contract, { value: contract.line })])) }
    // after every top-level statement the axioms are checked, at that statement's line (the interpreter's $.axioms(it.line))
    if has_axioms and it.type != "FnDecl" and it.type != "Use" { items[len(items)] = stmt(it, wcall(it, "check_axioms", [])) }
    k += 1
  }
  items[len(items)] = stmt(at, wcall(at, "finish", []))
  if test_mode {
    // each test from the same world, as a whatif, its try in the program so a failure names its own line (lang/runtime.js runTests)
    var ti = 0
    for t in tests {
      let tn = "__test_" + str(ti)
      let sn = "__snap_" + str(ti)
      items[len(items)] = let_(t, "let", tn, lam(t, [], rw(t.body.body)))
      items[len(items)] = let_(t, "let", sn, wcall(t, "whatif_begin", []))
      let ok = block(t, [stmt(t, call(t, ident(t, tn), [])), stmt(t, wcall(t, "whatif_end", [ident(t, sn), mk("Num", t, { value: t.line })])),
        stmt(t, wcall(t, "test_pass", [str_(t, t.name)]))])
      let bad = block(t, [stmt(t, wcall(t, "whatif_abort", [ident(t, sn)])), stmt(t, wcall(t, "test_fail", [str_(t, t.name), ident(t, "__e")]))])
      items[len(items)] = mk("Try", t, { body: ok, errName: "__e", handler: bad })
      ti += 1
    }
    items[len(items)] = stmt(at, call(at, ident(at, "__exit"), [wcall(at, "test_summary", [])]))
  }
  var out = {}
  for k, v in ast { out[k] = v }
  out.items = items
  return out
}
