_gap_entries += 1 \} \}\n  _gaps = slice(_gaps, 0, s.gaps)\n  _rng = s.rng\n  _spent = s.spent\n  _unrouted = slice(_unrouted, 0, s.unrouted)\n  _axioms = slice(_axioms, 0, s.axioms)\n  _ctx = slice(_ctx, 0, s.ctx)\n  _wires = s.wires\n\}\nfn whatif_branch(body, line) \{\n  let snap = _snapshot()\n  _ctx = push(_ctx, \{ kind: \"whatif\", queue: [], draining: false \})\n  var result = null\n  try \{ result = body() \} else e \{\n    _restore(snap)\n    raise(e.message)\n  \}\n  _restore(snap)\n  _append(\"whatif\", \{ line: line \})\n  return result\n\}\nfn promote_value(value, proof, line, file) \{\n  if type_of(proof) != \"bool\" \{ raise(\"a proof must be a bool, got \{type_of(proof)\}\") \}\n  if proof \{\n    _append(\"promote\", \{ value: clone(value), line: line \})\n    signal(\"promoted\", \{ value: value \})\n  \} else \{\n    _append(\"promotion_refused\", \{ value: clone(value), line: line \})\n    open_gap(\"promotion refused at line \{line\}: its proof is false\", 0.9, \"logical\", line, file)\n  \}\n\}\n\nfn start(seed, version, raw_contract) \{\n  _rng = int(seed) & M32\n  var body = \{ seed: seed, version: version, chain_id: _chain_id(seed, version), text: \{ encoding: \"utf-8\", normalization: \"nfc\" \} \}\n  if raw_contract != null \{\n    _contract = C.normalize(raw_contract)\n    _contract_hash = C.contract_hash(_contract)\n    MAX_STEPS = _contract.gate.max_steps\n    CHECKPOINT_EVERY = _contract.gate.checkpoint_every\n    body.text = _contract.text\n    body.contract = \{ id: _contract.id, version: _contract.version \}\n    body.contract_hash = _contract_hash\n  \}\n  _in_ckpt = true\n  _append(\"genesis\", body)\n  _in_ckpt = false\n\}\n\n// ── compartments ─────────────────────────────────────────────────────────────\nfn declare(spec) \{\n  for c in _comps \{ if c.name == spec.name \{ _refuse(\"compartment \{spec.name\} is declared twice\") \} \}\n  var constraints = []\n  if has(spec, \"constraints\") \{ constraints = spec.constraints \}\n  var handlers = []\n  if has(spec, \"handlers\") \{ handlers = spec.handlers \}\n  var intent = null\n  if has(spec, \"intent\") \{ intent = spec.intent \}\n  var tpl = null\n  if has(spec, \"template\") \{ tpl = spec.template \}\n  var kinds = []\n  if has(spec, \"kinds\") \{ kinds = spec.kinds \}\n  var typed = []\n  if has(spec, \"typed_state\") \{ typed = spec.typed_state \}\n  var fns = \{\}\n  if has(spec, \"fns\") \{ fns = spec.fns \}\n  _next_handle += 1\n  var c = \{ name: spec.name, id: spec.id, intent: intent, state: clone(spec.state), constraints: constraints, handlers: handlers, component: false,\n    ins: \{\}, outs: \{\}, in_names: [], out_names: [], namespace: null, version: null, uuid: null, template: null, kinds: kinds, typed: typed,\n    fns: fns, token: _next_handle \}\n  c.template = tpl\n  for other in _comps \{ if other.id == spec.id \{ raise(\"id \\\"\{spec.id\}\\\" is already used by \{other.name\}\") \} \}\n  // the initial state: every hard constraint whose fields are present must hold (lang/runtime.js declare)\n  for k in constraints \{\n    var present = true\n    if has(k, \"reads\") \{ for f in k.reads \{ if not has(spec.state, f) or spec.state[f] == null \{ present = false \} \} \}\n    let check = k.check\n    if present and k.hard and not check(clone(spec.state)) \{\n      var what = \"compartment\"\n      if has(spec, \"component\") and spec.component \{ what = \"component\" \}\n      var kw = \"constraint\"\n      if has(k, \"boundary\") and k.boundary \{ kw = \"boundary\" \}\n      raise(\"\{what\} \{spec.name\}: initial state breaks \{kw\} \{k.name\}\")\n    \}\n  \}\n  _check_typed(c, c.state)\n  if has(spec, \"component\") and spec.component \{\n    c.component = true\n    for h in spec.ins \{\n      c.ins[h.name] = h\n      c.in_names = push(c.in_names, h.name)\n    \}\n    for h in spec.outs \{\n      c.outs[h.name] = h\n      c.out_names = push(c.out_names, h.name)\n    \}\n    c.namespace = spec.namespace\n    c.version = spec.version\n    var boundary = []\n    for k in constraints \{ if has(k, \"boundary\") and k.boundary \{ boundary = push(boundary, k.name) \} \}\n    var uuid = \"emerge-component-\" + slice(hex(sha256(\"\{spec.namespace\}/\{spec.id\}@\{spec.version\}\")), 0, 24)\n    c.uuid_derived = true\n    if has(spec, \"uuid\") and spec.uuid != null \{\n      uuid = spec.uuid\n      c.uuid_derived = false\n    \}\n    c.uuid = uuid\n    c.boundary = boundary\n    _comps = push(_comps, c)\n    _append(\"register\", \{ name: spec.name, id: spec.id, namespace: spec.namespace, version: spec.version, uuid: uuid, boundary: boundary,\n      kinds: kinds, template: tpl, state: clone(spec.state) \})\n    return _handle(c)\n  \}\n  _comps = push(_comps, c)\n  _append(\"compartment\", \{ name: spec.name, id: spec.id, state: clone(spec.state) \})\n  return _handle(c)\n\}\n\n// ── templates, spawn, despawn, handles (CIE15): a handle names its instance and its token; a stale one is an error (lang/runtime.js liveOf) ──\nfn _handle(c) = freeze(\{ __h: c.token, name: c.name, id: c.id, template: c.template \})\nfn _is_handle(v) = type_of(v) == \"map\" and has(v, \"__h\")\nfn _live(h) \{\n  for c in _comps \{ if c.name == h.name and c.token == h.__h \{ return c \} \}\n  raise(\"\{h.name\} no longer exists — it was despawned, or spawned inside a whatif\")\n\}\n/** the state fields a kind types: checked when a component appears and before every commit */\nfn _check_typed(c, st) \{\n  for f in c.typed \{\n    var v = null\n    if has(st, f.name) \{ v = st[f.name] \}\n    var ok = true\n    if v == null \{ ok = f.nullable or f.type == \"any\" \} else \{ ok = _ty_ok(v, f.type) \}\n    if not ok \{\n      var q = \"\"\n      if f.nullable \{ q = \"?\" \}\n      raise(\"\{c.name\} breaks kind \{f.kind\}: state.\{f.name\} must be \{f.type\}\{q\}, got \{type_of(v)\} \{repr(v)\}\")\n    \}\n  \}\n\}\nfn define_template(name, arity, factory) \{ _templates[name] = \{ arity: arity, factory: factory \} \}\nfn spawn_of(name, args) \{\n  if not has(_templates, name) \{ raise(\"template \{name\} is used before its declaration ran\") \}\n  let t = _templates[name]\n  if len(args) != t.arity + 1 \{ raise(\"spawn \{name\} takes an id and \{t.arity\} argument(s), got \{len(args)\} in all\") \}\n  let id = args[0]\n  if type_of(id) != \"string\" or id == \"\" \{ raise(\"spawn \{name\}: the first argument is the instance id, a non-empty string — got \{type_of(id)\} \{repr(id)\}\") \}\n  let factory = t.factory\n  var spec = factory(args)\n  spec.template = name\n  return declare(spec)\n\}\nfn despawn_of(h) \{\n  if not _is_handle(h) \{ raise(\"despawn needs a component instance, got \{type_of(h)\}\") \}\n  let c = _live(h)\n  if c.template == null \{ raise(\"\{h.name\} was declared, not spawned — only spawned instances can be despawned\") \}\n  var kept = []\n  for w in _wires \{\n    let touches = (not has(w.from, \"signal\") and w.from.comp == c.name) or (not has(w.to, \"signal\") and w.to.comp == c.name)\n    if touches \{ _append(\"unwire\", \{ from: _end_text(w.from), to: _end_text(w.to), reason: \"despawn\" \}) \} else \{ kept = push(kept, w) \}\n  \}\n  _wires = kept\n  var left = []\n  for x in _comps \{ if x.token != c.token \{ left = push(left, x) \} \}\n  _comps = left\n  _append(\"despawn\", \{ name: c.name, id: c.id, template: c.template, state: clone(c.state) \})\n\}\n/** a wire end on an instance held in a variable: wire prev.give -> next.take */\nfn end_of(h, hook) \{\n  if _is_handle(h) \{ return \{ comp: _live(h).name, hook: hook \} \}\n  raise(\"expected Component.hook or instance.hook as a wire end, got \{type_of(h)\}\")\n\}\n/** h.field on an instance, or a plain map's field (null when missing), as the interpreter reads either */\nfn member_any(o, field) \{\n  if _is_handle(o) \{ return member_of(_live(o).name, field) \}\n  if type_of(o) == \"map\" \{ return get(o, field, null) \}\n  raise(\"\{type_of(o)\} has no member .\{field\}\")\n\}\n/** h.f(…) on an instance (its lens fn, over a frozen copy of its state), or a map's fn field */\nfn call_any(o, field, args) \{\n  if _is_handle(o) \{\n    let c = _live(o)\n    if not has(c.fns, field) \{ raise(\"component \{c.name\} has no member .\{field\}\") \}\n    let f = c.fns[field]\n    return f(freeze(clone(c.state)), args)\n  \}\n  let g = member_any(o, field)\n  if len(args) == 0 \{ return g() \}\n  if len(args) == 1 \{ return g(args[0]) \}\n  if len(args) == 2 \{ return g(args[0], args[1]) \}\n  if len(args) == 3 \{ return g(args[0], args[1], args[2]) \}\n  if len(args) == 4 \{ return g(args[0], args[1], args[2], args[3]) \}\n  raise(\"native: a call through a map field with more than 4 arguments is not in the native subset yet (CIE15)\")\n\}\nfn is_kind_of(x, k) \{\n  if type_of(k) != \"string\" \{ raise(\"is_kind needs a string, got \{type_of(k)\}\") \}\n  if not _is_handle(x) \{ return false \}\n  for c in _comps \{ if c.name == x.name and c.token == x.__h and c.component \{ return c.kinds contains k \} \}\n  return false\n\}\nfn instances_of(t) \{\n  if type_of(t) != \"string\" \{ raise(\"instances needs a string, got \{type_of(t)\}\") \}\n  if not has(_templates, t) \{ raise(\"instances: \{t\} is not a declared template\") \}\n  var out = []\n  for c in _comps \{ if c.template == t \{ out = push(out, _handle(c)) \} \}\n  return out\n\}\n\n// ── components: hooks, shapes, wires (slice c), as lang/runtime.js send / emitOut / wire / roads ──\nfn _component(name, what) \{\n  let c = _comp(name)\n  if not c.component \{ _refuse(\"\{what\}: \{name\} is a compartment, not a component — only components have hooks\") \}\n  return c\n\}\nfn _shape_text(shape) \{\n  var parts = []\n  for f in shape \{\n    var q = \"\"\n    if f.nullable \{ q = \"?\" \}\n    parts = push(parts, \"\{f.name\}: \{f.type\}\{q\}\")\n  \}\n  return join(parts, \", \")\n\}\nfn _ty_ok(v, name) \{\n  let t = type_of(v)\n  if name == \"any\" \{ return true \}\n  if name == \"float\" \{ return t == \"num\" \}\n  return t == name\n\}\nfn _check_shape(payload, shape, what) \{\n  if shape == null \{ return null \}\n  var names = \{\}\n  for f in shape \{ names[f.name] = true \}\n  for k in keys(payload) \{ if not has(names, k) \{ raise(\"\{what\} has no field \\\"\{k\}\\\" — its shape is \\\{\{_shape_text(shape)\}\\\}\") \} \}\n  for f in shape \{\n    var v = null\n    if has(payload, f.name) \{ v = payload[f.name] \}\n    if v == null \{\n      if not f.nullable and f.type != \"any\" \{ raise(\"\{what\} field \{f.name\} must be \{f.type\}, got null\") \}\n    \} else if not _ty_ok(v, f.type) \{\n      raise(\"\{what\} field \{f.name\} must be \{f.type\}, got \{type_of(v)\} \{repr(v)\}\")\n    \}\n  \}\n\}\nfn _port_payload(payload, what) \{\n  var p = payload\n  if p == null \{ p = \{\} \}\n  if type_of(p) != \"map\" \{ raise(\"\{what\} payload must be a map, got \{type_of(p)\}\") \}\n  return freeze(clone(p))\n\}\nfn send_in(comp, hook, payload) \{\n  let c = _component(comp, \"send\")\n  if not has(c.ins, hook) \{ raise(\"component \{comp\} has no in hook \\\"\{hook\}\\\"\") \}\n  let p = _port_payload(payload, \"\{comp\}.\{hook\}\")\n  _check_shape(p, c.ins[hook].shape, \"in hook \{comp\}.\{hook\}\")\n  _enqueue(\{ kind: \"port\", comp: comp, hook: hook, payload: p \})\n\}\nfn emit_out(hook, payload) \{\n  var owner = null\n  var i = len(_ctx) - 1\n  while i >= 0 and owner == null \{\n    if has(_ctx[i], \"comp\") \{ owner = _ctx[i].comp \}\n    i -= 1\n  \}\n  if owner == null or not owner.component \{ raise(\"emit out is only possible inside a component's in hook\") \}\n  if not has(owner.outs, hook) \{ raise(\"component \{owner.name\} has no out hook \\\"\{hook\}\\\"\") \}\n  let p = _port_payload(payload, \"\{owner.name\}.\{hook\}\")\n  _check_shape(p, owner.outs[hook].shape, \"out hook \{owner.name\}.\{hook\}\")\n  _enqueue(\{ kind: \"out\", comp: owner.name, hook: hook, payload: p \})\n\}\nfn _end_text(e) \{\n  if has(e, \"signal\") \{ return json_str(e.signal) \}\n  return \"\{e.comp\}.\{e.hook\}\"\n\}\nfn _same_end(a, b) \{\n  if has(a, \"signal\") \{ return has(b, \"signal\") and a.signal == b.signal \}\n  return not has(b, \"signal\") and a.comp == b.comp and a.hook == b.hook\n\}\nfn connect(from, to, line) \{\n  if has(from, \"signal\") and has(to, \"signal\") \{ raise(\"a wire joins at least one hook — signal to signal is an on handler\") \}\n  if not has(from, \"signal\") \{\n    let c = _component(from.comp, \"wire\")\n    if not has(c.outs, from.hook) \{\n      if has(c.ins, from.hook) \{ raise(\"\{from.comp\}.\{from.hook\} is an in hook — a wire runs out → in\") \}\n      raise(\"component \{from.comp\} has no out hook \\\"\{from.hook\}\\\"\")\n    \}\n  \}\n  if not has(to, \"signal\") \{\n    let c = _component(to.comp, \"wire\")\n    if not has(c.ins, to.hook) \{\n      if has(c.outs, to.hook) \{ raise(\"\{to.comp\}.\{to.hook\} is an out hook — a wire runs out → in\") \}\n      raise(\"component \{to.comp\} has no in hook \\\"\{to.hook\}\\\"\")\n    \}\n  \}\n  for w in _wires \{ if _same_end(w.from, from) and _same_end(w.to, to) \{ raise(\"wire \{_end_text(from)\} -> \{_end_text(to)\} is declared twice\") \} \}\n  _wires = push(_wires, \{ from: from, to: to, line: line \})\n  _append(\"wire\", \{ from: _end_text(from), to: _end_text(to), line: line \})\n\}\n/** the contract's roads: each one a wire (CIE-EG 6.1) */\nfn roads(line) \{\n  if _contract == null \{ return null \}\n  for r in _contract.roads \{\n    let a = split(r.from, \".\")\n    let b = split(r.to, \".\")\n    connect(\{ comp: a[0], hook: a[1] \}, \{ comp: b[0], hook: b[1] \}, line)\n  \}\n\}\nfn _wire_target(to, payload) \{\n  if has(to, \"signal\") \{ return \{ kind: \"signal\", name: to.signal, payload: payload \} \}\n  return \{ kind: \"port\", comp: to.comp, hook: to.hook, payload: payload \}\n\}\n\nfn _comp(name) \{\n  for c in _comps \{ if c.name == name \{ return c \} \}\n  _refuse(\"\{name\} is used before its declaration ran\")\n\}\n\n/** a lens: a copy of the state, so nothing outside a handler writes it */\nfn state_of(name) = freeze(clone(_comp(name).state))\n// ── components(): the registry as records (CIE-EG §5; lang/components.js graphRecords) ──\nfn _sha24(s) = slice(hex(sha256(s)), 0, 24)\nfn _shape_rec(shape) \{\n  if shape == null \{ return null \}\n  var m = \{\}\n  for f in shape \{\n    var q = \"\"\n    if f.nullable \{ q = \"?\" \}\n    m[f.name] = f.type + q\n  \}\n  return m\n\}\nfn _end_id(e) \{\n  if has(e, \"signal\") \{ return \"signal:\{e.signal\}\" \}\n  return \"\{_comp(e.comp).id\}.\{e.hook\}\"\n\}\nfn components_graph() \{\n  var comps = []\n  var hooks = []\n  for c in _comps \{\n    if c.component \{\n      comps = push(comps, \{ id: c.id, namespace: c.namespace, name: c.name, version: c.version, uuid: c.uuid, uuid_derived: c.uuid_derived,\n        boundary: c.boundary, intent: c.intent, kinds: c.kinds, template: c.template \})\n      for hn in c.in_names \{\n        let hid = \"\{c.id\}.\{hn\}\"\n        hooks = push(hooks, \{ id: hid, component_id: c.id, name: hn, type: \"event_bus\", direction: \"in\", uuid: \"emerge-hook-\" + _sha24(hid), shape: _shape_rec(c.ins[hn].shape) \})\n      \}\n      for hn in c.out_names \{\n        let hid = \"\{c.id\}.\{hn\}\"\n        hooks = push(hooks, \{ id: hid, component_id: c.id, name: hn, type: \"event_bus\", direction: \"out\", uuid: \"emerge-hook-\" + _sha24(hid), shape: _shape_rec(c.outs[hn].shape) \})\n      \}\n    \}\n  \}\n  var wires = []\n  for w in _wires \{\n    let a = _end_id(w.from)\n    let b = _end_id(w.to)\n    let wid = \"\{a\}->\{b\}\"\n    var rec = \{ id: wid, from_hook_id: a, to_hook_id: b, uuid: \"emerge-wire-\" + _sha24(wid) \}\n    if has(w.from, \"signal\") or has(w.to, \"signal\") \{ rec.signal_endpoint = true \}\n    wires = push(wires, rec)\n  \}\n  return freeze(\{ components: comps, hooks: hooks, wires: wires \})\n\}\n\n/** Name.field on a compartment or component handle, as lang/runtime.js answers it */\nfn member_of(name, field) \{\n  let c = _comp(name)\n  if field == \"state\" \{ return state_of(name) \}\n  if field == \"id\" \{ return c.id \}\n  if field == \"name\" \{ return c.name \}\n  if field == \"intent\" \{ return c.intent \}\n  if c.component \{\n    if field == \"namespace\" \{ return c.namespace \}\n    if field == \"version\" \{ return c.version \}\n    if field == \"uuid\" \{ return c.uuid \}\n    if field == \"hooks\" \{ return freeze(\{ in: c.in_names, out: c.out_names \}) \}\n    if field == \"template\" \{ return c.template \}\n    if field == \"kinds\" \{ return c.kinds \}\n  \}\n  var what = \"compartment\"\n  if c.component \{ what = \"component\" \}\n  raise(\"\{what\} \{name\} has no member .\{field\}\")\n\}\nfn spent() = _spent\nfn unrouted() = _unrouted\nfn entries() = _entries\n/** the contract's gate.block_at, or null without a contract: the observe() builtin measures against it (lang/runtime.js OP) */\nfn gate_block_at() \{\n  if _contract == null \{ return null \}\n  return _contract.gate.block_at\n\}\n/** ledger_verify(): every hash, link, seq and checkpoint (4.4), through lang/cie/ledger.eg */\nfn verify() = L.verify(_entries).ok\n\nfn listen(signal, run) \{ _globals = push(_globals, \{ signal: signal, run: run \}) \}\n\n// ── signals: FIFO, a handler's emits buffered until it commits ───────────────\nfn _matches(pattern, name) \{\n  if len(pattern) > 0 and slice(pattern, len(pattern) - 1, len(pattern)) == \"*\" \{\n    let p = slice(pattern, 0, len(pattern) - 1)\n    return slice(name, 0, len(p)) == p\n  \}\n  return pattern == name\n\}\n\nfn signal(name, payload) \{\n  if type_of(name) != \"string\" \{ _refuse(\"a signal name must be a string\") \}\n  var p = payload\n  if p == null \{ p = \{\} \}\n  if type_of(p) != \"map\" \{ _refuse(\"a signal payload must be a map\") \}\n  _enqueue(\{ kind: \"signal\", name: name, payload: clone(p) \})\n\}\n\nfn _enqueue(sig) \{\n  var cx = _ctx[len(_ctx) - 1]\n  if cx.kind == \"handler\" \{ cx.buffer = push(cx.buffer, sig)\n    return null \}\n  cx.queue = push(cx.queue, sig)\n  if not cx.draining \{ _drain(cx) \}\n\}\n\nfn _label(it) \{\n  if it.kind == \"port\" \{ return \"→\{it.comp\}.\{it.hook\}\" \}\n  if it.kind == \"out\" \{ return \"\{it.comp\}.\{it.hook\}\" \}\n  return it.name\n\}\nfn _names(sigs) \{\n  var out = []\n  for s in sigs \{ out = push(out, _label(s)) \}\n  return out\n\}\n\nfn _drain(at) \{\n  var cx = at\n  cx.draining = true\n  var deliveries = 0\n  try \{\n    while len(cx.queue) > 0 \{\n      deliveries += 1\n      if deliveries > MAX_STEPS \{\n        var note = \"\"\n        if _contract != null \{ note = \" (contract \{_contract.id\}: gate.max_steps)\" \}\n        raise(\"signal storm — more than \{MAX_STEPS\} deliveries in one drain\{note\}\")\n      \}\n      let sig = cx.queue[0]\n      cx.queue = slice(cx.queue, 1)\n      _deliver(cx, sig)\n    \}\n  \} else e \{\n    let remaining = _names(cx.queue)\n    cx.queue = []\n    cx.draining = false\n    _append(\"aborted\", \{ remaining: remaining, error: e.message \})\n    raise(e.message)\n  \}\n  cx.draining = false\n\}\n\nfn _deliver(at, sig) \{\n  var cx = at\n  if sig.kind == \"port\" \{\n    let c = _component(sig.comp, \"deliver\")\n    let h = c.ins[sig.hook]\n    _check_shape(sig.payload, h.shape, \"in hook \{sig.comp\}.\{sig.hook\}\")\n    _run_handler(cx, c, sig, h.run)\n    return null\n  \}\n  if sig.kind == \"out\" \{\n    var n = 0\n    for w in _wires \{\n      if not has(w.from, \"signal\") and w.from.comp == sig.comp and w.from.hook == sig.hook \{\n        cx.queue = push(cx.queue, _wire_target(w.to, sig.payload))\n        n += 1\n      \}\n    \}\n    if n == 0 \{\n      _unrouted = push(_unrouted, _label(sig))\n      _append(\"unrouted\", \{ signal: _label(sig), payload: sig.payload \})\n    \}\n    return null\n  \}\n  var claimed = false\n  for c in _comps \{\n    for h in c.handlers \{\n      if _matches(h.signal, sig.name) \{\n        claimed = true\n        _run_handler(cx, c, sig, h.run)\n      \}\n    \}\n  \}\n  for w in _wires \{\n    if has(w.from, \"signal\") and _matches(w.from.signal, sig.name) \{\n      claimed = true\n      cx.queue = push(cx.queue, _wire_target(w.to, sig.payload))\n    \}\n  \}\n  for h in _globals \{\n    if _matches(h.signal, sig.name) \{\n      claimed = true\n      let hx = \{ kind: \"handler\", buffer: [] \}\n      _ctx = push(_ctx, hx)\n      let run = h.run\n      try \{ run(sig.payload) \} else e \{ _ctx = slice(_ctx, 0, len(_ctx) - 1)\n        raise(e.message) \}\n      _ctx = slice(_ctx, 0, len(_ctx) - 1)\n      for s in hx.buffer \{ cx.queue = push(cx.queue, s) \}\n    \}\n  \}\n  if not claimed \{\n    _unrouted = push(_unrouted, sig.name)\n    _append(\"unrouted\", \{ signal: sig.name, payload: sig.payload \})\n  \}\n\}\n\nfn _run_handler(at, comp, sig, run) \{\n  var cx = at\n  var c = comp\n  var working = clone(c.state)\n  let hx = \{ kind: \"handler\", buffer: [], comp: c \}\n  _ctx = push(_ctx, hx)\n  try \{ run(working, sig.payload) \} else e \{ _ctx = slice(_ctx, 0, len(_ctx) - 1)\n    raise(e.message) \}\n  _ctx = slice(_ctx, 0, len(_ctx) - 1)\n  var violations = []\n  for k in c.constraints \{\n    // a constraint that reads a state field that is null cannot be evaluated: a gap, and the state does not change (lang/runtime.js)\n    var missing = null\n    if has(k, \"reads\") \{\n      for f in k.reads \{ if missing == null and (not has(working, f) or working[f] == null) \{ missing = f \} \}\n    \}\n    if missing != null \{\n      let g = freeze(\{ id: uid(\"gap\"), message: \"\{c.name\}.\{k.name\} cannot be evaluated: state.\{missing\} is null\", pressure: 0.8, type: \"evidential\", line: null, file: null \})\n      _gaps = push(_gaps, g)\n      _append(\"gap\", \{ compartment: c.name, signal: _label(sig), constraint: k.name, missing: missing, gap: g.id, discarded: _names(hx.buffer) \})\n      cx.queue = push(cx.queue, \{ kind: \"signal\", name: \"gap.opened\", payload: g \})\n      return null\n    \}\n    let check = k.check\n    if not check(clone(working)) \{\n      if k.hard \{\n        var bnd = false\n        if has(k, \"boundary\") \{ bnd = k.boundary \}\n        _append(\"rejected\", \{ compartment: c.name, signal: _label(sig), constraint: k.name, boundary: bnd, reason: \"\{k.name\} does not hold\", discarded: _names(hx.buffer) \})\n        cx.queue = push(cx.queue, \{ kind: \"signal\", name: \"rejected\", payload: \{ compartment: c.name, signal: _label(sig), constraint: k.name, boundary: bnd \} \})\n        return null\n      \}\n      violations = push(violations, \{ constraint: k.name, cost: k.cost \})\n    \}\n  \}\n  var changes = \{\}\n  for key in keys(working) \{ if not has(c.state, key) or working[key] != c.state[key] \{ changes[key] = working[key] \} \}\n  if c.component \{ _check_typed(c, working) \}\n  var cost = 0\n  for v in violations \{ cost += v.cost \}\n  _spent += cost\n  c.state = working\n  _append(\"transition\", \{ compartment: c.name, signal: _label(sig), changes: changes, violations: violations, spent: _spent \})\n  for s in hx.buffer \{ cx.queue = push(cx.queue, s) \}\n\}\n\n/** the clean-shutdown checkpoint (4.6). The \"[emerge] N unrouted signal(s)\" notice is the CLI's (eg.js prints it to stderr), not the world's. */\nfn finish() \{\n  if len(_entries) > _last_ckpt \{ _checkpoint() \}\n  return _entries\n\}\n"
