nfn random() = _rng_next()\nfn uid(prefix) \{\n  let a = _hex8(floor(_rng_next() * 4294967295))\n  let b = _hex8(floor(_rng_next() * 4294967295))\n  return \"\{prefix\}-\{a\}\{b\}\"\n\}\nlet RESERVED = \{ genesis: 1, boot: 1, register: 1, deliver: 1, gap: 1, \"gap.ack\": 1, \"gap.close\": 1, transition: 1, rejected: 1, checkpoint: 1, rekey: 1 \}\nlet GAP_TYPES = [\"logical\", \"evidential\", \"temporal\", \"assumption\", \"contradiction\", \"structural\", \"contextual\", \"causal\"]\nfn record_entry(kind, payload) \{\n  if type_of(kind) != \"string\" \{ raise(\"record needs a string kind, got \{type_of(kind)\}\") \}\n  if has(RESERVED, kind) \{ raise(\"record cannot write the kind \\\"\{kind\}\\\": the runtime owns it\") \}\n  return _append(kind, clone(payload))\n\}\nfn open_gap(message, pressure, gtype, line, file) \{\n  if type_of(message) != \"string\" \{ raise(\"a gap message must be a string, got \{type_of(message)\}\") \}\n  if type_of(pressure) != \"num\" or pressure < 0 or pressure > 1 \{ raise(\"gap pressure must be a num in [0, 1], got \{repr(pressure)\}\") \}\n  var t = gtype\n  if t == null \{ t = \"structural\" \}\n  if not (GAP_TYPES contains t) \{\n    let types = join(GAP_TYPES, \", \")\n    raise(\"gap type must be one of \{types\}\")\n  \}\n  let g = freeze(\{ id: uid(\"gap\"), message: message, pressure: pressure, type: t, line: line, file: file \})\n  _gaps = push(_gaps, g)\n  _append(\"gap\", \{ gap: g.id, message: message, pressure: pressure, type: t, line: line \})\n  signal(\"gap.opened\", g)\n  return g\n\}\nfn gaps() = _gaps\n\n// ── axioms (CIE15): an axiom guards the whole program, checked when declared and after every top-level statement (lang/runtime.js) ──\nfn _check_one(a) \{\n  let check = a.check\n  let v = check()\n  if type_of(v) != \"bool\" \{ raise(\"axiom \{a.name\} must give a bool, got \{type_of(v)\}\") \}\n  if not v \{ raise(\"axiom \{a.name\} (line \{a.line\}) violated\") \}\n\}\nfn declare_axiom(name, line, check) \{\n  