let TEXT = "// lang/cie/debug.eg — the debugger in Emerge (CIE7 slice b, CIE-EG §13.7): a run debugged from its ledger. Written again from\n// observe/debug.js, rule for rule; its end state is that file's answers: the interpreter's ledger_why() builtin (why) and observe() read\n// mid-run (at), and the expected answers of test/debug.test.js, carried over (follow, diff, blame, clip). The judge is\n// lang/test/world/debug.eg, Emerge only.\n//\n//   summary(e)            one line saying what an entry is\n//   edges(entries)        the inferred causal edges of every entry: \{ \"<seq>\": [\{ from, via, weight \}] \}, a parent always an earlier seq\n//   why(entries, seq)     the chain from an entry back to the entry that explains it\n//   at(entries, seq, P)   the world as it was after that entry: each compartment's state, the open gaps, the field and sigma readings\n//   follow(entries, f)    every entry about one compartment, signal or kind (f: compartment, signal, kind, from, to; any combination narrows)\n//   diff(a, b, P)         where two runs part ways: the first entry whose hash differs (equal hashes prove an equal past)\n//   blame(entries, P)     the first thing that went wrong, and why: the debugger's \"start here\"\n//   clip(entries, from, to, P)   a bounded slice anchored to the chain at both ends, re-verifiable alone (RFR2 clip)\n//   verify_clip(c, whole) a clip stands on its own; optionally also against a whole ledger (pass null for none)\n//\n// Emerge's entries carry no causal parent yet (CIE-EG §13.6), so causality here is INFERRED from structure and every edge says so (via).\n// Nothing is guessed silently, and nothing is written to the ledger. P is lang/core/primitives.eg, as observe.eg takes it.\nuse \"./ledger.eg\" as L\nuse \"./observe.eg\" as OB\n\n// ── reading an entry the way debug.js does ───────────────────────────────────────────────────────────────\n/** a body field as a JavaScript template literal shows it: absent → \"undefined\", null → \"null\", a string as itself, else its text */\nfn _t(b, k) \{\n  if not has(b, k) \{ return \"undefined\" \}\n  let v = b[k]\n  if v == null \{ return \"null\" \}\n  if type_of(v) == \"string\" \{ return v \}\n  return str(v)\n\}\nfn _defined(b, k) = has(b, k)\nfn _present(b, k) = has(b, k) and b[k] != null\n/** debug.js short(): a string as itself, anything else as JSON; past n characters cut to n - 1 and an ellipsis */\nfn _short(x, n = 60) \{\n  var s = x\n  if type_of(x) != \"string\" \{ s = json(x) \}\n  if len(s) > n \{ return slice(s, 0, n - 1) + \"…\" \}\n  return s\n\}\n/** JavaScript truthiness for the values a body holds */\nfn _truthy(v) \{\n  if v == null or v == false or v == 0 or v == \"\" \{ return false \}\n  return true\n\}\nfn _keys_of(b) \{\n  if has(b, \"changes\") and type_of(b.changes) == \"map\" \{ return keys(b.changes) \}\n  return []\n\}\n/** a map key for any value (debug.js keys its maps by the value itself) */\nfn _k(v) = json(v)\n\nfn summary(e) \{\n  let b = OB.body_of(e)\n  let c = _t(b, \"compartment\")\n  let kind = e.kind\n  if kind == \"transition\" \{\n    let ks = _keys_of(b)\n    var s = \"\{c\} accepted \{_t(b, \"signal\")\}\"\n    if len(ks) > 0 \{ s = s + \" (set \{join(ks, \", \")\})\" \}\n    if has(b, \"violations\") and type_of(b.violations) == \"list\" and len(b.violations) > 0 \{\n      var cost = 0\n      for v in b.violations \{ cost = cost + v.cost \}\n      s = s + \" at cost \{cost\}\"\n    \}\n    return s\n  \}\n  if kind == \"rejected\" \{\n    var s = \"\{c\} refused \{_t(b, \"signal\")\}: \{_t(b, \"constraint\")\}\"\n    if has(b, \"reason\") and _truthy(b.reason) \{ s = s + \" — \" + _short(b.reason, 80) \}\n    return s\n  \}\n  if kind == \"gap\" \{\n    if _defined(b, \"missing\") \{ return \"\{c\}.\{_t(b, \"constraint\")\} could not be evaluated: state.\{_t(b, \"missing\")\} is null\" \}\n    var m = \"\"\n    if _present(b, \"message\") \{ m = b.message \}\n    var s = \"gap: \" + _short(m, 90)\n    if get(b, \"source\", null) == \"observe\" \{ s = s + \" (opened by observe)\" \}\n    return s\n  \}\n  if kind == \"gap.close\" \{ return \"gap \{_t(b, \"gap\")\} closed\" \}\n  if kind == \"unrouted\" \{ return \"nobody handles \{_t(b, \"signal\")\}\" \}\n  if kind == \"aborted\" \{\n    var m = \"\"\n    if _present(b, \"error\") \{ m = b.error \}\n    return \"aborted: \" + _short(m, 80)\n  \}\n  if kind == \"compartment\" or kind == \"register\" \{ return \"\{_t(b, \"name\")\} declared\" \}\n  if kind == \"promotion_refused\" \{ return \"promotion refused\" \}\n  if kind == \"genesis\" \{\n    if not has(b, \"seed\") \{ return \"genesis (seed undefined)\" \}\n    return \"genesis (seed \{_short(b.seed)\})\"\n  \}\n  if has(b, \"name\") and _truthy(b.name) \{ return \"\{kind\} \{_t(b, \"name\")\}\" \}\n  if has(b, \"path\") and _truthy(b.path) \{ return \"\{kind\} \{_t(b, \"path\")\}\" \}\n  return kind\n\}\n\n/** an inferred edge to an earlier entry; a parent that is absent, null or not earlier adds nothing */\nfn _add(es, seq, from, via, weight) \{\n  if from != null and from < seq \{ return push(es, \{ from: from, via: via, weight: weight \}) \}\n  return es\n\}\n\n// ── the causal edges ─────────────────────────────────────────────────────────────────────────────────────\nfn edges(entries) \{\n  var out = \{\}\n  var decl = \{\}\n  var last_state = \{\}\n  var by_field = \{\}\n  var last_signal = \{\}\n  var gap_at = \{\}\n  for e in entries \{\n    let b = OB.body_of(e)\n    let has_c = _defined(b, \"compartment\")\n    var es = []\n    if e.kind == \"gap\" and has_c and _defined(b, \"missing\") \{\n      let ck = _k(b.compartment)\n      var set_at = null\n      if has(by_field, ck) and has(by_field[ck], _k(b.missing)) \{ set_at = by_field[ck][_k(b.missing)] \}\n      if set_at != null \{ es = _add(es, e.seq, set_at, \"state.\{_t(b, \"missing\")\} was last set here\", 0.95) \}\n      else \{ es = _add(es, e.seq, get(decl, ck, null), \"state.\{_t(b, \"missing\")\} has been null since \{_t(b, \"compartment\")\} was declared\", 0.95) \}\n    \} else if (e.kind == \"rejected\" or e.kind == \"transition\") and has_c \{\n      let ck = _k(b.compartment)\n      es = _add(es, e.seq, get(last_state, ck, null) ?? get(decl, ck, null), \"\{_t(b, \"compartment\")\}'s state as it stood\", 0.8)\n    \}\n    if e.kind == \"gap\" and get(b, \"source\", null) == \"observe\" and _truthy(get(b, \"evidence\", null)) \{\n      let ev = b.evidence\n      es = _add(es, e.seq, get(ev, \"to\", null) ?? get(ev, \"since\", null) ?? get(ev, \"from\", null), \"the reading this gap was opened from\", 1)\n    \}\n    if e.kind == \"gap.close\" \{ es = _add(es, e.seq, get(gap_at, _k(get(b, \"gap\", null)), null), \"closes this gap\", 1) \}\n    if _defined(b, \"signal\") and has(last_signal, _k(b.signal)) \{ es = _add(es, e.seq, last_signal[_k(b.signal)], \"the previous \{_t(b, \"signal\")\}\", 0.6) \}\n    // the strongest edge per parent; the first of equal weight kept (debug.js: replaced only by a strictly heavier one)\n    var best = \{\}\n    var order = []\n    for x in es \{\n      let fk = str(x.from)\n      if not has(best, fk) \{ best[fk] = x; order = push(order, fk) \}\n      else if best[fk].weight < x.weight \{ best[fk] = x \}\n    \}\n    var list = []\n    for fk in order \{ list = push(list, best[fk]) \}\n    out[str(e.seq)] = OB.sort_with(list, fn(p, q) = p.weight > q.weight or (p.weight == q.weight and p.from < q.from))\n    if (e.kind == \"compartment\" or e.kind == \"register\") and _defined(b, \"name\") \{ decl[_k(b.name)] = e.seq \}\n    if e.kind == \"transition\" and has_c \{\n      let ck = _k(b.compartment)\n      last_state[ck] = e.seq\n      if not has(by_field, ck) \{ by_field[ck] = \{\} \}\n      var fields = by_field[ck]\n      for k in _keys_of(b) \{ fields[_k(k)] = e.seq \}\n      by_field[ck] = fields\n    \}\n    if _defined(b, \"signal\") \{ last_signal[_k(b.signal)] = e.seq \}\n    if e.kind == \"gap\" and _defined(b, \"gap\") \{ gap_at[_k(b.gap)] = e.seq \}\n  \}\n  return out\n\}\n\nfn _edges_of(ed, seq) = get(ed, str(seq), [])\n\n/** the entry with this seq (entries are 1-based and in order; a search when they are not) */\nfn _at1(entries, seq) \{\n  if type_of(seq) == \"num\" and seq >= 1 and seq <= len(entries) and entries[seq - 1].seq == seq \{ return entries[seq - 1] \}\n  return find(entries, fn(x) = x.seq == seq)\n\}\nfn _brief(e) = \{ seq: e.seq, kind: e.kind, summary: summary(e) \}\n\n// ── why ──────────────────────────────────────────────────────────────────────────────────────────────────\nfn why(entries, seq, depth = 24) \{\n  let e = _at1(entries, seq)\n  if e == null \{ return \{ ok: false, reason: \"no entry \{seq\}\" \} \}\n  let ed = edges(entries)\n  var chain = [\{ seq: e.seq, kind: e.kind, summary: summary(e), via: null \}]\n  var seen = \{\}\n  seen[str(e.seq)] = true\n  var cur = e.seq\n  var going = true\n  while going and len(chain) < depth \{\n    let next = find(_edges_of(ed, cur), fn(x) = not has(seen, str(x.from)))\n    if next == null \{ going = false \}\n    else \{\n      let p = _at1(entries, next.from)\n      chain = push(chain, \{ seq: p.seq, kind: p.kind, summary: summary(p), via: next.via, inferred: true \})\n      seen[str(p.seq)] = true\n      cur = p.seq\n    \}\n  \}\n  var earlier = []\n  for x in entries \{\n    if x.seq < seq \{ earlier = push(earlier, _brief(x)) \}\n  \}\n  let before = slice(earlier, max(0, len(earlier) - 3))\n  var after = []\n  for x in entries \{\n    if len(after) < 5 and x.seq > seq and any(_edges_of(ed, x.seq), fn(y) = y.from == seq and y.weight >= 0.8) \{ after = push(after, _brief(x)) \}\n  \}\n  var root = null\n  if len(chain) > 1 \{ root = chain[len(chain) - 1] \}\n  return \{ ok: true, seq: seq, chain: chain, root: root, before: before, consequences: after,\n    note: \"causal edges are inferred from state lineage, signal names and observe evidence — entries do not yet carry a causal parent\" \}\n\}\n\n// ── at: the world after an entry ─────────────────────────────────────────────────────────────────────────\nfn _unverified(rep) = \"the ledger does not verify at \{rep.verify.seq\}: \{rep.verify.reason\}\"\n\nfn at(entries, seq, P) \{\n  let e = _at1(entries, seq)\n  if e == null \{ return \{ ok: false, reason: \"no entry \{seq\}\" \} \}\n  let prefix = slice(entries, 0, index_of(entries, e) + 1)\n  var states = \{\}\n  var names = \{\}\n  var order = []\n  for x in prefix \{\n    let b = OB.body_of(x)\n    if (x.kind == \"compartment\" or x.kind == \"register\") and _defined(b, \"name\") \{\n      var s = \{\}\n      if has(b, \"state\") and type_of(b.state) == \"map\" \{\n        for k, v in b.state \{ s[k] = v \}\n      \}\n      let nk = _t(b, \"name\")\n      if not has(states, nk) \{ order = push(order, nk) \}\n      states[nk] = s\n      names[nk] = x.seq\n    \} else if x.kind == \"transition\" and has(states, _t(b, \"compartment\")) \{\n      let nk = _t(b, \"compartment\")\n      var s = states[nk]\n      if has(b, \"changes\") and type_of(b.changes) == \"map\" \{\n        for k, v in b.changes \{ s[k] = v \}\n      \}\n      states[nk] = s\n    \} else if x.kind == \"despawn\" and _defined(b, \"name\") \{\n      let nk = _t(b, \"name\")\n      if has(states, nk) \{\n        states = without(states, nk)\n        order = filter(order, fn(o) = o != nk)\n      \}\n    \}\n  \}\n  let rep = OB.observe(prefix, P)\n  if not rep.ok \{ return \{ ok: false, reason: _unverified(rep) \} \}\n  var compartments = \{\}\n  for n in order \{ compartments[n] = \{ state: states[n], declared: names[n] \} \}\n  return \{ ok: true, seq: seq, entry: \{ kind: e.kind, summary: summary(e) \}, compartments: compartments,\n    open_gaps: map(rep.gaps.open, fn(g) = \{ seq: g.seq, gap: g.gap, type: g.type, pressure: g.pressure, occurrences: g.occurrences \}),\n    field: rep.field.now, field_regime_since: rep.field.hold.since,\n    sigma: \{ regime: rep.sigma.regime, cause: get(rep.sigma, \"dominant_cause\", null), confidence: get(rep.sigma, \"confidence\", null) \},\n    velocity: rep.liminal.velocity.now \}\n\}\n\n// ── follow ───────────────────────────────────────────────────────────────────────────────────────────────\nfn _hit(e, f) \{\n  let b = OB.body_of(e)\n  if has(f, \"compartment\") and not (get(b, \"compartment\", null) == f.compartment or get(b, \"name\", null) == f.compartment) \{ return false \}\n  if has(f, \"signal\") and get(b, \"signal\", null) != f.signal \{ return false \}\n  if has(f, \"kind\") and e.kind != f.kind \{ return false \}\n  if has(f, \"from\") and e.seq < f.from \{ return false \}\n  if has(f, \"to\") and e.seq > f.to \{ return false \}\n  return true\n\}\nfn follow(entries, f) \{\n  let hit = filter(entries, fn(e) = _hit(e, f))\n  return \{ ok: true, count: len(hit), entries: map(hit, _brief) \}\n\}\n\nfn _side(es, i) \{\n  if i < len(es) \{ return \{ seq: es[i].seq, kind: es[i].kind, summary: summary(es[i]), body: es[i].body \} \}\n  return null\n\}\n\n// ── diff ─────────────────────────────────────────────────────────────────────────────────────────────────\nfn diff(a, b, P) \{\n  let n = min(len(a), len(b))\n  var i = 0\n  while i < n and a[i].hash == b[i].hash \{ i += 1 \}\n  if i == len(a) and i == len(b) \{ return \{ ok: true, identical: true, entries: n \} \}\n  var wa = null\n  var wb = null\n  if i > 0 \{\n    wa = at(a, i, P)\n    wb = at(b, i, P)\n  \}\n  var changed = \{\}\n  if wa != null and wb != null and wa.ok and wb.ok \{\n    var names = keys(wa.compartments)\n    for c in keys(wb.compartments) \{\n      if not (names contains c) \{ names = push(names, c) \}\n    \}\n    for c in names \{\n      var sa = null\n      var sb = null\n      if has(wa.compartments, c) \{ sa = wa.compartments[c].state \}\n      if has(wb.compartments, c) \{ sb = wb.compartments[c].state \}\n      if json(sa) != json(sb) \{ changed[c] = \{ a: sa, b: sb \} \}\n    \}\n  \}\n  var note = \"the runs share every entry before this one (hash-chained), so everything after it can differ\"\n  if i == n \{ note = \"one run is a prefix of the other\" \}\n  return \{ ok: true, identical: false, common: i, first: i + 1, a: _side(a, i), b: _side(b, i), a_longer_by: len(a) - len(b), note: note,\n    state_before_diverging_differs: changed \}\n\}\n\n// ── blame ────────────────────────────────────────────────────────────────────────────────────────────────\nfn blame(entries, P) \{\n  let rep = OB.observe(entries, P)\n  if not rep.ok \{ return \{ ok: false, reason: _unverified(rep) \} \}\n  let first = find(entries, fn(e) = (OB.STRESS contains e.kind) and not OB.is_derived(e, P))\n  var field_regime = null\n  if rep.field.now != null \{ field_regime = rep.field.now.regime \}\n  var out = \{ ok: true, entries: len(entries), field: field_regime, sigma: rep.sigma.regime, first_stress: null, first_unhealthy: null \}\n  if first != null \{ out.first_stress = why(entries, first.seq) \}\n  // the first entry after which the field was turbulent or chaotic (one pass over the series observe already computed)\n  let hit = find(rep.series, fn(r) = r.regime == \"turbulent\" or r.regime == \"chaotic\")\n  if hit != null \{ out.first_unhealthy = \{ seq: hit.seq, regime: hit.regime, why: why(entries, hit.seq) \} \}\n  out.open_gaps = len(rep.gaps.open)\n  out.proposals = map(rep.gaps.proposals, fn(p) = \{ type: p.type, pressure: p.pressure, message: p.message \})\n  out.clean = first == null and hit == null\n  return out\n\}\n\n// ── clip ─────────────────────────────────────────────────────────────────────────────────────────────────\nfn _index_of_seq(entries, seq) \{\n  var i = 0\n  for e in entries \{\n    if e.seq == seq \{ return i \}\n    i += 1\n  \}\n  return -1\n\}\nfn clip(entries, from, to, P) \{\n  let a = _index_of_seq(entries, from)\n  let b = _index_of_seq(entries, to)\n  if a < 0 or b < 0 or a > b \{ return \{ ok: false, reason: \"no range \{from\}..\{to\}\" \} \}\n  let piece = slice(entries, a, b + 1)\n  let rep = OB.observe(slice(entries, 0, b + 1), P)\n  if not rep.ok \{ return \{ ok: false, reason: \"the ledger does not verify at \{rep.verify.seq\}\" \} \}\n  return \{ ok: true, magic: \"EG-CLIP\", fmt: 1, seqRange: [from, to], count: len(piece),\n    anchor: \{ prev: piece[0].prev, head: piece[len(piece) - 1].hash \},\n    profile: \{ field: rep.field.now, field_regime_since: rep.field.hold.since, sigma: rep.sigma.regime, velocity: rep.liminal.velocity.now,\n      open_gaps: len(rep.gaps.open) \},\n    entries: piece \}\n\}\n\nfn _rehash(e) \{\n  try \{ return \{ h: L.hash_entry(e) \} \} else err \{ return \{ err: err.message \} \}\n\}\nfn verify_clip(c, whole) \{\n  if c == null or type_of(c) != \"map\" or get(c, \"magic\", null) != \"EG-CLIP\" or type_of(get(c, \"entries\", null)) != \"list\" or len(c.entries) == 0 \{\n    return \{ ok: false, reason: \"not a clip\" \}\n  \}\n  var prev = c.anchor.prev\n  var i = 0\n  for e in c.entries \{\n    if e.prev != prev \{ return \{ ok: false, seq: e.seq, reason: \"prev does not link to the previous entry\" \} \}\n    let r = _rehash(e)\n    if has(r, \"err\") \{ return \{ ok: false, seq: e.seq, reason: r.err \} \}\n    if r.h != e.hash \{ return \{ ok: false, seq: e.seq, reason: \"hash does not match the entry\" \} \}\n    if i > 0 and e.seq != c.entries[i - 1].seq + 1 \{ return \{ ok: false, seq: e.seq, reason: \"seq out of order\" \} \}\n    prev = e.hash\n    i += 1\n  \}\n  if prev != c.anchor.head \{ return \{ ok: false, reason: \"the last entry is not the anchored head\" \} \}\n  if whole != null \{\n    let m = find(whole, fn(e) = e.seq == c.seqRange[1])\n    if m == null or m.hash != c.anchor.head \{ return \{ ok: false, reason: \"the clip does not belong to that ledger\" \} \}\n  \}\n  return \{ ok: true \}\n\}\n\n// ── the ledger_why() builtin, natively (lower.eg rewrites ledger_why(n) to this): the answer frozen, a missing entry refused, as\n// lang/runtime.js does (\"ledger_why: <reason>\")\nfn why_builtin(entries, n) \{\n  var seq = n\n  if type_of(n) == \"int\" \{ seq = num(n) \}\n  else if type_of(n) != \"num\" \{ raise(\"ledger_why needs a seq (num or int), got \{type_of(n)\}\") \}\n  let w = why(entries, seq)\n  if not w.ok \{ raise(\"ledger_why: \{w.reason\}\") \}\n  return freeze(w)\n\}\n"
