let TEXT = "// lang/cie/contract.eg — the interaction contract, in Emerge (CIE-EG 6.1, MOD-CONTRACT; phase CIE1).\n// James, 2026-11-06 (D7): \"New contract block\".\n//\n//   parse_contract(src)      → Contract \{ id, version, text, gate, roads \}   or raise(\"contract: …\"), said why\n//   contract_hash(c)         → 64 hex: SHA-256 over the canonical form (ECF, CIE-EG 4.3)\n//   roads_from(c, hook)      → the roads leaving \"Comp.hook\"\n//   canonical(v)             → the ECF text of a value (keys in byte order, minimal JSON escapes)\n//\n// The scaffold reads the same block (lang/parser.js → lang/contract.js). The two are held to the same answer, byte for byte, by\n// lang/test/contract.test.js: the same hash, and the same refusals. Written in Emerge so it survives the scaffold (CIE-EG 0: the Node\n// runtime is retired; what is added to it is worth adding only if it can be written again in .eg).\n//\n// Roads are a set: sorted in the canonical form, so the order they are written in does not change the hash; a road twice is refused.\n// Defaults are the primitives' own values (dispatch.max_deliveries, ledger.checkpoint_every, observe.gaps.block_at).\n\nuse \"./ledger.eg\" as L\n\nlet DEFAULT_TEXT = \{ encoding: \"utf-8\", normalization: \"nfc\" \}\nlet DEFAULT_GATE = \{ block_at: 0.9, max_steps: 100000, checkpoint_every: 256 \}\n\nvar src = bytes(\"\")\nvar pos = 0\nvar n = 0\nvar line = 1\n\nfn fail(what) \{ raise(\"contract: line \{line\}: \{what\}\") \}\n\n// ── characters ───────────────────────────────────────────────────────────────\nfn is_letter(c) = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95\nfn is_digit(c) = c >= 48 and c <= 57\nfn is_ident(s) \{\n  let b = bytes(s)\n  if len(b) == 0 or not is_letter(b[0]) \{ return false \}\n  for c in b \{ if not (is_letter(c) or is_digit(c)) \{ return false \} \}\n  return true\n\}\n\n/** blanks and comments; a newline ends a statement, so it is reported, not skipped, unless asked */\nfn blank(newlines) \{\n  while pos < n \{\n    let c = src[pos]\n    if c == 32 or c == 9 or c == 13 \{ pos += 1 \}\n    else if c == 10 and newlines \{ pos += 1; line += 1 \}\n    else if c == 59 and newlines \{ pos += 1 \}\n    else if c == 47 and pos + 1 < n and src[pos + 1] == 47 \{\n      while pos < n and src[pos] != 10 \{ pos += 1 \}\n    \} else \{ return null \}\n  \}\n\}\n\nfn peek_byte() \{\n  if pos < n \{ return src[pos] \}\n  return -1\n\}\n\nfn ident() \{\n  blank(false)\n  let s = pos\n  if pos >= n or not is_letter(src[pos]) \{ fail(\"expected a name\") \}\n  while pos < n and (is_letter(src[pos]) or is_digit(src[pos])) \{ pos += 1 \}\n  if pos < n and src[pos] >= 128 \{ fail(\"a name is [A-Za-z_][A-Za-z0-9_]* (CIE-EG 2.4)\") \}\n  return utf8(slice(src, s, pos))\n\}\n\nfn op(c, what) \{\n  blank(false)\n  if pos >= n or src[pos] != c \{ fail(\"expected \{what\}\") \}\n  pos += 1\n\}\n\nfn plain_string(what) \{\n  blank(false)\n  if pos >= n or src[pos] != 34 \{ fail(\"\{what\} is a plain string\") \}\n  pos += 1\n  let s = pos\n  while pos < n and src[pos] != 34 \{\n    if src[pos] == 92 or src[pos] == 123 or src[pos] == 10 \{ fail(\"\{what\} is a plain string (no escapes, braces or newlines)\") \}\n    pos += 1\n  \}\n  if pos >= n \{ fail(\"unterminated string\") \}\n  let v = utf8(slice(src, s, pos))\n  pos += 1\n  return v\n\}\n\nfn number(what) \{\n  blank(false)\n  let s = pos\n  while pos < n and (is_digit(src[pos]) or src[pos] == 46 or src[pos] == 95 or src[pos] == 101 or src[pos] == 69 or\n                     ((src[pos] == 43 or src[pos] == 45) and pos > s and (src[pos - 1] == 101 or src[pos - 1] == 69))) \{ pos += 1 \}\n  if pos == s \{ fail(\"\{what\} is a number\") \}\n  return num(replace(utf8(slice(src, s, pos)), \"_\", \"\"))\n\}\n\n/** the end of a statement inside a block: a newline, \";\", or the closing brace next */\nfn end_stmt() \{\n  blank(false)\n  let c = peek_byte()\n  if c == 10 or c == 59 \{ blank(true); return null \}\n  if c == 125 or c == -1 \{ return null \}\n  fail(\"expected the end of the statement\")\n\}\n\n// ── the block ────────────────────────────────────────────────────────────────\nfn settings(which) \{\n  op(123, \"\\\{ to open \{which\}\")\n  var out = \{\}\n  blank(true)\n  while peek_byte() != 125 \{\n    if pos >= n \{ fail(\"unterminated \{which\} block\") \}\n    let k = ident()\n    if has(out, k) \{ fail(\"\{which\}.\{k\} is written twice\") \}\n    op(61, \"= after \{which\}.\{k\}\")\n    if which == \"text\" \{ out[k] = plain_string(\"text.\{k\}\") \} else \{ out[k] = number(\"gate.\{k\}\") \}\n    blank(true)\n  \}\n  pos += 1\n  return out\n\}\n\nfn road_end() \{\n  let a = ident()\n  op(46, \"Component.hook (identifiers only, CIE-EG 2.4)\")\n  let b = ident()\n  return \"\{a\}.\{b\}\"\n\}\n\n/** contract <id> \{ version = \"…\"  text \{ … \}  gate \{ … \}  road A.h -> B.h \} */\nfn parse_contract(text) \{\n  src = bytes(text)\n  pos = 0\n  n = len(src)\n  line = 1\n  blank(true)\n  let kw = ident()\n  if kw != \"contract\" \{ fail(\"expected contract, found \{kw\}\") \}\n  let id = ident()\n  op(123, \"\\\{ to open the contract\")\n  var raw = \{ id: id, text: \{\}, gate: \{\}, roads: [] \}\n  var once = \{\}\n  blank(true)\n  while peek_byte() != 125 \{\n    if pos >= n \{ fail(\"unterminated contract — missing \\\}\") \}\n    let w = ident()\n    if w == \"version\" or w == \"text\" or w == \"gate\" \{\n      if has(once, w) \{ fail(\"the contract's \{w\} is written twice\") \}\n      once[w] = true\n      if w == \"version\" \{\n        op(61, \"= after version\")\n        raw[\"version\"] = plain_string(\"version\")\n      \} else \{\n        raw[w] = settings(w)\n      \}\n    \} else if w == \"road\" \{\n      let from = road_end()\n      op(45, \"-> between the two ends of a road\")\n      op(62, \"-> between the two ends of a road\")\n      let to = road_end()\n      raw[\"roads\"] = push(raw.roads, \{ from: from, to: to \})\n    \} else \{\n      fail(\"a contract holds version, text \\\{ \\\}, gate \\\{ \\\} and road Component.hook -> Component.hook — found \{w\}\")\n    \}\n    end_stmt()\n  \}\n  pos += 1\n  blank(true)\n  if pos < n \{ fail(\"one contract per source; something follows it\") \}\n  return normalize(raw)\n\}\n\n// ── the rules (the same as lang/contract.js) ────────────────────────────────\nfn digits_only(s) \{\n  let b = bytes(s)\n  if len(b) == 0 \{ return false \}\n  for c in b \{ if not is_digit(c) \{ return false \} \}\n  return true\n\}\n\nfn tag_ok(s) \{\n  let b = bytes(s)\n  if len(b) == 0 \{ return false \}\n  for c in b \{ if not (is_letter(c) and c != 95 or is_digit(c) or c == 46 or c == 45) \{ return false \} \}\n  return true\n\}\n\n/** x.y.z, no leading zeros, an optional -pre and +build */\nfn is_semver(v) \{\n  var core = v\n  var rest = \"\"\n  let plus = find_text(core, \"+\")\n  if plus >= 0 \{\n    if not tag_ok(slice(core, plus + 1)) \{ return false \}\n    core = slice(core, 0, plus)\n  \}\n  let dash = find_text(core, \"-\")\n  if dash >= 0 \{\n    if not tag_ok(slice(core, dash + 1)) \{ return false \}\n    core = slice(core, 0, dash)\n  \}\n  let parts = split(core, \".\")\n  if len(parts) != 3 \{ return false \}\n  for p in parts \{\n    if not digits_only(p) \{ return false \}\n    if len(p) > 1 and slice(p, 0, 1) == \"0\" \{ return false \}\n  \}\n  return true\n\}\n\nfn normalize(r) \{\n  if not is_ident(r.id) \{ raise(\"contract: contract id \\\"\{r.id\}\\\" is not an identifier\") \}\n  if not has(r, \"version\") \{ raise(\"contract: contract \{r.id\} has no version — write version = \\\"1.0.0\\\"\") \}\n  if not is_semver(r.version) \{ raise(\"contract: contract \{r.id\}: version \\\"\{r.version\}\\\" is not semver (x.y.z)\") \}\n\n  var text = clone(DEFAULT_TEXT)\n  for k in keys(r.text) \{\n    if not has(DEFAULT_TEXT, k) \{ raise(\"contract: contract \{r.id\}: text has no setting \\\"\{k\}\\\"\") \}\n    if r.text[k] != DEFAULT_TEXT[k] \{ raise(\"contract: contract \{r.id\}: text.\{k\} = \\\"\{r.text[k]\}\\\" — only \\\"\{DEFAULT_TEXT[k]\}\\\" is spoken\") \}\n    text[k] = r.text[k]\n  \}\n\n  var gate = clone(DEFAULT_GATE)\n  for k in keys(r.gate) \{\n    if not has(DEFAULT_GATE, k) \{ raise(\"contract: contract \{r.id\}: gate has no setting \\\"\{k\}\\\"\") \}\n    let v = r.gate[k]\n    if k == \"block_at\" \{\n      if v < 0 or v > 1 \{ raise(\"contract: contract \{r.id\}: gate.block_at = \{v\} — a pressure is in [0, 1]\") \}\n    \} else if v < 1 or floor(v) != v \{\n      raise(\"contract: contract \{r.id\}: gate.\{k\} = \{v\} — a whole number, at least 1\")\n    \}\n    gate[k] = v\n  \}\n\n  var seen = \{\}\n  for rd in r.roads \{\n    let key = \"\{rd.from\} -> \{rd.to\}\"\n    if has(seen, key) \{ raise(\"contract: contract \{r.id\}: road \{key\} is written twice\") \}\n    seen[key] = true\n  \}\n  // sorted by the same key sort_by used (\"from\\0to\", by code point), with the prelude's sort: sort_by is not native yet (CIE14 e)\n  var by_key = \{\}\n  var road_keys = []\n  for rd in r.roads \{\n    let rk = \"\{rd.from\}\\0\{rd.to\}\"\n    by_key[rk] = rd\n    road_keys = push(road_keys, rk)\n  \}\n  var roads = []\n  for rk in sort(road_keys) \{ roads = push(roads, by_key[rk]) \}\n  return \{ id: r.id, version: r.version, text: text, gate: gate, roads: roads \}\n\}\n\n// ── the canonical form and the hash ─────────────────────────────────────────\n/** ECF (CIE-EG 4.3): null, bools, numbers as written by the ledger, strings with minimal JSON escapes, keys in byte order */\n// One writer of the canonical form: lang/cie/ledger.eg's ecf (CIE-EG 4.3), which also runs natively. Until 2026-11-06 this file had its own,\n// built on json(), which is not native (CIE14 e); the two gave the same text, so the hash is unchanged (contract.test).\nfn canonical(v) = L.ecf(v)\n\nfn contract_hash(c) = hex(sha256(canonical(c)))\n\nfn roads_from(c, hook) = filter(c.roads, fn(r) = r.from == hook)\n"
