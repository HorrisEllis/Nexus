// lang/native/emerge.eg — the native Emerge compiler (CIE-EG section 10). Built from Emerge source by Emerge itself:
//   emerge <main.eg> [-o out]
// reads the program and every module it uses, parses them (front.eg), and writes a Linux x86-64 executable (codegen.eg)
// whose runtime (rt.eg, carried inside this compiler as rt_text.eg) and standard library (core/prelude.eg, carried as
// prelude_text.eg) are linked in. No Node, no libc.
use "./front.eg" as front
use "./codegen.eg" as cg
use "./rt_text.eg" as rt_text
use "./prelude_text.eg" as prelude_text
use "./lower.eg" as lower
use "./defaults.eg" as defaults
use "./world_text.eg" as world_text
use "./ledger_text.eg" as ledger_text
use "./contract_text.eg" as contract_text
use "./regex_text.eg" as regex_text
use "./json_text.eg" as json_text

// CIE4 slice b: lang/cie/world.eg and lang/cie/ledger.eg carried inside the compiler, as the runtime and the prelude are (regenerate:
// eg run embed.eg ../cie/world.eg world_text.eg; the same for ledger.eg and contract.eg). A program with a compartment, a component, a contract,
// an on handler, an emit, a send or a wire is lowered to world.eg calls (lower.eg).
let EMBEDDED = { "<cie>/world.eg": world_text.TEXT, "<cie>/ledger.eg": ledger_text.TEXT, "<cie>/contract.eg": contract_text.TEXT, "<cie>/regex.eg": regex_text.TEXT, "<cie>/json.eg": json_text.TEXT}
// The genesis entry names the build, as lang/runtime.js does (package.json "version"); native.test 'world' fails if the two drift.
let VERSION = "1.13.0"
// emerge prog.eg --test: the program's test blocks run after it, as eg test does (CIE5); only the main file's tests, as eg test
var TEST_MODE = false
var KNOWN_DEFAULTS = {}
var MAIN_PATH = ""

fn last_slash(p) {
  var i = len(p) - 1
  while i >= 0 {
    if p[i] == "/" { return i }
    i -= 1
  }
  return -1
}
fn dirname(p) {
  let k = last_slash(p)
  if k < 0 { return "." }
  if k == 0 { return "/" }
  return slice(p, 0, k)
}
fn basename(p) { return slice(p, last_slash(p) + 1) }
// split on "/" and resolve "." and ".." segments
fn normalize(p) {
  var segs = []
  var cur = ""
  for c in p + "/" {
    if c == "/" {
      if cur == ".." and len(segs) > 0 and segs[len(segs) - 1] != ".." {
        segs = slice(segs, 0, len(segs) - 1)
      } else if cur != "." and cur != "" {
        segs[len(segs)] = cur
      } else if cur == ".." {
        segs[len(segs)] = cur
      }
      cur = ""
    } else {
      cur = cur + c
    }
  }
  var out = ""
  if len(p) > 0 and p[0] == "/" { out = "/" }
  var first = true
  for s in segs {
    if not first { out = out + "/" }
    out = out + s
    first = false
  }
  if out == "" { return "." }
  return out
}
fn resolve_path(base, rel) {
  if len(rel) > 0 and rel[0] == "<" { return rel }   // an embedded module (<cie>/world.eg), carried inside the compiler
  if len(rel) > 0 and rel[0] == "/" { return normalize(rel) }
  return normalize(base + "/" + rel)
}

// the file name errors carry: a module's path relative to the main file's folder, as the interpreter names it (lib/stats.eg), else its basename
fn shown_name(path) {
  if MAIN_PATH != "" and not (path starts_with "<") {
    let base = dirname(MAIN_PATH) + "/"
    if path starts_with base { return slice(path, len(base)) }
  }
  return basename(path)
}

var modules = []
var ids = {}
var visiting = {}

fn load(path, raw, text) { return load_as(path, raw, text, null) }
fn load_as(path, raw, text, want_id) {
  if has(ids, path) { return ids[path] }
  if has(visiting, path) { raise("emerge: use cycle through {path}") }
  if path ends_with ".node" { raise("native: a node file (use \"{basename(path)}\") is not in the native subset yet") }
  visiting[path] = true
  var src = text
  if src == null and has(EMBEDDED, path) { src = EMBEDDED[path] }
  if src == null { src = read_file(path) }
  var ast = front.parse(src, shown_name(path))
  // optional parameters (native/defaults.eg): every module but the runtime, the prelude first, so programs find the prelude's entries
  if not raw { ast = defaults.desugar(ast, KNOWN_DEFAULTS) }
  // the world itself (<cie>/…) is never lowered: it is what the lowering calls
  if not raw and want_id == null and not (path starts_with "<") { ast = lower.lower(ast, VERSION, TEST_MODE and path == MAIN_PATH) }
  var uses = {}
  for it in ast.items {
    if it.type == "Use" { uses[it.alias] = load(resolve_path(dirname(path), it.path), false, null) }
  }
  var id = "rt"
  if not raw { id = "m" + str(len(modules)) }
  if want_id != null { id = want_id }
  modules[len(modules)] = { id: id, raw: raw, path: path, uses: uses, ast: ast }
  ids[path] = id
  visiting[path] = false
  return id
}

fn main() {
  let a = args()
  if len(a) == 0 {
    print("usage: emerge <main.eg> [-o out] [--test]")
    return 1
  }
  var main_path = ""
  var out = ""
  var i = 0
  while i < len(a) {
    if a[i] == "-o" and i + 1 < len(a) {
      out = a[i + 1]
      i += 2
    } else if a[i] == "--test" {
      TEST_MODE = true
      i += 1
    } else {
      main_path = a[i]
      i += 1
    }
  }
  if out == "" {
    out = basename(main_path)
    if out ends_with ".eg" { out = slice(out, 0, len(out) - 3) }
  }
  load("<runtime>/rt.eg", true, rt_text.TEXT)
  load_as("<prelude>", false, prelude_text.TEXT, "prelude")
  MAIN_PATH = normalize(main_path)
  let m = load(MAIN_PATH, false, null)
  write_bytes(out, cg.compile_bundle({ modules: modules, main: m }))
  chmod_exec(out)
  return 0
}
main()
