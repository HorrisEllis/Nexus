let TEXT = "// lang/cie/observe.eg — the observer in Emerge (CIE7, CIE-EG §13): the ledger read as a field. Written again from observe/*.js\n// (entry, delta, sigma, field, liminal, gaps, index), rule for rule; its end state is the interpreter's own observe() builtin, report for\n// report (native.test's judge has no JavaScript of its own: an Emerge program calls both and compares them).\n//\n//   observe(entries, P) → \{ ok, version, head, entries, measured, field, sigma, deviations, liminal, gaps, series \}   or \{ ok: false, verify \}\n//\n// P is lang/core/primitives.eg (its observe, gaps and signals sections); a run under a contract passes its gate's block_at in P.observe.gaps.\n// Pure: the same entries and the same P always give the same report. Nothing here writes to the ledger.\n//\n// The two measures, as James set them on 2026-11-07 (\"Deltas measure gaps and sigmas measure deviation\"): a delta is the gap in ticks since\n// the previous entry of the same key; sigma is that gap's deviation from the key's own rolling baseline (a z-score), read as a regime.\nuse \"./ledger.eg\" as L\n\n// ── entry: how the observer reads one ledger entry (observe/entry.js) ─────────────────────────────────────\n// kinds that are the system struggling, and kinds that are it integrating\nlet STRESS = [\"gap\", \"rejected\", \"unrouted\", \"aborted\", \"promotion_refused\"]\nlet INTEGRATING = [\"transition\", \"promote\", \"axiom\"]\n\nfn body_of(e) \{\n  if e != null and type_of(e.body) == \"map\" \{ return e.body \}\n  return \{\}\n\}\nfn _str_or(b, k, d) \{\n  if has(b, k) and b[k] != null \{ return b[k] \}\n  return d\n\}\n/** what an entry is about: kind | compartment-or-name | signal, constraint, message, path or wire ends */\nfn key_of(e) \{\n  let b = body_of(e)\n  let who = _str_or(b, \"compartment\", _str_or(b, \"name\", \"\"))\n  var what = \"\"\n  if has(b, \"signal\") and b.signal != null \{ what = b.signal \}\n  else if has(b, \"constraint\") and b.constraint != null \{ what = b.constraint \}\n  else if has(b, \"message\") and b.message != null \{ what = b.message \}\n  else if has(b, \"path\") and b.path != null \{ what = b.path \}\n  else if has(b, \"from\") \{ what = \"\{b.from\}>\{get(b, \"to\", null)\}\" \}\n  return \"\{e.kind\}|\{who\}|\{what\}\"\n\}\n/** the pressure of a gap or a refused promotion; null for any other kind */\nfn pressure_of(e, P) \{\n  let b = body_of(e)\n  if e.kind == \"gap\" \{\n    if has(b, \"pressure\") and type_of(b.pressure) == \"num\" \{ return b.pressure \}\n    return P.gaps.constraint_gap.pressure\n  \}\n  if e.kind == \"promotion_refused\" \{ return P.gaps.promotion_refused.pressure \}\n  return null\n\}\n/** a consequence, not evidence: a gap the observer opened, or an unrouted notification of the runtime's own signals */\nfn is_derived(e, P) \{\n  let b = body_of(e)\n  if e.kind == \"gap\" and get(b, \"source\", null) == \"observe\" \{ return true \}\n  if e.kind == \"unrouted\" and has(b, \"signal\") and values(P.signals) contains b.signal \{ return true \}\n  return false\n\}\nfn q4(x) = round(x * 10000) / 10000\n/** a stable name for a condition: the first `hex_n` digits of SHA-256 over the canonical form of `parts` */\nfn dedup_key(parts, hex_n) = slice(hex(sha256(bytes(\"eg.observe.dedup.v1\\0\" + L._ecf(parts, \"dedup parts\")))), 0, hex_n)\nfn mean(xs) \{\n  if len(xs) == 0 \{ return 0 \}\n  var s = 0\n  for x in xs \{ s += x \}\n  return s / len(xs)\n\}\nfn std(xs) \{\n  if len(xs) < 2 \{ return 0 \}\n  let m = mean(xs)\n  var sq = []\n  for x in xs \{ sq[len(sq)] = (x - m) * (x - m) \}\n  return sqrt(mean(sq))\n\}\nfn clamp01(x) = max(0, min(1, x))\n/** a stable sort by a comparator: before(a, b) is true when a goes first (JavaScript's Array.prototype.sort is stable too) */\nfn sort_with(xs, before) \{\n  var out = []\n  for x in xs \{\n    var j = len(out)\n    out[j] = x\n    while j > 0 and before(x, out[j - 1]) \{\n      out[j] = out[j - 1]\n      j -= 1\n    \}\n    out[j] = x\n  \}\n  return out\n\}\n\n// ── delta: kinematic deltas in logical ticks (observe/delta.js) ────────────────────────────────────────────\nfn compute_deltas(entries, O) \{\n  let D = O.deviation\n  var last_seq = \{\}\n  var gaps_of = \{\}\n  var cum = [0]\n  var out = []\n  var i = 0\n  for e in entries \{\n    var c = cum[i]\n    if STRESS contains e.kind \{ c += 1 \}\n    cum[len(cum)] = c\n    let key = key_of(e)\n    var gap_n = null\n    var zs = 0\n    var z = 0\n    var measured = false\n    if e.kind != \"checkpoint\" \{\n      var w = get(gaps_of, key, [])\n      if has(last_seq, key) \{\n        gap_n = e.seq - last_seq[key]\n        if len(w) >= D.min_samples \{\n          zs = (gap_n - mean(w)) / max(std(w), D.tick_floor)\n          z = max(0, zs)\n          measured = true\n        \}\n        w[len(w)] = gap_n\n        if len(w) > D.window \{ w = slice(w, 1) \}\n      \}\n      gaps_of[key] = w\n      last_seq[key] = e.seq\n    \}\n    let n = i + 1\n    let W = D.rate_window\n    let accel_measured = n >= 2 * W\n    var accel = 0\n    if accel_measured \{ accel = ((cum[n] - cum[n - W]) - (cum[n - W] - cum[n - 2 * W])) / W \}\n    out[len(out)] = \{ seq: e.seq, kind: e.kind, key: key, gap: gap_n, latencyImpact: q4(z), zs: q4(zs), measured: measured, acceleration: q4(accel),\n      accelMeasured: accel_measured, structuralDeviation: null \}\n    i += 1\n  \}\n  return out\n\}\n\n// ── sigma: a window of deltas in, a regime out (observe/sigma.js) ───────────────────────────────────────────\nfn _conf(value, threshold) \{\n  if threshold > 0 \{ return q4(min(1, value / threshold)) \}\n  if value > 0 \{ return 1 \}\n  return 0\n\}\nfn features(window, O) \{\n  var S = 0\n  var K = 0\n  var flips = 0\n  var last = 0\n  for d in window \{\n    if d.measured \{\n      S = max(S, d.latencyImpact)\n      if abs(d.zs) >= O.deviation.flip_z \{\n        var s = -1\n        if d.zs > 0 \{ s = 1 \}\n        if last != 0 and s != last \{ flips += 1 \}\n        last = s\n      \}\n    \}\n    if d.accelMeasured \{ K = max(K, abs(d.acceleration)) \}\n  \}\n  return \{ S: q4(S), K: q4(K), O: flips \}\n\}\nfn classify(window, O) \{\n  let C = O.sigma\n  var span = [0, 0]\n  if len(window) > 0 \{ span = [window[0].seq, window[len(window) - 1].seq] \}\n  let f = features(window, O)\n  let res = fn(regime, cause, confidence) = \{ regime: regime, dominant_cause: cause, confidence: confidence, features: f, window: span, policy_version: O.version \}\n  if len(window) < C.min_window \{ return res(\"insufficient_data\", null, 0) \}\n  if f.K >= C.accel_threshold \{ return res(\"collapsing\", \"K\", _conf(f.K, C.accel_threshold)) \}\n  if f.O >= C.oscillation_count \{ return res(\"oscillatory\", \"O\", _conf(f.O, C.oscillation_count)) \}\n  if f.S >= C.slope_threshold \{ return res(\"degraded\", \"S\", _conf(f.S, C.slope_threshold)) \}\n  return res(\"stable\", null, 0)\n\}\n/** the regime at the end of the ledger, and a timeline of where it changed (a rolling window, one reading per entry) */\nfn scan(deltas, O) \{\n  let W = O.sigma.window\n  var timeline = []\n  var prev = null\n  var i = 0\n  while i < len(deltas) \{\n    let r = classify(slice(deltas, max(0, i + 1 - W), i + 1), O)\n    if r.regime != prev \{\n      timeline[len(timeline)] = \{ seq: deltas[i].seq, regime: r.regime \}\n      prev = r.regime\n    \}\n    i += 1\n  \}\n  return \{ now: classify(slice(deltas, max(0, len(deltas) - W)), O), timeline: timeline \}\n\}\n/** the entries that deviated most from their own key's rhythm, one per key, strongest first */\nfn deviations(deltas, O, top = 5) \{\n  var best = \{\}\n  var order = []\n  for d in deltas \{\n    if d.measured and d.latencyImpact >= O.deviation.z_flag \{\n      if not has(best, d.key) \{ order[len(order)] = d.key \}\n      if not has(best, d.key) or d.latencyImpact > best[d.key].z \{ best[d.key] = \{ seq: d.seq, key: d.key, z: d.latencyImpact, gap: d.gap \} \}\n    \}\n  \}\n  var list = []\n  for k in order \{ list[len(list)] = best[k] \}\n  let sorted = sort_with(list, fn(a, b) = a.z > b.z or (a.z == b.z and a.seq < b.seq))\n  return slice(sorted, 0, min(top, len(sorted)))\n\}\n\n// ── field: the CFR field, a pure fold over the ledger (observe/field.js) ─────────────────────────────────────\nlet DIMS = [\"coherence\", \"friction\", \"resonance\", \"entropy\"]\nfn regime_of(s, R) \{\n  if s.entropy > R.chaotic_entropy or s.coherence < R.chaotic_coherence \{ return \"chaotic\" \}\n  if s.friction > R.turbulent_friction or s.resonance > R.turbulent_resonance \{ return \"turbulent\" \}\n  if s.coherence > R.resonant_coherence and s.entropy < R.resonant_entropy \{ return \"resonant\" \}\n  return \"stable\"\n\}\nfn fold_field(entries, deltas, O, P) \{\n  let F = O.field\n  var st = \{\}\n  for k in DIMS \{ st[k] = F.start[k] \}\n  var recent = []\n  var out = []\n  var i = 0\n  for e in entries \{\n    for k in DIMS \{ st[k] = st[k] + (F.neutral - st[k]) * F.damping \}\n    if has(F.nudges, e.kind) \{\n      let nudge = F.nudges[e.kind]\n      var scale = 1\n      if F.pressure_scaled contains e.kind \{ scale = pressure_of(e, P) ?? 1 \}\n      for k in DIMS \{\n        if has(nudge, k) and nudge[k] != 0 and nudge[k] != null \{ st[k] = st[k] + nudge[k] * scale \}\n      \}\n    \}\n    if e.kind != \"checkpoint\" \{\n      let key = key_of(e)\n      if (STRESS contains e.kind) and (recent contains key) \{ st.resonance = st.resonance + F.repeat_step \} else \{ st.resonance = st.resonance - F.repeat_relief \}\n      recent[len(recent)] = key\n      if len(recent) > F.repeat_window \{ recent = slice(recent, 1) \}\n    \}\n    let d = deltas[i]\n    if d.measured \{\n      let w = min(1, d.latencyImpact / F.deviation_full_z)\n      st.entropy = st.entropy + w * F.deviation_entropy\n      st.friction = st.friction + w * F.deviation_friction\n    \}\n    for k in DIMS \{ st[k] = clamp01(st[k]) \}\n    out[len(out)] = \{ seq: e.seq, coherence: q4(st.coherence), friction: q4(st.friction), resonance: q4(st.resonance), entropy: q4(st.entropy),\n      regime: regime_of(st, F.regimes) \}\n    i += 1\n  \}\n  return out\n\}\n/** how long the latest regime has held, counted in entries */\nfn hold_of(series) \{\n  if len(series) == 0 \{ return \{ regime: \"stable\", since: 0, entries: 0 \} \}\n  let last = series[len(series) - 1]\n  var i = len(series) - 1\n  while i > 0 and series[i - 1].regime == last.regime \{ i -= 1 \}\n  return \{ regime: last.regime, since: series[i].seq, entries: len(series) - i \}\n\}\n\n// ── liminal: the boundaries, read from the ledger (observe/liminal.js) ───────────────────────────────────────\nfn velocity(entries, O) \{\n  let V = O.liminal.velocity\n  var v = 0\n  var peak = 0\n  var peak_seq = 0\n  var runaway_seq = null\n  for e in entries \{\n    v = max(0, min(1, v * (1 - V.decay) + get(V.step, e.kind, 0)))\n    if v > peak \{\n      peak = v\n      peak_seq = e.seq\n    \}\n    if v >= V.runaway and runaway_seq == null \{ runaway_seq = e.seq \}\n  \}\n  return \{ now: q4(v), peak: q4(peak), peak_seq: peak_seq, runaway_seq: runaway_seq, runaway_now: v >= V.runaway \}\n\}\nfn threshold(entries) \{\n  var bounced = 0\n  var absorbed = 0\n  var dissolved = 0\n  for e in entries \{\n    let b = body_of(e)\n    if e.kind == \"rejected\" or e.kind == \"promotion_refused\" \{ bounced += 1 \}\n    if e.kind == \"rejected\" and type_of(get(b, \"discarded\", null)) == \"list\" \{ dissolved += len(b.discarded) \}\n    if e.kind == \"transition\" and type_of(get(b, \"violations\", null)) == \"list\" and len(b.violations) > 0 \{ absorbed += 1 \}\n  \}\n  return \{ bounced: bounced, absorbed: absorbed, dissolved: dissolved \}\n\}\nfn surface(entries, O) \{\n  let S = O.liminal.surface\n  let tail = slice(entries, max(0, len(entries) - S.window))\n  var last = \{\}\n  var flips = \{\}\n  var order = []\n  for e in tail \{\n    if e.kind == \"transition\" or e.kind == \"rejected\" \{\n      let b = body_of(e)\n      let key = \"\{_str_or(b, \"compartment\", \"\")\}|\{_str_or(b, \"signal\", \"\")\}\"\n      if has(last, key) and last[key] != e.kind \{\n        if not has(flips, key) \{ order[len(order)] = key \}\n        flips[key] = get(flips, key, 0) + 1\n      \}\n      last[key] = e.kind\n    \}\n  \}\n  var out = []\n  for k in order \{\n    if flips[k] >= S.flips \{ out[len(out)] = \{ key: k, flips: flips[k] \} \}\n  \}\n  return sort_with(out, fn(a, b) = a.flips > b.flips or (a.flips == b.flips and a.key < b.key))\n\}\nfn terminus(entries) \{\n  var aborted = 0\n  var unrouted = 0\n  var transitions = 0\n  for e in entries \{\n    if e.kind == \"aborted\" \{ aborted += 1 \} else if e.kind == \"unrouted\" \{ unrouted += 1 \} else if e.kind == \"transition\" \{ transitions += 1 \}\n  \}\n  return \{ aborted: aborted, unrouted: unrouted, unrouted_share: q4(unrouted / max(1, unrouted + transitions)) \}\n\}\nfn crystals(entries, O) \{\n  let C = O.liminal.crystal\n  var refused = \{\}\n  var refused_order = []\n  var accepted = \{\}\n  var unrouted = \{\}\n  var unrouted_order = []\n  for e in entries \{\n    let b = body_of(e)\n    let scope = \"\{_str_or(b, \"compartment\", \"\")\}|\{_str_or(b, \"signal\", \"\")\}\"\n    if e.kind == \"transition\" \{\n      accepted[scope] = get(accepted, scope, 0) + 1\n    \} else if e.kind == \"rejected\" \{\n      let k = \"\{scope\}|\{_str_or(b, \"constraint\", \"\")\}\"\n      if not has(refused, k) \{ refused_order[len(refused_order)] = k \}\n      refused[k] = get(refused, k, 0) + 1\n    \} else if e.kind == \"unrouted\" \{\n      let k = str(_str_or(b, \"signal\", \"\"))\n      if not has(unrouted, k) \{ unrouted_order[len(unrouted_order)] = k \}\n      unrouted[k] = get(unrouted, k, 0) + 1\n    \}\n  \}\n  var out = []\n  for k in refused_order \{\n    let n = refused[k]\n    let parts = split(k, \"|\")\n    let ok = get(accepted, \"\{parts[0]\}|\{parts[1]\}\", 0)\n    let confidence = q4(n / (n + ok))\n    if n >= C.min_count and confidence >= C.min_confidence \{\n      out[len(out)] = \{ kind: \"refusal\", scope: \"\{parts[0]\}.\{parts[1]\}\", constraint: parts[2], count: n, confidence: confidence,\n        suggestion: \"\{parts[2]\} refuses \{parts[1]\} on \{parts[0]\} \{n\} of \{n + ok\} times: the sender or the constraint is wrong\" \}\n    \}\n  \}\n  for sig in unrouted_order \{\n    let n = unrouted[sig]\n    if n >= C.min_count \{\n      out[len(out)] = \{ kind: \"unrouted\", scope: sig, constraint: \"\", count: n, confidence: 1, suggestion: \"nobody handles \{sig\} (\{n\} times): wire it or stop emitting it\" \}\n    \}\n  \}\n  return sort_with(out, fn(a, b) = a.count > b.count or (a.count == b.count and a.scope < b.scope))\n\}\nfn liminal(entries, O) = \{ velocity: velocity(entries, O), threshold: threshold(entries), coherence_surface: surface(entries, O), terminus: terminus(entries),\n  crystals: crystals(entries, O) \}\n\n// ── gaps: the gap hunter, for a ledger (observe/gaps.js) ─────────────────────────────────────────────────────\n/** every gap entry, with the name of its condition, its occurrences, and whether and how it closed */\nfn inventory(entries, O, P) \{\n  let G = O.gaps\n  var closers = \{\}\n  for e in entries \{\n    if e.kind == \"gap.close\" \{\n      let id = get(body_of(e), \"gap\", null)\n      if id != null and not has(closers, str(id)) \{ closers[str(id)] = e.seq \}\n    \}\n  \}\n  var transitions = []\n  for e in entries \{\n    if e.kind == \"transition\" \{ transitions[len(transitions)] = e \}\n  \}\n  var list = []\n  for e in entries \{\n    if e.kind == \"gap\" \{\n      let b = body_of(e)\n      let type = _str_or(b, \"type\", P.gaps.constraint_gap.type)\n      var dedup = get(b, \"dedup_key\", null)\n      if dedup == null \{\n        dedup = dedup_key(\{ type: type, message: _str_or(b, \"message\", \"\"), compartment: _str_or(b, \"compartment\", \"\"), signal: _str_or(b, \"signal\", \"\"),\n          constraint: _str_or(b, \"constraint\", \"\") \}, G.dedup_hex)\n      \}\n      var closed = null\n      if has(b, \"gap\") and has(closers, str(b.gap)) \{\n        closed = \{ by: \"gap.close\", seq: closers[str(b.gap)] \}\n      \} else if has(b, \"compartment\") and has(b, \"missing\") \{\n        for t in transitions \{\n          if closed == null \{\n            let tb = body_of(t)\n            if t.seq > e.seq and get(tb, \"compartment\", null) == b.compartment and type_of(get(tb, \"changes\", null)) == \"map\" and get(tb.changes, b.missing, null) != null \{\n              closed = \{ by: \"predicate\", seq: t.seq \}\n            \}\n          \}\n        \}\n      \}\n      var pressure = P.gaps.constraint_gap.pressure\n      if has(b, \"pressure\") and type_of(b.pressure) == \"num\" \{ pressure = b.pressure \}\n      list[len(list)] = \{ gap: get(b, \"gap\", null), seq: e.seq, type: type, pressure: pressure, dedup_key: dedup, source: _str_or(b, \"source\", \"program\"),\n        closed: closed \}\n    \}\n  \}\n  var seen = \{\}\n  for g in list \{ seen[g.dedup_key] = get(seen, g.dedup_key, 0) + 1 \}\n  var i = 0\n  while i < len(list) \{\n    list[i].occurrences = seen[list[i].dedup_key]\n    i += 1\n  \}\n  return list\n\}\nfn tension(g, head_seq, O) \{\n  let T = O.gaps.tension\n  let age = max(0, head_seq - g.seq)\n  let age_factor = clamp01(log2(1 + age) / log2(1 + T.age_cap))\n  let repeat_factor = clamp01((g.occurrences - 1) / T.repeat_cap)\n  let composite = q4(clamp01(g.pressure * T.weight_pressure + age_factor * T.weight_age + repeat_factor * T.weight_repeat))\n  let escalated = max(g.pressure, composite)\n  var floor_ = \"low\"\n  if composite >= T.critical \{ floor_ = \"critical\" \} else if composite >= T.high \{ floor_ = \"high\" \} else if composite >= T.medium \{ floor_ = \"medium\" \}\n  return \{ gap: g.gap, seq: g.seq, dedup_key: g.dedup_key, pressure: q4(g.pressure), age: age, occurrences: g.occurrences, composite: composite,\n    pressure_after: q4(escalated), severity: floor_, would_block: escalated >= O.gaps.block_at,\n    blocked_by_tension: g.pressure < O.gaps.block_at and composite >= O.gaps.block_at \}\n\}\nfn propose(parts, type, pressure, confidence, message, evidence, O, P) \{\n  if type_of(evidence) != \"map\" or len(keys(evidence)) == 0 \{ raise(\"observe: a gap proposal needs evidence\") \}\n  let p = max(P.gaps.pressure_min, min(P.gaps.pressure_max, pressure))\n  var named = \{ source: \"observe\" \}\n  for k, v in parts \{ named[k] = v \}\n  return \{ type: type, pressure: q4(p), confidence: q4(confidence), message: message, evidence: evidence, dedup_key: dedup_key(named, O.gaps.dedup_hex) \}\n\}\n/** everything the ledger's own measurements say is worth a gap, minus what is already open */\nfn hunt(entries, sigma, field, lim, O, P) \{\n  let G = O.gaps\n  var head_seq = 0\n  if len(entries) > 0 \{ head_seq = entries[len(entries) - 1].seq \}\n  let inv = inventory(entries, O, P)\n  var open = []\n  var closed = []\n  for g in inv \{\n    if g.closed == null \{ open[len(open)] = g \} else \{ closed[len(closed)] = g \}\n  \}\n  var escalations = []\n  for g in open \{ escalations[len(escalations)] = tension(g, head_seq, O) \}\n\n  var cand = []\n  let s = sigma.now\n  if get(G.regime_types, s.regime, null) != null \{\n    let f = s.features\n    cand[len(cand)] = propose(\{ pattern: \"sigma\", regime: s.regime, cause: s.dominant_cause \}, G.regime_types[s.regime], G.regime_pressure[s.regime] * s.confidence,\n      s.confidence, \"sigma: \{s.regime\} (\{s.dominant_cause\}) over ticks \{s.window[0]\} to \{s.window[1]\}: S \{f.S\}, K \{f.K\}, O \{f.O\}\",\n      \{ pattern: \"sigma\", regime: s.regime, cause: s.dominant_cause, S: f.S, K: f.K, O: f.O, from: s.window[0], to: s.window[1] \}, O, P)\n  \}\n  let h = field.hold\n  let cur = field.now\n  if get(G.field_types, h.regime, null) != null and h.entries >= G.field_persist \{\n    cand[len(cand)] = propose(\{ pattern: \"field\", regime: h.regime \}, G.field_types[h.regime], G.field_pressure[h.regime], min(1, h.entries / (G.field_persist * 2)),\n      \"field: \{h.regime\} for \{h.entries\} entries since tick \{h.since\} (coherence \{cur.coherence\}, friction \{cur.friction\}, entropy \{cur.entropy\})\",\n      \{ pattern: \"field\", regime: h.regime, since: h.since, entries: h.entries, coherence: cur.coherence, friction: cur.friction, resonance: cur.resonance,\n        entropy: cur.entropy \}, O, P)\n  \}\n  let v = lim.velocity\n  if v.runaway_now \{\n    cand[len(cand)] = propose(\{ pattern: \"velocity_field\" \}, O.liminal.velocity.gap_type, O.liminal.velocity.gap_pressure, v.now,\n      \"velocity field ran away (\{v.now\}) since tick \{v.runaway_seq\}: stress is arriving faster than the program integrates it, ahead of any signal storm\",\n      \{ pattern: \"velocity_field\", velocity: v.now, peak: v.peak, since: v.runaway_seq \}, O, P)\n  \}\n  for c in lim.crystals \{\n    cand[len(cand)] = propose(\{ pattern: \"crystal\", kind: c.kind, scope: c.scope, constraint: c.constraint \}, G.crystal_types[c.kind], G.crystal_pressure[c.kind] * c.confidence,\n      c.confidence, \"crystal: \{c.suggestion\}\", \{ pattern: \"crystal\", kind: c.kind, scope: c.scope, constraint: c.constraint, count: c.count, confidence: c.confidence \}, O, P)\n  \}\n\n  var open_keys = []\n  for g in open \{ open_keys[len(open_keys)] = g.dedup_key \}\n  var fresh = []\n  for c in cand \{\n    if not (open_keys contains c.dedup_key) \{ fresh[len(fresh)] = c \}\n  \}\n  let proposals = sort_with(fresh, fn(a, b) = a.pressure > b.pressure or (a.pressure == b.pressure and a.dedup_key < b.dedup_key))\n  var confidence = null\n  for p in proposals \{\n    if confidence == null or p.confidence < confidence \{ confidence = p.confidence \}\n  \}\n  return \{ open: open, closed: closed, escalations: escalations, proposals: proposals, confidence: confidence \}\n\}\n\n// ── observe: the report (observe/index.js) ────────────────────────────────────────────────────────────────\nfn observe(entries, P) \{\n  let O = P.observe\n  let v = L.verify(entries)\n  if not v.ok \{ return \{ ok: false, verify: v \} \}\n  var seen = []\n  for e in entries \{\n    if not is_derived(e, P) \{ seen[len(seen)] = e \}\n  \}\n  let deltas = compute_deltas(seen, O)\n  let sig = scan(deltas, O)\n  let series = fold_field(seen, deltas, O, P)\n  var counts = \{ stable: 0, resonant: 0, turbulent: 0, chaotic: 0 \}\n  for r in series \{ counts[r.regime] = counts[r.regime] + 1 \}\n  var now = null\n  if len(series) > 0 \{ now = series[len(series) - 1] \}\n  let field = \{ now: now, hold: hold_of(series), counts: counts \}\n  let lim = liminal(seen, O)\n  let gaps = hunt(entries, sig, field, lim, O, P)\n  var head = \{ seq: 0, hash: L.ZERO \}\n  if len(entries) > 0 \{ head = \{ seq: entries[len(entries) - 1].seq, hash: entries[len(entries) - 1].hash \} \}\n  var sigma = \{\}\n  for k, x in sig.now \{ sigma[k] = x \}\n  sigma.timeline = slice(sig.timeline, max(0, len(sig.timeline) - 8))\n  return \{ ok: true, version: O.version, head: head, entries: len(entries), measured: len(seen), field: field, sigma: sigma,\n    deviations: deviations(deltas, O), liminal: lim, gaps: gaps, series: series \}\n\}\n\n// ── the observe() builtin, natively (lower.eg rewrites observe() to this): the report without its series, as data, frozen; a run under a\n// contract measures against its gate's block_at, as lang/runtime.js does; a ledger that does not verify is refused, not measured\nfn report(entries, P, block_at) \{\n  var PP = P\n  if block_at != null \{\n    var gaps = \{\}\n    for k, v in P.observe.gaps \{ gaps[k] = v \}\n    gaps.block_at = block_at\n    var O = \{\}\n    for k, v in P.observe \{ O[k] = v \}\n    O.gaps = gaps\n    PP = \{ observe: O, gaps: P.gaps, signals: P.signals \}\n  \}\n  let r = observe(entries, PP)\n  if not r.ok \{ raise(\"observe: the ledger does not verify (entry \{r.verify.seq\}: \{r.verify.reason\})\") \}\n  var out = \{\}\n  for k, v in r \{\n    if k != \"series\" \{ out[k] = v \}\n  \}\n  return freeze(out)\n\}\n"
