// cockpit-core.eg — SISOKernel + JAA IndexedDB/JSONL + Bayesian Trust
// UUID: cockpit-core-v1-0-0 | source: forge-core.js
compartment "cockpit-core" {
  id = cockpit-core-001
  uuid = cockpit-core-001-xxxx
  version = 1.0.0
  intent = siso_kernel_jaa_browser_or_node_bayesian_trust_zero_deps
  siso_kernel {
    gates     = Map signature -> SISOGate
    listeners = Map type -> Set<fn>
    history   = Ring(500)
    tick      = monotonic
    dispatch  = depth_first
  }
  jaa_tables {
    ideas pipelines pipeline_runs pipeline_steps conditions schedules
    workflow_runs api_configs webhooks variables trust_scores snr_records
    event_log artifacts memory_index tension_records ci_runs snr_samples
    forge_sessions seam_chunks seam_programs gaps snapshots links specs
  }
  bayesian_trust {
    prior          = Beta(1 1)
    pass_update    = alpha += 1
    fail_update    = beta += 1
    score          = alpha / (alpha + beta)
    wilson_lower   = routing_weight
    decay_halflife = 7_days
    cold_start     = 0.2
    confidence_min = 5
  }
}
