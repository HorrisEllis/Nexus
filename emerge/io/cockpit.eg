// cockpit.eg — Guardian control panel + Emerge IDE. Served from 7820/cockpit.
// UUID: cockpit-v1-0-0
// Source: cockpit/core.js + cockpit/cli.js + cockpit/pipeline.js + cockpit/forge.js
// UI: ui/cockpit.html

compartment "cockpit" {
  id      = cockpit-001
  uuid    = cockpit-001-xxxx
  version = 10.0.0
  intent  = guardian_control_panel_and_emerge_ide

  serves_from = 7820/cockpit
  connects_to = 3748

  panels {
    SEAM_Chunker  = { parse_spec → chunks → inject_via_guardian }
    Pipeline      = { 15_node_types visual_builder run_log }
    Compiler      = { emerge_editor SNR_output gap_list axioms }
    Automation    = { schedules workflows triggers }
    Brain         = { jaa_stats cortex_memory crystal_viewer gap_hunter }
  }

  chatgpt_panel {
    intent  = chatgpt_is_source_of_truth_for_generation
    route   = POST 7820/command { provider = chatgpt }
    stream  = GET  7820/stream/:jobId
    status  = GET  7820/providers
  }

  siso_kernel {
    gates    = Map signature → fn
    history  = Ring 500
    dispatch = depth_first
  }

  bayesian_trust {
    prior         = Beta(1 1)
    decay_halflife = 7_days
    cold_start    = 0.2
    routing       = wilson_lower_bound
  }

  pipeline {
    node_types = [ trigger condition transform api_call agent_call store emit loop delay seam_compile gap notify merge fork webhook_out ]
    evaluator  = safe_no_eval max_expr=2048
  }

  cli_contract {
    hotswap = true
    every_panel_has_cli_command = true
  }
}
