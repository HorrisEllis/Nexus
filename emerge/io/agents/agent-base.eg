// agent-base.eg — GuardianModule base class
// UUID: agent-base-v1-0-0 | source: Nexus-Core agents/base.js
compartment "agent-base" {
  id = agent-base-001
  uuid = agent-base-001-xxxx
  intent = base_agent_interface_complete_handle_ping
  component "interface" {
    on handle  { input call abstract record }
    on ping    { output { ok = true name = agent_name ts = now } record }
    on complete { input call response update jaa.agent_calls set status = complete response = response record }
    on fail    { input call error update jaa.agent_calls set status = failed error = error insert jaa.failures record }
  }
}
