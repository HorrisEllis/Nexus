// cortex.eg — Source of truth. Port 3748. Boot order: JAA → Cobalt → Modules → Admin.
// UUID: cortex-v1-0-0
// node cortex/boot.js

compartment "cortex" {
  id      = cortex-001
  uuid    = cortex-001-xxxx
  version = 5.0.0
  port    = 3748
  intent  = source_of_truth_all_memory_never_deletes

  boot_order {
    1 = jaa_open          { dir = ./data }
    2 = fileStore_open    { dir = ./store }
    3 = cobalt_open       { manifest = cobalt.manifest.json }
    4 = setDeps           { versionium fileStore fileRefs }
    5 = pollRegistry_start
    6 = adminServer_start { port = 3748 }
    7 = jaa_insert        { type = system.booted }
    if any_step_fails { HALT loud }
  }

  jaa_tables = [
    event_log bridge_messages agent_calls agent_signatures
    artifacts gaps failures fix_map memory_index memory_queries
    conditioning_log feedback_scores crystals bep_patterns active_traces
    orion_sessions versionium_commits versionium_branches versionium_file_index
    versionium_calendar versionium_objects schedules workflow_runs
    project_registry shape_samples poll_log requests cortex_memory
  ]

  api {
    route GET  /health             { output status + jaa.counts + uptime record }
    route GET  /api/events         { output jaa.event_log.tail(n) record }
    route GET  /api/gaps           { output jaa.gaps record }
    route GET  /api/memory         { output jaa[table].tail(n) record }
    route POST /api/memory/search  { input q output cortex_memory.search(q) record }
    route POST /api/event          { input type payload insert emit_cobalt record }
    route GET  /api/files          { output fileStore.list record }
    route POST /api/files          { input file store → sha256 record }
    route GET  /sse                { output cobalt_bus.ring live_tail record }
    route POST /guardian/event     { input type payload insert bridge_messages emit record }
  }
}
