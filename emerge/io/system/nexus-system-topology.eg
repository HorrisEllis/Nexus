// nexus-system-topology.eg — all-layers topology + port map
// UUID: nexus-system-topology-v1-0-0
compartment "nexus-system-topology" {
  id = nexus-system-topology-001
  uuid = nexus-system-topology-001-xxxx
  intent = authoritative_port_map_and_layer_topology
  ports {
    3748  = { service = nexus_cortex      bind = 127.0.0.1 protocol = http_sse }
    4800  = { service = forge_idearium    bind = 127.0.0.1 protocol = http_sse }
    7800  = { service = rheon_ide         bind = 127.0.0.1 protocol = http_ws }
    7771  = { service = tauri_ws_bridge   bind = 127.0.0.1 protocol = ws }
    7820  = { service = guardian_http_api bind = 127.0.0.1 protocol = http_sse }
    7821  = { service = guardian_wss      bind = 127.0.0.1 protocol = wss }
    7822  = { service = dropzone          bind = 0.0.0.0   protocol = http }
    7823  = { service = memory_server     bind = 0.0.0.0   protocol = http_sse }
    11434 = { service = ollama            bind = localhost  protocol = http }
  }
  layers {
    L0 = cortex_3748       { jaa cobalt_bus raid orion versionium gap_finder healer }
    L1 = guardian_7820_7821 { http_api wss_provider dropzone memory_server }
    L2 = forge_4800        { ide pipeline spec_parser idearium }
    L3 = browser_extension { app cfr ir_layer handshake content modules }
    L4 = userscript        { toast gates tab_claim dom_scanner queue snr_detector seam pa gap_hunter }
    L5 = cli               { nexus_cli guardian_cli forge_cli cortex_cli }
  }
  invariant {
    axiom NO_SILENT_DROP
    axiom ALL_LAYERS_SYNC_TO_CORTEX
    axiom CLI_FIRST_UI_IS_PROJECTION
  }
}
