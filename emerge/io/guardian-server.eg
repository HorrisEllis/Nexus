// guardian-server.eg — Guardian HTTP+WSS server v9
// UUID: guardian-server-v1-0-0 | source: guardian-final/server-v9.js
compartment "guardian-server" {
  id = guardian-server-001
  uuid = guardian-server-001-xxxx
  version = 9.0.0
  intent = all_ports_all_routes_all_siso_channels_3748_bridge
  ports {
    7820 = { bind = 127.0.0.1 protocol = http  purpose = main_api_cli_cockpit }
    7821 = { bind = 127.0.0.1 protocol = wss   purpose = provider_connections }
    7822 = { bind = 0.0.0.0   protocol = http  purpose = dropzone_lan }
    7823 = { bind = 0.0.0.0   protocol = http  purpose = memory_jaa_lan }
    3748 = { bind = 127.0.0.1 protocol = http  purpose = cobalt_bridge_proxy }
  }
  isolation {
    G-I1 = cockpit_no_direct_jaa_access
    G-I2 = cli_no_knowledge_of_cockpit
    G-I3 = providers_cannot_call_http_routes
    G-I4 = providers_cannot_read_other_providers_jobs
    G-I5 = 7823_and_7820_share_same_jaastore_single_write
    G-I6 = nexus_3748_writes_fire_and_forget
    G-I7 = dropzone_7822_independently_startable
  }
  siso_channels {
    guardian.artifact  = GUARDIAN_ARTIFACT -> jaa.artifacts + dropzone + ledger
    guardian.gap       = GUARDIAN_GAPS -> jaa.gaps + ledger
    guardian.job       = GUARDIAN_COMPLETE -> jobs PA ledger
    guardian.pa        = GUARDIAN_PA_SESSION -> jaa.pa_sessions
    guardian.ledger    = GUARDIAN_LEDGER_EVENT -> jaa.ledger_entries
    guardian.file      = GUARDIAN_FILE_UPLOAD -> dropzone
    guardian.download  = GUARDIAN_DOWNLOAD -> jaa.downloads
    guardian.session   = sessions.name -> UPDATE
    guardian.setting   = settings.key -> UPDATE + broadcast
    guardian.timeline  = any_event -> timeline_events
    guardian.input     = GUARDIAN_INPUT -> ledger + cortex + ACK + channel_open
  }
}
