// idearium-gate.eg — Idearium gate primitive
// UUID: idearium-gate-v1-0-0 | source: idearium/Gate.js
compartment "idearium-gate" {
  id = idearium-gate-001
  uuid = idearium-gate-001-xxxx
  intent = named_event_transformer_for_idearium_bus
  component "gate" {
    fields { signature matchFn transformFn }
    on matches   { input event output bool record }
    on transform { input event bus if matches(event) { transformFn(event bus) } record }
  }
}
