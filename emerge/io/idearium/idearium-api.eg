// idearium-api.eg — Idearium REST API
// UUID: idearium-api-v1-0-0 | source: idearium/api/index.js
compartment "idearium-api" {
  id = idearium-api-001
  uuid = idearium-api-001-xxxx
  component "routes" {
    route GET    /api/ideas               { query output json record }
    route POST   /api/ideas               { insert emit "idea.created" record }
    route GET    /api/ideas/:uuid         { get output json record }
    route PATCH  /api/ideas/:uuid         { update record }
    route POST   /api/ideas/:uuid/tension { compute output json record }
    route POST   /api/ideas/:uuid/link    { insert jaa.idea_links record }
    route POST   /api/ideas/:uuid/spec    { insert jaa.specs record }
    route POST   /api/ideas/:uuid/phase   { update record }
    route DELETE /api/ideas/:uuid         { archive record }
    route GET    /api/specs               { query output json record }
    route GET    /api/specs/:uuid         { get output json record }
    route POST   /api/specs/:uuid/check   { validate record }
    route POST   /api/specs/:uuid/build   { build emit "spec.built" record }
    route GET    /api/gaps                { query output json record }
    route POST   /api/gaps                { insert record }
    route POST   /api/gaps/:uuid/resolve  { update record }
    route GET    /api/snr                 { compute output json record }
    route GET    /api/stats               { output counts record }
    route GET    /api/contract            { output interaction_contract record }
    route GET    /sse                     { output sse stream live_tail record }
    route POST   /api/queue/:id/progress  { update queue_progress record }
    route POST   /api/guardian/event      { insert jaa.event_log record }
    record
  }
}
