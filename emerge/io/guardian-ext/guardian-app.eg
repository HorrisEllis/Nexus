// guardian-app.eg — Master orchestrator, owns BUS, wires all modules
// UUID: guardian-app-v1-0-0 | source: Guardian-v5/app.js
compartment "guardian-app" {
  id = guardian-app-001
  uuid = guardian-app-001-xxxx
  intent = master_orchestrator_no_module_to_module_imports_bus_only
  state {
    sessions      = Map tabId -> { sessionId url ts }
    listeners     = Map listenerId -> { tabId selector mode active }
    responseStore = Map identity -> { text complete ts calltoId }
    channel       = BroadcastChannel guardian-bridge
    nexusChannel  = BroadcastChannel nexus-core
    bridgeUrl     = http://127.0.0.1:3748
  }
  component "boot" {
    on load
      loadConfig()
      bridgeFetch("/guardian/handshake" POST { instanceId = MY_INSTANCE_ID version = 5.0.0 })
      start_pulse_loop()
      attach_site_modules()
      record
  }
  component "pulse" {
    interval = 8000
    bridgeFetch("/pulse" POST { instanceId = MY_INSTANCE_ID ts = now })
    record
  }
  component "callto" {
    on callto { input callto ir = _getIR() ir.dispatch(callto) record }
  }
  component "capture" {
    on response { input tabId text complete responseStore.set(identity(tabId) { text complete ts = now }) emit "guardian.response.captured" record }
  }
  component "nexus-pulse-relay" {
    nexusChannel.onmessage { type = nexus:pulse relay to popup via channel record }
  }
}
