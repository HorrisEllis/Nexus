// module-threads.eg — Threads site module
// UUID: module-threads-v1-0-0 | source: modules/threads.js
compartment "module-threads" {
  id = module-threads-001
  uuid = module-threads-001-xxxx
  intent = capture_threads_post_and_reply_content
  targets = [ threads.net ]
  selectors {
    post  = [data-pressable-container]
    reply = [class*=reply]
    input = [contenteditable=true]
  }
  component "observer" {
    dom_watch document.body
    on mutation { capture_visible_content emit "guardian.threads.content" record }
  }
}
