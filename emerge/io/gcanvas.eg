// gcanvas.eg — ALK particle field. WebGL2 → Canvas2D fallback. Same API.
// UUID: gcanvas-v1-0-0
// Source: gcanvas/alk-gl.js + cfr-mesh-bridge.js + cfr-physics.js + alk-kernel.js

compartment "gcanvas" {
  id      = gcanvas-001
  uuid    = gcanvas-001-xxxx
  version = 1.9.0
  intent  = alk_particle_field_webgl2_or_canvas2d_same_api

  tier_select {
    if webgl2 + EXT_color_buffer_float { use ALKGL N=80000 }
    else { use CFRMeshBridge N=18000 emit toast.warn }
  }

  alk_bus { intent = all_modules_via_bus_only K6 = no_direct_calls }

  field_defaults { entropy = 0.18 structure = 0.85 curl = 0.50 }

  api {
    upsertAttractor = id x y z mass
    removeAttractor = id
    injectStress    = x y z strength radius
    setField        = delta
    step            = dt
    render          = W H
    health          = status
  }

  cue_deltas {
    blink          = { entropy +0.15 decayFrames 3 }
    gaze_aversion  = { entropy +0.20 irisGain 0.40 }
    smile_duchenne = { curl +0.20 entropy -0.08 }
    ESCALATION     = { entropy +0.30 stressAtMouth }
  }

  on alk.video.landmarks.face  { sync_face_attractors_20pts record }
  on alk.video.landmarks.pose  { sync_pose_attractors_7pts  record }
  on alk.behavior.cue.detected { apply_cue_delta decay_per_frame record }
}
