// seam-verdict-detector.eg — PASS/FAIL verdict extractor
// UUID: seam-verdict-detector-v1-0-0
compartment "seam-verdict-detector" {
  id = seam-verdict-detector-001
  uuid = seam-verdict-detector-001-xxxx
  intent = extract_seam_verdict_from_response_text_pass_fail_null
  component "detector" {
    on detect {
      input text
      if text matches /SEAM VERDICT: PASS/i { output pass record }
      if text matches /SEAM VERDICT: FAIL/i { output fail record }
      output null
      record
    }
  }
  system_prompts {
    nexus = "You are building the NEXUS system. When implementation complete: SEAM VERDICT: PASS | FAIL"
    seam  = "You are a SEAM verifier. Report each test PASS/FAIL then: SEAM VERDICT: PASS or SEAM VERDICT: FAIL — <reason>"
    none  = ""
  }
}
