// mql.eg — Memory Query Layer: 5-lane parallel retrieval
// UUID: mql-v1-0-0 | source: crystalball/mql.js
// Lanes: A=lexical B=causal C=failure D=bep E=recency
// Budget: 48000 chars. Source weights. Lane weights.
compartment "mql" {
  id = mql-001
  uuid = mql-001-xxxx
  intent = five_lane_parallel_retrieval_scored_compressed_48k_budget
  source_weights {
    failures    = 1.50
    fix_map     = 1.40
    bep_patterns = 1.35
    agent_calls = 1.20
    crystals    = 1.30
    gaps        = 1.15
    event_log   = 0.80
  }
  lane_weights { A = 0.70 B = 1.00 C = 0.95 D = 0.90 E = 0.85 }
  token_budget_chars = 48000
  component "recall" {
    input prompt calltoId
    lane_A = lexical_search(jaa.memory_index prompt)
    lane_B = causal_ancestors(calltoId depth = 3)
    lane_C = recent_failures_and_fixes(limit = 10)
    lane_D = bep_engine.match(prompt)
    lane_E = jaa.event_log.tail(20) + jaa.agent_calls.tail(5)
    scored = score_and_merge(lane_A lane_B lane_C lane_D lane_E source_weights lane_weights)
    compressed = compress_to_budget(scored token_budget_chars)
    trace = record_recall_trace(calltoId compressed)
    output compressed
    record
  }
}
