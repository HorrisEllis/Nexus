// healer.eg — gap → fix_map resolution
// UUID: healer-v1-0-0 | source: healer/index.js
compartment "healer" {
  id = healer-001
  uuid = healer-001-xxxx
  intent = claim_gaps_prescribe_fix_map_resolve_or_flag_manual
  reads  = [ gaps ]
  writes = [ fix_map gaps event_log failures ]
  prescriptions {
    stale_module      = { strategy = restart action = emit_restart automated = true }
    stuck_call        = { strategy = cancel_retry action = requeue automated = true }
    recurring_failure = { strategy = condition_agent action = inject_fix_context automated = true }
    schema_violation  = { strategy = log_and_surface action = surface_gap automated = false }
    law_violation     = { strategy = log_and_surface action = surface_gap automated = false }
    default           = { strategy = log_and_surface action = surface_gap automated = false }
  }
  component "processor" {
    interval = 5000
    query jaa.gaps where status == pending limit 10
    for each gap in pending
      update jaa.gaps set status = processing claimedBy = healer
      if get again and claimedBy != healer { skip }
      fix = prescriptions[gap.type] or prescriptions.default
      insert jaa.fix_map { uuid = uid gapUuid = gap.uuid gapType = gap.type strategy = fix.strategy action = fix.action automated = fix.automated status = applied causedBy = gap.uuid ts = now }
      update jaa.gaps set status = fix.automated ? resolved : needs_manual resolvedAt = now
      emit "gap.resolved" { uuid = gap.uuid type = gap.type strategy = fix.strategy }
      record
  }
}
