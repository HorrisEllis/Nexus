// gate-runner.eg — test suite executor per manifest node
// UUID: gate-runner-v1-0-0 | source: gate/runner.js
compartment "gate-runner" {
  id = gate-runner-001
  uuid = gate-runner-001-xxxx
  intent = law_iv_schema_derived_tests_for_manifest_nodes
  reads  = [ agent_calls project_registry ]
  writes = [ event_log failures ]
  component "test-generator" {
    input node manifest
    prompt = build_test_prompt(node manifest)
    route = raid.decide({ type = test_gen tokens = 1200 })
    result = agent.complete(route prompt temperature = 0.1)
    tests = parse_tests(result node.id)
    emit "gate.tests.generated" { nodeId = node.id count = tests.length }
    output tests
    record
  }
  component "executor" {
    input tests node
    for each test in tests
      result = run_test(test node)
      if result.fail
        insert jaa.failures { source = gate-runner error = test.description stack = result.error }
        emit "gate.test.failed" { nodeId = node.id test = test.description }
        record
      else
        emit "gate.test.passed" { nodeId = node.id test = test.description }
        record
  }
}
