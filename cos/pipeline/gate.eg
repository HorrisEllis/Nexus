// cos/pipeline/gate.eg — a gate decides (MOD-PC-GATE-TYPES, phase PC5_programmable_gate_types; cos/spec/pipeline-canvas.spec).
// James, 2026-11-08: "Gates need to be programmable." · "need to show the programmable gates in between as a compartment themselves" · 2026-11-09:
// "Gates can hold context, test, verify, gates would do a lot. But not the same everytime." · "Can use the gates to build one step at a time,
// discover gaps."
// A GateType (a .gate file, COS's) says what decides (checks), what COS asks before deciding (asks: routes, each on its owner), what the gate holds
// across runs (its context), and what happens on each outcome (on: open | closed | gap). The same type decides differently as its context grows:
// a reason that closes it again and again becomes a gap (gapAfter), a check can ask that the output changed since last time, and a check marked
// gap names a missing capability at once. Pure: COS's door (cos/pipeline/gates.js) makes the calls and keeps the context; this decides.
// Reached only through its in hooks (CIE-EG §5.2); every answer leaves by the one out hook, answer.

let CHECKS = ["holds", "answer", "changed", "always"]
let ACTIONS = ["note", "route", "retry", "stop", "skip", "hold", "branch", "notify"]
let OUTCOMES = ["open", "closed", "gap"]

// {{with.x}} (the task's settings for its gate) and {{output}}, {{why}}, {{pipeline}}, {{task}} in any string of v are filled; a string still
// naming something unset is null, so a check key left unset is no check at all
fn fill_text(s: string, w: map, top: map): any {
  var out = s
  for k in keys(w) { out = replace(out, "\{\{with." + k + "\}\}", str(w[k])) }
  for k in keys(top) { if top[k] != null { out = replace(out, "\{\{" + k + "\}\}", str(top[k])) } }
  if find_text(out, "\{\{") >= 0 { return null }
  return out
}
fn fill(v: any, w: map, top: map): any {
  let t = type_of(v)
  if t == "string" { return fill_text(v, w, top) }
  if t == "list" { return map(v, fn(x) = fill(x, w, top)) }
  if t == "map" {
    var o = {}
    for k in keys(v) { o[k] = fill(v[k], w, top) }
    return o
  }
  return v
}

fn preview(s: string): string {
  if len(s) > 400 { return slice(s, 0, 400) + "…" }
  return s
}
fn head_is(s: string, p: string): bool = len(s) >= len(p) and slice(s, 0, len(p)) == p

// one check → null when it holds, else why
fn holds_why(c: map, out: string): any {
  if get(c, "notEmpty", false) and len(trim(out)) == 0 { return "the output is empty" }
  if get(c, "contains", null) != null and find_text(out, str(c.contains)) < 0 { return "the output does not contain \"" + str(c.contains) + "\"" }
  if get(c, "lacks", null) != null and find_text(out, str(c.lacks)) >= 0 { return "the output contains \"" + str(c.lacks) + "\"" }
  if get(c, "equals", null) != null and trim(out) != trim(str(c.equals)) { return "the output is \"" + preview(out) + "\", not \"" + str(c.equals) + "\"" }
  if get(c, "startsWith", null) != null and not head_is(trim(out), str(c.startsWith)) { return "the output does not start with \"" + str(c.startsWith) + "\"" }
  if get(c, "longerThan", null) != null and len(out) <= c.longerThan { return "the output is " + str(len(out)) + " characters, not more than " + str(c.longerThan) }
  return null
}
fn answer_why(c: map, answers: map): any {
  let id = get(c, "ask", "")
  if not has(answers, id) { return "asked \"" + id + "\": not asked" }
  let a = answers[id]
  if get(a, "error", null) != null { return "asked \"" + id + "\": " + str(a.error) }
  if a.status >= 400 { return "asked \"" + id + "\": its owner answered " + str(a.status) }
  if get(c, "contains", null) != null and find_text(str(get(a, "body", "")), str(c.contains)) < 0 { return "asked \"" + id + "\": the answer does not contain \"" + str(c.contains) + "\"" }
  return null
}
fn check_why(c: map, out: string, ctx: map, answers: map): any {
  if c.kind == "holds" { return holds_why(c, out) }
  if c.kind == "answer" { return answer_why(c, answers) }
  if c.kind == "changed" {
    if get(ctx, "last", null) != null and ctx.last == preview(out) { return "the output is the same as last time" }
    return null
  }
  return null
}

// decide → { outcome, why, saw, actions, context }. checks all hold → open; one fails → closed, or gap when the check is marked gap, or when
// the same reason closed it gapAfter times in a row (it is not a flake: something is missing).
fn decide(q: map): map {
  let w = get(q, "with", {})
  let out = str(get(q, "output", ""))
  let top = { output: preview(out), pipeline: get(q, "pipeline", null), task: get(q, "task", null), why: null }
  let ty = fill(q.type, w, top)
  let ctx = get(q, "context", {})
  let answers = get(q, "answers", {})
  var outcome = "open"
  var why = null
  var saw = []
  for c in get(ty, "checks", []) {
    let r = check_why(c, out, ctx, answers)
    if r == null { saw = push(saw, c.kind + ": holds") } else {
      saw = push(saw, c.kind + ": " + r)
      if why == null {
        why = r
        outcome = "closed"
        if get(c, "gap", false) { outcome = "gap" }
      }
    }
  }
  var streak = 0
  if outcome != "open" and get(ctx, "lastWhy", null) == why { streak = get(ctx, "streak", 0) + 1 } else if outcome != "open" { streak = 1 }
  let gap_after = get(ty, "gapAfter", 0)
  if outcome == "closed" and gap_after > 0 and streak >= gap_after {
    outcome = "gap"
    if streak > 1 { why = why + " (" + str(streak) + " times in a row: a gap, not a flake)" }
  }
  var hist = push(get(ctx, "history", []), { outcome: outcome, why: why })
  if len(hist) > 10 { hist = drop(hist, len(hist) - 10) }
  var held = get(ctx, "held", [])
  if get(ty, "hold", 0) > 0 {
    held = push(held, preview(out))
    if len(held) > ty.hold { held = drop(held, len(held) - ty.hold) }
  }
  let next = { runs: get(ctx, "runs", 0) + 1, last: preview(out), lastOutcome: outcome, lastWhy: why, streak: streak, history: hist, held: held }
  // the actions, filled again now that the why is known (an action can carry it: the gap handed to Emerge says what closed)
  var acts = []
  let raw = get(q.type, "on", {})
  if has(raw, outcome) { acts = fill(raw[outcome], w, { output: top.output, pipeline: top.pipeline, task: top.task, why: why }) }
  return { outcome: outcome, why: why, saw: saw, actions: acts, context: next, options: get(ty, "options", []) }
}

// plan → the asks COS makes before deciding, filled: [{ id, owner, route, body }]; an ask naming something unset is said, not made
fn plan(q: map): map {
  let w = get(q, "with", {})
  let top = { output: preview(str(get(q, "output", ""))), pipeline: get(q, "pipeline", null), task: get(q, "task", null), why: null }
  var asks = []
  var unset = []
  for a in get(q.type, "asks", []) {
    let f = fill(a, w, top)
    if f.owner == null or f.route == null { unset = push(unset, "ask " + a.id + ": its owner or route names a setting this task does not give") } else { asks = push(asks, f) }
  }
  return { asks: asks, unset: unset }
}

fn route_ok(r: string): bool {
  let parts = split(r, " ")
  return len(parts) == 2 and index_of(["GET", "POST", "PUT", "PATCH", "DELETE"], parts[0]) >= 0 and head_is(parts[1], "/")
}

// a GateType → the faults, each named; none → valid
fn problems(ty: map): list {
  var ps = []
  if type_of(get(ty, "id", null)) != "string" or len(ty.id) == 0 { ps = push(ps, "a gate type needs an id") }
  if type_of(get(ty, "checks", null)) != "list" { ps = push(ps, "checks is a list (it can be empty: always open)") } else {
    for c in ty.checks {
      if index_of(CHECKS, get(c, "kind", "")) < 0 { ps = push(ps, "check kind \"" + str(get(c, "kind", "")) + "\" is not one of " + join(CHECKS, ", ")) }
      if get(c, "kind", "") == "answer" and not any(get(ty, "asks", []), fn(a) = a.id == get(c, "ask", "")) { ps = push(ps, "check answer names ask \"" + str(get(c, "ask", "")) + "\", which the type does not ask") }
    }
  }
  for a in get(ty, "asks", []) {
    if type_of(get(a, "id", null)) != "string" { ps = push(ps, "every ask has an id") }
    if not route_ok(get(a, "route", "")) and find_text(get(a, "route", ""), "\{\{with.") < 0 { ps = push(ps, "ask " + str(get(a, "id", "?")) + ": route is \"<METHOD> /path\", not \"" + str(get(a, "route", "")) + "\"") }
    if type_of(get(a, "owner", null)) != "string" { ps = push(ps, "ask " + str(get(a, "id", "?")) + ": name the system that serves it (owner)") }
  }
  if has(ty, "on") {
    for k in keys(ty.on) {
      if index_of(OUTCOMES, k) < 0 { ps = push(ps, "on." + k + " is not an outcome (" + join(OUTCOMES, ", ") + ")") }
      for x in ty.on[k] {
        if index_of(ACTIONS, get(x, "do", "")) < 0 { ps = push(ps, "on." + k + ": \"" + str(get(x, "do", "")) + "\" is not an action (" + join(ACTIONS, ", ") + ")") }
        if get(x, "do", "") == "route" and type_of(get(x, "owner", null)) != "string" { ps = push(ps, "on." + k + ": a route action names its owner") }
      }
    }
  }
  return ps
}

// what the actions mean for the run (the door only makes the route calls): retry it, stop it, hold it for him, or go on past it
fn flags(outcome: string, acts: list): map {
  let does = map(acts, fn(a) = get(a, "do", ""))
  let past = index_of(does, "skip") >= 0
  return { open: outcome == "open" or past, retry: index_of(does, "retry") >= 0, stop: index_of(does, "stop") >= 0, held: index_of(does, "hold") >= 0, skip: past,
    calls: filter(acts, fn(a) = get(a, "do", "") == "route"),
    unbuilt: map(filter(acts, fn(a) = get(a, "do", "") == "branch" or get(a, "do", "") == "notify"), fn(a) = a.do + " is not built yet (PC5b)") }
}

// ── the type files: shipped (cos/pipeline/types/*.gatetype) and his own (COS's data) ──
fn types_in(dir: string, by: string): list {
  var out = []
  for f in list_dir(dir) {
    if len(f) > 9 and slice(f, len(f) - 9, len(f)) == ".gatetype" {
      var t = parse_json(read_file(dir + "/" + f))
      t.madeBy = get(t, "madeBy", by)
      t.file = dir + "/" + f
      out = push(out, t)
    }
  }
  return out
}
fn all_types(shipped: string, mine: string): list {
  let own = types_in(mine, "person")
  let base_types = filter(types_in(shipped, "shipped"), fn(t) = not any(own, fn(o) = o.id == t.id))
  return push_all(base_types, own)
}
fn push_all(a: list, b: list): list {
  var out = a
  for x in b { out = push(out, x) }
  return out
}
fn type_of_id(shipped: string, mine: string, id: string): any = find(all_types(shipped, mine), fn(t) = t.id == id)
fn id_ok(id: any): bool {
  if type_of(id) != "string" or len(id) == 0 or len(id) > 60 { return false }
  return len(filter(split(lower(id), ""), fn(c) = find_text("abcdefghijklmnopqrstuvwxyz0123456789-_", c) < 0)) == 0
}
// his own type: checked first, kept in COS's data; an agent's refused; a shipped id is left alone
fn save_type(shipped: string, mine: string, t: any, by: any): map {
  if by == null { return { ok: false, code: 400, error: "say who acts: \{ \"by\": \"person\" \}" } }
  if find_text(str(by), "agent:") == 0 { return { ok: false, code: 403, error: "an agent proposes a gate type; making one is his (PC5: an agent's type waits for him)" } }
  if t == null or not id_ok(get(t, "id", null)) { return { ok: false, code: 400, error: "a gate type needs an id: letters, digits, - and _" } }
  if any(types_in(shipped, "shipped"), fn(x) = x.id == t.id) { return { ok: false, code: 409, error: "\"" + t.id + "\" is a shipped type: give yours another id" } }
  let ps = problems(t)
  if len(ps) > 0 { return { ok: false, code: 400, error: join(ps, "; "), problems: ps } }
  var keep = clone(t)
  keep.madeBy = "person"
  make_dir(mine)
  write_file(mine + "/" + t.id + ".gatetype", json(keep) + "\n")
  return { ok: true, type: type_of_id(shipped, mine, t.id) }
}

component GateRunner {
  id = "cos.gate.runner"
  namespace = "cos"
  version = "1.0.0"
  intent = "a gate decides open, closed or gap from its type, what it holds and what it was told; the same type decides differently as it learns"
  state { checks: CHECKS, actions: ACTIONS }

  in decide(q: { type: map, with: map, output: any, context: map, answers: map, pipeline: any, task: any }) {
    let ps = problems(q.type)
    if len(ps) > 0 { emit out answer { hook: "decide", ok: false, value: { problems: ps }, why: join(ps, "; ") } } else {
      emit out answer { hook: "decide", ok: true, value: decide(q), why: null }
    }
  }

  in plan(q: { type: map, with: map, output: any, pipeline: any, task: any }) {
    emit out answer { hook: "plan", ok: true, value: plan(q), why: null }
  }

  in validate(q: { type: map }) {
    let ps = problems(q.type)
    var why = null
    if len(ps) > 0 { why = join(ps, "; ") }
    emit out answer { hook: "validate", ok: len(ps) == 0, value: { problems: ps }, why: why }
  }

  out answer: { hook: string, ok: bool, value: any, why: any }
}
