// cos/pipeline/box.eg — one box shape for every step on the canvas (MOD-PC-BOX, phase PC1_one_box_shape; cos/spec/pipeline-canvas.spec).
// James, 2026-11-08: "steps as boxes, with wires as the flow into the hooks of gates as compartments. boxes can  be gates, systems, agents, macros,
// pipelines, tools" · "using emerge as the language" · "Hard corded has to earn its place and a node or api call is better than static."
// A Box is { id, kind, ref, hooks: { in, out }, contract: { requires, gives }, gate, args }; a Wire is { from: "<box>.<hook>", to: "<box>.<hook>" }.
// The engine's pipeline (lib/automation/pipeline.js, PL1) is the file; to_boxes/to_tasks convert both ways and lose nothing (PCS-002: no second
// store). problems() names every fault: an unknown kind, an id used twice, a wire to a hook that does not exist, a cycle, a ref that names nothing.
// Reached only through its in hooks (CIE-EG §5.2); every answer leaves by the one out hook, answer.

let KINDS = ["gate", "system", "agent", "macro", "pipeline", "procedure", "tool", "build"]

// the engine's step type → the box kind; any other engine step is a tool (it still runs as the engine's own step)
fn kind_of(step_type: string): string {
  if step_type == "macro" or step_type == "pipeline" or step_type == "agent" or step_type == "gate" or step_type == "procedure" { return step_type }
  if step_type == "workflow" { return "pipeline" }
  if step_type == "command" { return "system" }
  return "tool"
}

fn ref_of(step: map): string {
  var c = get(step, "config", {})
  for k in ["name", "pipeline", "procedure", "hat", "ref", "url", "path"] {
    if has(step, k) and type_of(step[k]) == "string" { return step[k] }
    if type_of(c) == "map" and has(c, k) and type_of(c[k]) == "string" { return c[k] }
  }
  return step.type
}

// one engine task → one box; the whole task rides in args.task, so to_tasks gives it back unchanged
fn to_box(t: map): map {
  var g = null
  if has(t, "gate") { g = t.gate }
  // the step's own words when it has them (his pipelines label every task: "Scope & Pricing: each package"); the ref when it has none
  return { id: t.id, kind: kind_of(t.step.type), ref: ref_of(t.step), label: get(t, "label", ref_of(t.step)), hooks: { in: ["in"], out: ["out"] },
    contract: { requires: get(t, "depends_on", []), gives: ["output"] }, gate: g, args: { task: t } }
}

fn to_boxes(p: map): map {
  var boxes = []
  var wires = []
  for t in get(p, "tasks", []) {
    boxes = push(boxes, to_box(t))
    for d in get(t, "depends_on", []) { wires = push(wires, { from: d + ".out", to: t.id + ".in" }) }
  }
  return { boxes: boxes, wires: wires }
}

// the boxes and wires → the engine's tasks; depends_on comes from the wires, so a wire drawn on the canvas is a dependency in the file
fn to_tasks(g: map): list {
  var out = []
  for b in g.boxes {
    var deps = []
    for w in g.wires { if split(w.to, ".")[0] == b.id { deps = push(deps, split(w.from, ".")[0]) } }
    var t = clone(b.args.task)
    t.depends_on = deps
    out = push(out, t)
  }
  return out
}

// a procedure (his .procedure, lib/repo-procedures.js PD1): steps in order, { tool, args } | { confirm } | { check }. Each step a box, wired in
// order; confirm is a gate (his yes), check is a gate on an earlier step's output. The whole step rides in args.step.
fn procedure_box(s: map, i: num): map {
  var k = "tool"
  var r = "step"
  if has(s, "tool") { r = s.tool }
  if has(s, "confirm") { k = "gate"; r = "confirm" }
  if has(s, "check") { k = "gate"; r = "check" }
  return { id: "s" + str(i + 1), kind: k, ref: r, hooks: { in: ["in"], out: ["out"] }, contract: { requires: [], gives: ["output"] }, gate: null, args: { step: s } }
}

fn procedure_to_boxes(p: map): map {
  var boxes = []
  var wires = []
  var i = 0
  for s in get(p, "steps", []) {
    boxes = push(boxes, procedure_box(s, i))
    if i > 0 { wires = push(wires, { from: "s" + str(i) + ".out", to: "s" + str(i + 1) + ".in" }) }
    i = i + 1
  }
  return { boxes: boxes, wires: wires }
}

fn boxes_to_steps(g: map): list = map(g.boxes, fn(b) = b.args.step)

fn box_ids(g: map): list = map(g.boxes, fn(b) = b.id)

fn find_box(g: map, id: string): any = find(g.boxes, fn(b) = b.id == id)

fn hook_ok(g: map, end: string, side: string): bool {
  let parts = split(end, ".")
  if len(parts) != 2 { return false }
  let b = find_box(g, parts[0])
  if b == null { return false }
  return index_of(b.hooks[side], parts[1]) >= 0
}

// a cycle among the wires, as the list of ids around it, or null
fn cycle(g: map): any {
  var done_ids = []
  var path = []
  var found = null
  fn deps_of(id) = map(filter(g.wires, fn(w) = split(w.to, ".")[0] == id), fn(w) = split(w.from, ".")[0])
  fn visit(id) {
    if found != null { return null }
    if index_of(path, id) >= 0 { found = push(drop(path, index_of(path, id)), id); return null }
    if index_of(done_ids, id) >= 0 { return null }
    path = push(path, id)
    for d in deps_of(id) { visit(d) }
    path = take(path, len(path) - 1)
    done_ids = push(done_ids, id)
  }
  for id in box_ids(g) { visit(id) }
  return found
}

// known: { <kind>: [refs] } for the kinds whose refs can be checked here; a kind not in it is not checked, and that is said
fn problems(g: map, known: map): map {
  var ps = []
  var unchecked = []
  var seen = []
  for b in g.boxes {
    if index_of(KINDS, b.kind) < 0 { ps = push(ps, "box " + b.id + ": the kind \"" + b.kind + "\" is not one of " + join(KINDS, ", ")) }
    if index_of(seen, b.id) >= 0 { ps = push(ps, "box " + b.id + ": the id is used twice") }
    seen = push(seen, b.id)
    if has(known, b.kind) {
      if index_of(known[b.kind], b.ref) < 0 { ps = push(ps, "box " + b.id + ": " + b.kind + " \"" + b.ref + "\" names nothing known") }
    } else if index_of(unchecked, b.kind) < 0 { unchecked = push(unchecked, b.kind) }
  }
  for w in g.wires {
    if not hook_ok(g, w.from, "out") { ps = push(ps, "wire " + w.from + " -> " + w.to + ": " + w.from + " is not an out hook of a box here") }
    if not hook_ok(g, w.to, "in") { ps = push(ps, "wire " + w.from + " -> " + w.to + ": " + w.to + " is not an in hook of a box here") }
  }
  if len(ps) == 0 {
    let c = cycle(g)
    if c != null { ps = push(ps, "a cycle: " + join(c, " -> ")) }
  }
  return { ok: len(ps) == 0, problems: ps, unchecked: unchecked }
}

// ── the graph as an ERAVOS project (.erv, its own format: specs/eravos.erv-format.spec in HorrisEllis/Eravos-Canvas) ──
// James, 2026-11-08: "i want the tools compatable with eravos independantly. eravos is the build surface for nexus." Each box becomes a layer
// of ERAVOS's own Box tool (eravos.agents.step), its whole step in the tool's extra; the wires become ERAVOS dataflow wires. JSON is
// YAML, so ERAVOS opens this with its own Open, and nothing in its canvas changes. Laid out by the DAG: a box's column is one past the
// deepest box it waits on.
fn depth_of(g: map, id: string, seen: list): num {
  if index_of(seen, id) >= 0 { return 0 }
  var d = 0
  for w in g.wires {
    if split(w.to, ".")[0] == id {
      let n = depth_of(g, split(w.from, ".")[0], push(seen, id)) + 1
      if n > d { d = n }
    }
  }
  return d
}

// James, 2026-11-08: "Gates are inbetween steps. So compartment, gate, compartment, gate." A step's gate becomes its own box after it, on the
// canvas as on the run: the step's wires out leave from its gate. The gate box carries the gate as its settings; a step with no gate wires on as it is.
fn with_gates(g: map): map {
  var boxes = []
  var gated = []
  for b in g.boxes {
    boxes = push(boxes, b)
    if get(b, "gate", null) != null {
      gated = push(gated, b.id)
      boxes = push(boxes, { id: b.id + "-gate", kind: "gate", ref: "gate", label: "gate · " + join(keys(b.gate), " · "), hooks: { in: ["in"], out: ["out"] },
        contract: { requires: [b.id], gives: ["output"] }, gate: null, args: { gate: b.gate, after: b.id } })
    }
  }
  var wires = []
  for id in gated { wires = push(wires, { from: id + ".out", to: id + "-gate.in" }) }
  for w in g.wires {
    let src = split(w.from, ".")[0]
    if index_of(gated, src) >= 0 { wires = push(wires, { from: src + "-gate.out", to: w.to }) } else { wires = push(wires, w) }
  }
  return { boxes: boxes, wires: wires }
}

fn to_erv(g0: map, name: string): map {
  let g = with_gates(g0)
  var tools = []
  var rows = []
  for b in g.boxes {
    let c = depth_of(g, b.id, [])
    var r = 0
    for x in rows { if x == c { r = r + 1 } }
    rows = push(rows, c)
    tools = push(tools, { id: b.id, kind: "tool", tool: "eravos.agents.step", label: get(b, "label", b.ref), on: true, locked: false,
      at: { x: 40 + c * 320, y: 40 + r * 230, w: 260, h: 190 },
      state: { params: { kind: b.kind, ref: b.ref, step: b.id, state: "" }, extra: { box: b, kinds: KINDS, last: null } } })
  }
  let wires = map(g.wires, fn(w) = { from: [split(w.from, ".")[0], "step.hook.out"], to: [split(w.to, ".")[0], "step.hook.in"], type: "dataflow" })
  return { erv: 1, name: name, app: "Nexus (cos/pipeline/box.eg)", workspace: "1.0.0", layers: [
    { id: "view", kind: "canvas", label: "Canvas view", on: true, locked: false, data: { x: 0, y: 0, z: 1 } },
    { id: "tools", kind: "group", label: "Tools", on: true, locked: false, layers: tools },
    { id: "wires", kind: "wires", label: "Wires", on: true, locked: false, data: wires } ] }
}

// 2026-11-10 — the way back: an ERAVOS project drawn on the canvas → the engine's pipeline. James: "Also needs to be able to create pipelines. That's
// what the canvas is for." · "I want to program it myself using the pipeline instead of needing you." A Step tool that came from a pipeline gives
// its task back (edits to its label, Names and kind on the canvas win); one drawn new is made from what it says: its kind and what it names. A gate
// tool after a step is that step's gate again (a new one says its check in Names, as JSON, else as text the output must contain). Wires are the
// dependencies. Tools that are not steps (an instrument on the same canvas) are left out and named.
fn step_for(kind: string, ref: string): map {
  if kind == "macro" { return { type: "macro", config: { name: ref } } }
  if kind == "pipeline" { return { type: "pipeline", config: { pipeline: ref } } }
  if kind == "procedure" { return { type: "procedure", config: { procedure: ref } } }
  if kind == "agent" { return { type: "agent", config: { agentKey: ref, await: true } } }
  if kind == "system" { return { type: "command", config: { command: ref } } }
  if kind == "build" { return { type: "framework", config: { framework: ref } } }
  // a tool: Names is the engine's step type (api, script, browser, …), or a step as JSON
  if len(ref) > 0 and slice(ref, 0, 1) == "\{" { return parse_json(ref) }
  return { type: ref, config: {} }
}
fn gate_of(ref: string): map {
  if len(ref) > 0 and slice(ref, 0, 1) == "\{" { return parse_json(ref) }
  return { contains: ref }
}
fn drop_key(m: map, k: string): map {
  var o = {}
  for x in keys(m) { if x != k { o[x] = m[x] } }
  return o
}
fn layer_of(e: map, id: string): any = find(get(e, "layers", []), fn(l) = get(l, "id", "") == id)
fn from_erv(e: map): map {
  var tools = []
  let tl = layer_of(e, "tools")
  if tl != null { tools = get(tl, "layers", []) }
  var wl = layer_of(e, "wires")
  var raw = []
  if wl != null { raw = get(wl, "data", []) }
  var steps = []
  var skipped = []
  var problems = []
  for t in tools {
    if get(t, "tool", "") != "eravos.agents.step" { skipped = push(skipped, get(t, "label", get(t, "id", "?"))) }
    else if get(t, "on", true) == false { skipped = push(skipped, get(t, "label", t.id) + " (switched off)") }
    else { steps = push(steps, t) }
  }
  let ids = map(steps, fn(t) = t.id)
  var gates = {}
  for t in steps {
    let pr = get(get(t, "state", {}), "params", {})
    if get(pr, "kind", "") == "gate" { gates[t.id] = true }
  }
  // the wires between steps; a gate tool is folded into the step before it
  var before = {}
  for w in raw {
    let f = w.from[0]
    let to = w.to[0]
    if index_of(ids, f) >= 0 and index_of(ids, to) >= 0 and has(gates, to) { before[to] = f }
  }
  var boxes = []
  var stepgate = {}
  for t in steps {
    let st = get(t, "state", {})
    let pr = get(st, "params", {})
    let box0 = get(get(st, "extra", {}), "box", null)
    let kind = get(pr, "kind", "tool")
    let ref = str(get(pr, "ref", ""))
    if kind == "gate" {
      let after = get(before, t.id, null)
      if after == null { problems = push(problems, "the gate " + get(t, "label", t.id) + " is not wired after a step") }
      else {
        var g = null
        if box0 != null and get(box0, "args", null) != null and has(box0.args, "gate") and (ref == "" or ref == "gate") { g = box0.args.gate } else { g = gate_of(ref) }
        stepgate[after] = g
      }
    } else {
      var task = null
      if box0 != null and get(get(box0, "args", {}), "task", null) != null and get(box0, "kind", "") == kind and get(box0, "ref", "") == ref { task = clone(box0.args.task) }
      else {
        if ref == "" { problems = push(problems, "the step " + get(t, "label", t.id) + " names nothing (Names is empty)") }
        task = { id: t.id, step: step_for(kind, ref) }
        if box0 != null and get(get(box0, "args", {}), "task", null) != null { task.id = box0.args.task.id }
      }
      // its label: as the file had it, unless renamed on the canvas (ERAVOS saves a tool's own name, "Step", as its label: that is no rename)
      let lab = get(t, "label", "")
      let named = lab != "" and lab != "Step"
      if box0 == null { if named { task.label = lab } else { if str(get(pr, "step", "")) != "" { task.label = str(pr.step) } } }
      else { if named and lab != get(box0, "label", null) { task.label = lab } }
      boxes = push(boxes, { id: t.id, task: task })
    }
  }
  // the id a tool carries on the canvas → the task's id in the file
  var tid = {}
  for b in boxes { tid[b.id] = b.task.id }
  var tasks = []
  for b in boxes {
    var deps = []
    for w in raw {
      var f = w.from[0]
      if has(gates, f) { f = get(before, f, "") }
      if w.to[0] == b.id and has(tid, f) and index_of(deps, tid[f]) < 0 { deps = push(deps, tid[f]) }
    }
    var t = b.task
    t.depends_on = deps
    // a gate tool wired after it is its gate; with none (deleted on the canvas), the step has no gate
    if has(stepgate, b.id) { t.gate = stepgate[b.id] } else { if has(t, "gate") { t = drop_key(t, "gate") } }
    tasks = push(tasks, t)
  }
  if len(tasks) == 0 { problems = push(problems, "no steps: put Step tools on the canvas and wire them") }
  return { ok: len(problems) == 0, problems: problems, skipped: skipped, pipeline: { name: get(e, "name", "pipeline"), description: "drawn on the canvas (cos/pipeline/box.eg from_erv)", tasks: tasks } }
}

component BoxShape {
  id = "cos.automation.box"
  namespace = "cos"
  version = "1.0.0"
  intent = "one box shape for every step on the canvas; the engine's pipeline file both ways, nothing lost"
  state { kinds: KINDS }

  in boxes(q: { pipeline: map }) {
    emit out answer { hook: "boxes", ok: true, value: to_boxes(q.pipeline), why: null }
  }

  in tasks(q: { graph: map }) {
    emit out answer { hook: "tasks", ok: true, value: to_tasks(q.graph), why: null }
  }

  in procedure(q: { procedure: map }) {
    emit out answer { hook: "procedure", ok: true, value: procedure_to_boxes(q.procedure), why: null }
  }

  in steps(q: { graph: map }) {
    emit out answer { hook: "steps", ok: true, value: boxes_to_steps(q.graph), why: null }
  }

  // 2026-11-09 — the DAG a run keeps as its file (cos/pipeline/runs.js dag.dag): each step and, after a gated step, its gate, wired
  in dag(q: { graph: map }) {
    emit out answer { hook: "dag", ok: true, value: with_gates(q.graph), why: null }
  }

  in erv(q: { graph: map, name: string }) {
    emit out answer { hook: "erv", ok: true, value: to_erv(q.graph, q.name), why: null }
  }

  in from_erv(q: { erv: map }) {
    let r = from_erv(q.erv)
    var why = null
    if not r.ok { why = join(r.problems, "; ") }
    emit out answer { hook: "from_erv", ok: r.ok, value: r, why: why }
  }

  in validate(q: { graph: map, known: map }) {
    let r = problems(q.graph, q.known)
    var why = null
    if not r.ok { why = join(r.problems, "; ") }
    emit out answer { hook: "validate", ok: r.ok, value: r, why: why }
  }

  out answer: { hook: string, ok: bool, value: any, why: any }
}
