// cos/pipeline/test/runs.test.eg — a request kept as files (MOD-PC-RUNS, PC5). eg test cos/pipeline/test/runs.test.eg
// James, 2026-11-09: "Like each step needs to be persistent until the contract and conditions for the request from the dag have been met." · "The
// gates are temporary unless it didn't finish."
use "../runs.eg" as runs

let P = { id: "gig", name: "Gig", tasks: [
  { id: "a", step: { type: "set" }, gate: { type: "check", with: { contains: "ok" } } },
  { id: "b", depends_on: ["a"], step: { type: "set" } } ] }
fn fresh(): string { let b = "/tmp/cos-runs-test-" + uid(); remove_path(b); return b }
fn ev(base, kind, data) = runs.on_event(base, kind, data, null, 1000)

test "a request is files before it runs: its contract from the DAG, a step per step, a gate per typed gate, the DAG" {
  let base = fresh()
  let id = runs.request(base, P, { v: 1 }, "person", 100, "e1")
  let d = base + "/pipeline/runs/active/" + id
  let r = parse_json(read_file(d + "/run.run"))
  expect r.type == "run" and r.payload.request.vars == { v: 1 } and r.payload.contract.raid == id
  expect map(r.payload.conditions, fn(c) = c.step) == ["a", "b"] and r.payload.conditions[1].after == ["a"]
  // its contract is RAID's: one task gate per step, passing on the evidence step:<id>, a gate waiting on the gates of the steps it waits on
  let k = runs.contract_of(id, P, "person")
  expect k.v == 2 and map(k.gates, fn(g) = g.id) == ["a", "b"] and k.gates[1].depends_on == ["a"] and k.gates[0].pass_when == [{ evidence: "step:a" }]
  expect path_exists(d + "/steps/a.step") and path_exists(d + "/steps/b.step") and path_exists(d + "/gates/a.gate") and not path_exists(d + "/gates/b.gate")
  expect map(parse_json(read_file(d + "/dag.dag")).payload.boxes, fn(b) = b.id) == ["a", "a-gate", "b"]
  remove_path(base)
}

test "met: every step done and its gate open → moved to done/, the gates removed, the steps kept" {
  let base = fresh()
  let id = runs.request(base, P, {}, "person", 100, "e1")
  ev(base, "automation.pipeline.task", { runId: "e1", task: "a", status: "done", output: "ok", gate: { type: "check", outcome: "open" } })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "b", status: "done", output: "next" })
  let r = ev(base, "automation.pipeline.done", { runId: "e1", status: "ok" })
  expect r.met
  let d = base + "/pipeline/runs/done/" + id
  expect path_exists(d + "/run.run") and not path_exists(d + "/gates") and path_exists(d + "/steps/a.step")
  expect not path_exists(base + "/pipeline/runs/active/" + id)
  expect parse_json(read_file(d + "/run.run")).payload.phase == "met"
  remove_path(base)
}

test "not met: it stays in active/ with its gates; a resume names what is met; what a gate learned reaches the next request" {
  let base = fresh()
  let id = runs.request(base, P, { v: 2 }, "person", 100, "e1")
  ev(base, "automation.pipeline.task", { runId: "e1", task: "a", status: "done", output: "ok", gate: { type: "check", outcome: "open" } })
  runs.gate_verdict(base, "e1", "a", { outcome: "open", next: { runs: 1, streak: 0 } }, 150)
  ev(base, "automation.pipeline.task", { runId: "e1", task: "b", status: "failed", error: "boom" })
  let r = ev(base, "automation.pipeline.done", { runId: "e1", status: "failed" })
  expect not r.met
  let d = base + "/pipeline/runs/active/" + id
  expect path_exists(d + "/gates/a.gate")
  let run = parse_json(read_file(d + "/run.run")).payload
  expect run.phase == "not met" and find_text(run.contract.verdict.why, "b (failed: boom)") >= 0, json(run.contract)
  expect find_text(run.contract.verdict.by, "COS's own steps") == 0, "no RAID verdict given: said whose it is"
  let q = runs.resume_of(base, id)
  expect q.ok and q.done == { a: "ok" } and q.vars == { v: 2 }
  let id2 = runs.request(base, P, {}, "person", 200, "e2")
  expect parse_json(read_file(base + "/pipeline/runs/active/" + id2 + "/gates/a.gate")).payload.context == { runs: 1, streak: 0 }
  remove_path(base)
}

test "listed and read back; an engine run with no request is said" {
  let base = fresh()
  let id = runs.request(base, P, {}, "person", 100, "e1")
  expect map(runs.list_requests(base, "active"), fn(x) = x.id) == [id]
  let rr = runs.read_request(base, id)
  expect rr.where == "active" and len(rr.steps) == 2 and len(rr.gates) == 1
  expect not ev(base, "automation.pipeline.task", { runId: "nobody", task: "a", status: "done" }).ok
  remove_path(base)
}

test "the wires carry nodes: a step's output is a node file of its type; the next step took it; the DAG says what each wire carries" {
  // James, 2026-11-09: "i meant the data that runs through the pipeline like idearium pipeline does, emerge, .contracts with .dag, .chunk, .context"
  let base = fresh()
  let Q = { id: "spine", tasks: [
    { id: "ask", step: { type: "set" }, gives: ["context"] },
    { id: "plan", depends_on: ["ask"], step: { type: "set" }, takes: ["context"], gives: ["contract"] },
    { id: "cut", depends_on: ["plan"], step: { type: "set" }, takes: ["contract"], gives: ["chunk"] },
    { id: "note", depends_on: ["plan"], step: { type: "set" } } ] }
  let id = runs.request(base, Q, {}, "person", 100, "e1")
  let d = base + "/pipeline/runs/active/" + id
  let dag = parse_json(read_file(d + "/dag.dag")).payload
  expect dag.for == id
  expect find(dag.wires, fn(w) = w.from == "ask.out" and w.to == "plan.in").carries == ["context"]
  expect find(dag.wires, fn(w) = w.from == "plan.out" and w.to == "cut.in").carries == ["contract"]
  expect find(dag.wires, fn(w) = w.from == "plan.out" and w.to == "note.in").carries == ["contract"], "takes nothing named: all it is given"
  ev(base, "automation.pipeline.task", { runId: "e1", task: "ask", status: "done", value: { for: id, items: [{ source: "idearium", ref: "atlas", text: "x" }] } })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "plan", status: "running" })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "plan", status: "done", value: { envelope: 1, type: "contract", id: "c1", payload: { uuid: "c1", forAgent: "cos", intention: "x", endState: "y" } } })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "cut", status: "running" })
  let ctx = parse_json(read_file(d + "/nodes/ask/out.context"))
  expect ctx.type == "context" and ctx.payload.items[0].source == "idearium"
  expect parse_json(read_file(d + "/nodes/plan/out.contract")).payload.uuid == "c1", "a node given is kept as it is"
  let plan = parse_json(read_file(d + "/steps/plan.step")).payload
  expect plan.took == ["nodes/ask/out.context"] and plan.gave == ["nodes/plan/out.contract"]
  expect parse_json(read_file(d + "/steps/cut.step")).payload.took == ["nodes/plan/out.contract"]
  let rr = runs.read_request(base, id)
  expect len(rr.nodes) == 2 and rr.contract.raid == id, "the request names its contract, RAID's"
  remove_path(base)
}

test "met is RAID's answer when it is given; the booking is recorded" {
  let base = fresh()
  let id = runs.request(base, P, {}, "person", 100, "e1")
  runs.booked(base, id, true, "booked with Cortex (RAID)")
  ev(base, "automation.pipeline.task", { runId: "e1", task: "a", status: "done", output: "ok", gate: { type: "check", outcome: "open" } })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "b", status: "done", output: "x" })
  let r = runs.on_event(base, "automation.pipeline.done", { runId: "e1", status: "ok", raid: { complete: false, why: ["gate b is READY"] } }, null, 1000)
  expect not r.met, "every step met in COS, but RAID says not complete: RAID's answer stands"
  let run = parse_json(read_file(base + "/pipeline/runs/active/" + id + "/run.run")).payload
  expect run.contract.booked and run.contract.verdict.by == "RAID's contract (Cortex)" and run.contract.verdict.why == "gate b is READY"
  remove_path(base)
}

test "PC8 slice b: a failed run retried resumes its request; from a step, it and every step after it run again; a met run is not retried" {
  let base = fresh()
  let Q = { id: "three", name: "Three", tasks: [{ id: "a", step: { type: "set" } }, { id: "b", depends_on: ["a"], step: { type: "set" } },
    { id: "c", depends_on: ["b"], step: { type: "set" } }, { id: "d", depends_on: ["a"], step: { type: "set" } }] }
  let id = runs.request(base, Q, { v: 2 }, "person", 100, "e1")
  ev(base, "automation.pipeline.task", { runId: "e1", task: "a", status: "done", output: "A" })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "b", status: "done", output: "B" })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "d", status: "done", output: "D" })
  ev(base, "automation.pipeline.task", { runId: "e1", task: "c", status: "failed", error: "boom" })
  ev(base, "automation.pipeline.done", { runId: "e1", status: "failed" })
  let r = runs.retry_of(base, "e1", null)
  expect r.ok and r.request == id and r.pipeline == "three" and r.vars == { v: 2 } and sort(keys(r.done)) == ["a", "b", "d"] and r.again == []
  let f = runs.retry_of(base, "e1", "b")
  expect f.ok and f.again == ["b", "c"] and sort(keys(f.done)) == ["a", "d"] and f.done.a == "A"
  expect runs.retry_of(base, "e1", "zz").code == 404
  expect runs.retry_of(base, "nope", null).code == 404
  remove_path(base)
}

