// image-analyzer.eg — image → field injection
// UUID: image-analyzer-v1-0-0 | source: canvas/spec-a/image-analyzer.js
compartment "image-analyzer" {
  id = image-analyzer-001
  uuid = image-analyzer-001-xxxx
  intent = analyze_image_extract_field_parameters_inject_attractors
  component "analyzer" {
    on analyze { input image canvas read_pixel_grid(image) extract_color_features apply_as_attractors record }
    on inject  { input features for each feature { renderer.upsertAttractor(feature) } record }
  }
}
