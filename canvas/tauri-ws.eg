// tauri-ws.eg — Rust WS bridge for desktop (port 7771)
// UUID: tauri-ws-v1-0-0 | source: tauri/ws-server.js
compartment "tauri-ws" {
  id = tauri-ws-001
  uuid = tauri-ws-001-xxxx
  intent = rust_tauri_ws_bridge_extension_to_nexus_node_core
  port { bind = 127.0.0.1 number = 7771 protocol = ws }
  component "bridge" {
    on extension.message { forward to nexus_core record }
    on nexus.event       { broadcast to extension record }
    on nexus.boot        { spawn nexus_node_child_process record }
  }
  schema {
    NexusMessage = { msg_type = string id = string? service = string? payload = object? }
  }
}
