// node-inspector.eg — node detail panel
// UUID: node-inspector-v1-0-0 | source: canvas/spec-a/node-inspector.js
compartment "node-inspector" {
  id = node-inspector-001
  uuid = node-inspector-001-xxxx
  intent = show_node_details_hooks_sigma_trust_score_on_hover
  component "inspector" {
    on node.hover { input node get_from_jaa(node.uuid) render_panel { uuid sigma trustScore hooks manifest } record }
    on node.click { emit "node.selected" { uuid = node.uuid } record }
  }
}
