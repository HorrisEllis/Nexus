// cobalt-registry.eg — Cobalt node registry
// UUID: cobalt-registry-v1-0-0 | source: foundation/cobalt-core.js
compartment "cobalt-registry" {
  id = cobalt-registry-001
  uuid = cobalt-registry-001-xxxx
  intent = all_nodes_register_here_manifest_validated
  component "registry" {
    on connect  { input node validate node.manifest insert registry[node.uuid] = node emit "node.connected" record }
    on status   { output { connected = count(connected) total = count(all) } record }
    on load     { input manifest validate manifest connect manifest record }
  }
}
