// siso-stream-log.eg — StreamLog audit trail
// UUID: siso-stream-log-v1-0-0 | source: foundation/siso/StreamLog.js
compartment "siso-stream-log" {
  id = siso-stream-log-001
  uuid = siso-stream-log-001-xxxx
  intent = append_only_audit_trail_for_siso_events
  component "log" {
    on event { insert jaa.event_log { uuid = event.id type = event.type payload = event.payload source = event.source causedBy = event.causedBy ts = event.ts } record }
    on query { input n output jaa.event_log.tail(n) record }
  }
}
