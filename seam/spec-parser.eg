// spec-parser.eg — spec chunker + SEAM prompt builder
// UUID: spec-parser-v1-0-0
compartment "spec-parser" {
  id = spec-parser-001
  uuid = spec-parser-001-xxxx
  intent = split_spec_into_chunks_build_seam_contracts_auto_generate_tests
  split_strategies { heading divider phase size custom }
  component "chunker" {
    input text splitOn maxSize customPat
    if splitOn == heading  { chunks = split(text /^#{1,3} /m) }
    if splitOn == divider  { chunks = split(text /^---+$/m) }
    if splitOn == phase    { chunks = split(text /^(Phase|PHASE|Step|STEP) \d/m) }
    if splitOn == custom   { chunks = split(text customPat) }
    else { chunks = split_by_size(text maxSize) }
    for each chunk in chunks
      if chunk.length > maxSize { sub-split by paragraphs }
      title  = extract_title(chunk)
      tests  = auto_generate_tests(chunk)
      profile = build_profile(chunk)
      output { id = uid index title content tests profile status = pending }
      record
  }
  component "test-generator" {
    input chunk
    tests = []
    if has_tables(chunk)     { tests.push "All table entries acknowledged" }
    if has_code_blocks(chunk) { tests.push "All code blocks acknowledged" }
    musts = count_musts(chunk)
    if musts > 0 { tests.push musts + " mandatory requirements confirmed" }
    jaa_tables = count_jaa_tables(chunk)
    if jaa_tables > 0 { tests.push jaa_tables + " JAA tables identified" }
    tests.push "No questions or blockers before proceeding"
    output tests
    record
  }
  component "prompt-builder" {
    input chunk idx total sysKey
    prevVerified = count_verified(0..idx)
    hdr = "SEAM CHUNK " + (idx+1) + "/" + total + " — " + chunk.title + nl + "[Prior verified: " + prevVerified + "/" + idx + "]" + nl
    contract = "SEAM CONTRACT:" + nl + chunk.tests.map(t i => "[PASS/FAIL] Test " + (i+1) + ": " + t).join(nl) + nl + "SEAM VERDICT: PASS | FAIL"
    sys = SEAM_SYSTEM_PROMPTS[sysKey] or ""
    output sys + hdr + chunk.content + contract
    record
  }
}
