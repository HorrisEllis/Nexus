// idearium-cli.eg — Idearium CLI, source of truth
// UUID: idearium-cli-v1-0-0 | source: idearium/cli/index.js
compartment "idearium-cli" {
  id = idearium-cli-001
  uuid = idearium-cli-001-xxxx
  intent = cli_is_truth_layer_api_and_ui_are_projections
  component "commands" {
    on "idea add"      { insert jaa.ideas emit "idea.created" record }
    on "idea list"     { query jaa.ideas output table record }
    on "idea show"     { get jaa.ideas output page record }
    on "idea phase"    { update jaa.ideas emit "idea.phase" record }
    on "idea tension"  { compute tension output score record }
    on "idea link"     { insert jaa.idea_links emit "idea.linked" record }
    on "idea archive"  { archive jaa.ideas emit "idea.archived" record }
    on "idea search"   { search jaa.ideas output table record }
    on "idea tree"     { query jaa.ideas + jaa.idea_links output tree record }
    on "spec new"      { insert jaa.specs emit "spec.created" record }
    on "spec show"     { get jaa.specs output page record }
    on "spec check"    { validate jaa.specs emit "spec.checked" record }
    on "spec build"    { build emit "spec.built" record }
    on "spec list"     { query jaa.specs output table record }
    on "gap list"      { query jaa.gaps output table record }
    on "gap open"      { insert jaa.gaps emit "gap.opened" record }
    on "gap resolve"   { update jaa.gaps emit "gap.resolved" record }
    on "push"          { insert jaa.snapshots emit "push.complete" record }
    on "status"        { output { ideas specs gaps snr } record }
    on "snr"           { compute snr from event_log output score record }
    record
  }
}
