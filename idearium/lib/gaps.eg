// idearium/lib/gaps.eg — the Emerge rung's skeleton gaps (EMB1 expanded 2026-11-19, docs/2026-10-17-pieces-not-order-phasemap.spec).
// The decisions, in Emerge; idearium/lib/emerge-rung.cjs does the I/O. Each gap is a pillar:gap (pillar/contracts/contracts.eg): what is
// missing (a function's body) and the constraint it blocks (the module compiles, its expectation passes).
// James, 2026-11-19: "yes we could have the skeleton gaps, it needs to fill. using the dependancy graph." · "everything, should be as
// deterministic as possible, and the llm only when strictly necessary. primitive per primitive"
// James, same day: "get it working, built, expanded, dont forget pillar".
// Pure. Compiled (eg build → eg-build/gaps.js, kept as gaps.cjs: idearium/ is an ES module package).
//   order(gaps) → { order: [ids], why }       dependencies first; a cycle or a missing dependency is said, not guessed
//   as_gap(g)   → a pillar:gap { id, missingVariable, affectedConstraint, source, severity, causedBy }, or { refused } as the contract says
//   needs(names, does) → the dependency graph from the plan's own words: each export depends on the other exports its "does" names
//   hint(why)   → the fix for a compiler refusal Nexus has met before ("" when it has not): learned from each attempt, one row per refusal
//   step(q)     → { action: "retry" | "escalate" | "hold", why }   q: { tries, per_rung, rung, rungs }
//   lesson(attempts, keep) → what a fresh chat is told before it tries a gap again
//   struggle(attempts) → what got in the way of a gap: { kinds: [refusal kinds met], missing: [names its tries called that do not exist] }
//   link(order, before, add) → the chain with a new gap linked in just before the gap it unblocks
//   guard(depth, gaps, max_depth, max_gaps) → { ok, why }: a gap between gaps only while the chain stays bounded (§14.4)
// James, 2026-11-20: "if it can't fill a gap, it needs to understand why it's struggling, and add it to the learning memory, like anything that
// gets in the way towards filling the gap, becomes a gap in between the current step and the gap it couldn't fill" · "so each problem with
// filling the gap becomes the next gap, in the link." · "as each gap passes, gets logged or tagged in the gate as passed and compiled."

fn order(gaps: list): map {
  var done = []
  var left = gaps
  var guard = 0
  while len(left) > 0 and guard <= len(gaps) {
    var next = []
    var moved = false
    for g in left {
      var ready = true
      for d in get(g, "depends_on", []) {
        if not (d in done) { ready = false }
      }
      if ready {
        done = push(done, g.id)
        moved = true
      } else {
        next = push(next, g)
      }
    }
    left = next
    guard = guard + 1
    if not moved and len(left) > 0 {
      return { order: done, why: "stuck: " + join(map(left, fn(x) = str(x.id)), ", ") + " wait on a gap that is missing or in a cycle" }
    }
  }
  return { order: done, why: "dependencies first: " + join(done, " → ") }
}

fn step(q: map): map {
  let tries = get(q, "tries", 0)
  let per = get(q, "per_rung", 2)
  let rung = get(q, "rung", 1)
  let rungs = get(q, "rungs", 1)
  if tries < per { return { action: "retry", why: "try " + str(tries + 1) + " of " + str(per) + " on rung " + str(rung) + ", the refusal fed back" } }
  if rung < rungs { return { action: "escalate", why: "rung " + str(rung) + " spent its " + str(per) + " tries: rung " + str(rung + 1) + " of " + str(rungs) } }
  return { action: "hold", why: "every rung spent its tries: held, said, for a person or a smaller gap" }
}

fn as_gap(g: map): map {
  let missing = get(g, "missingVariable", null)
  let blocks = get(g, "affectedConstraint", null)
  if missing == null { return { refused: "no missingVariable: a gap names what is missing (pillar:gap)" } }
  if blocks == null { return { refused: "no affectedConstraint: a gap names the constraint it blocks (pillar:gap)" } }
  return { id: g.id, missingVariable: missing, affectedConstraint: blocks, source: get(g, "source", "emerge-rung"), severity: get(g, "severity", "blocking"), causedBy: get(g, "causedBy", null) }
}

fn needs(names: list, does: map): map {
  var out = {}
  for n in names {
    var deps = []
    let text = str(get(does, n, ""))
    for m in names {
      if m != n and find_text(text, m) >= 0 { deps = push(deps, m) }
    }
    out[n] = deps
  }
  return out
}

// each row: what Emerge's compiler says, and the fix. Rows come from refusals met in real runs (2026-11-19: DeepSeek 16b on NM1a's gaps).
let HINTS = [
  { says: "expected a loop variable", fix: "Loop over a list as: for e in xs, then the block in braces (no parentheses, no let, no of)." },
  { says: "!", fix: "Emerge has no !: write not x, and != for not-equal." },
  { says: ";", fix: "No semicolons in Emerge." },
  { says: "is a loop variable", fix: "A loop variable is read-only: build a new value with var out = [] and out = push(out, item)." },
  { says: "is a parameter", fix: "A parameter is read-only: build a new value in a var and return it; never change what was passed in." },
  { says: "expected end of statement, found a string", fix: "No throw: return a map with an error field instead." },
  { says: "is a let", fix: "A let cannot change: use var for anything that changes." },
  { says: "is not defined", fix: "Use only the parameters, the other functions in this module, and the builtins len, push, get, keys, str, split, join, slice, find_text; contains, starts_with and ends_with are words between two values (x contains y), not calls." },
  { says: "is already declared", fix: "That name is taken (a parameter, or an earlier let or var): give the new value a new name, e.g. var taken = ..., never var <a parameter's name>." },
  // 2026-11-25, EMB10 on the 3b alone: four helpers held (is_member, is_element, hasElement, and one named contains) because the 3b wrote
  // contains as a call and as a function name; in Emerge it is a word between two values. His: "it needs to be checking its own work".
  { says: "found \"contains\"", fix: "contains is a word between two values, never a call or a function name: write xs contains x (a list) or text contains part (a string), e.g. return models == \"\" or (models contains file)." },
  { says: "found \"starts_with\"", fix: "starts_with is a word between two values, never a call: write line starts_with \"data: \"." },
  { says: "found \"ends_with\"", fix: "ends_with is a word between two values, never a call: write name ends_with \".js\"." }
]

fn hint(why: string): string {
  var out = ""
  for h in HINTS {
    if find_text(why, h.says) >= 0 { out = out + h.fix + " " }
  }
  return out
}

// in_string(body, name) → is `name` inside a { } within a string of `body`? Emerge reads { } in a string as code (interpolation), so
// "if !x {{ y }}" written as "if !x { y }" makes the compiler say "y" is not defined. EMB3 run 15 (2026-11-21): eight tries at one gap met it.
fn in_string(body: string, name: string): bool {
  let parts = split(body, "\"")
  var i = 1
  while i < len(parts) {
    if find_text(parts[i], "{{") >= 0 and find_text(parts[i], name) >= 0 { return true }
    i = i + 2
  }
  return false
}

// fix_for(said, body) → the fix for what the compiler said about this body: a name in a string's braces gets the brace fix, else the hints
fn fix_for(said: string, body: string): string {
  let parts = split(said, "\"")
  if len(parts) >= 3 and find_text(parts[2], "is not defined") >= 0 and in_string(body, parts[1]) {
    return "Inside a string, {{ }} is read as code. For a brace in the text itself, write it twice: \"if not x {{{{ y }}}}\" is the text if not x {{ y }}."
  }
  // the cbuild runs of 2026-11-21: 16b and 3b wrote body.replace(/!([^ ]+)/g, …) at every try; the compiler stopped at the "!" in the regex and
  // the "!" row taught "write not x", the wrong lesson. JavaScript's replace and regex literals are named for what they are.
  if (find_text(body, ".replace(") >= 0 or find_text(body, "(/") >= 0 or find_text(body, "/g") >= 0) {
    return "Emerge has no .replace and no regular expressions /.../. Replace text with join(split(s, t), u), or call a function this module already has (they are written above the ___)."
  }
  return hint(said)
}

// repeats(attempts, body): this exact body was already refused. EMB3's gap files, read 2026-11-23: 146 tries held 39 different bodies, and the 30b at the
// top of the ladder was never reached. A model that answers the same refused body again has nothing more to give this gap: the next model takes it.
fn repeats(attempts: list, body: string): bool {
  let mine = trim(body)
  for a in attempts {
    let b = get(a, "body", null)
    if b != null and not get(a, "ok", false) and trim(str(b)) == mine { return true }
  }
  return false
}

// copies_examples(body) → { copies, why, fix }: a body that compares its input with literal text twice or more is answering the examples, not
// writing the rule. EMB3 run 15: the 3b and the 16b wrote if e == "let x = 1" … for each example of the phase, eight times.
// Only a whole input counts (a text of five characters or more with a space, like "let x = 1"): a rewriter comparing one token with "!" or
// "&&" is how such code is written (the cbuild run of 2026-11-21: every try at two helpers was refused by the first version of this check).
fn copies_examples(body: string): map {
  let parts = split(body, "== \"")
  var n = 0
  var i = 1
  while i < len(parts) {
    let lit = split(parts[i], "\"")[0]
    if len(lit) >= 5 and find_text(lit, " ") >= 0 { n = n + 1 }
    i = i + 1
  }
  if n >= 2 { return { copies: true, why: "the body compares the input with " + str(n) + " literal texts: it answers the examples, not the rule", fix: "Write the general rule that turns any input into its output. Never test the input against the examples' own values; the test has other inputs." } }
  return { copies: false, why: "", fix: "" }
}

fn struggle(attempts: list): map {
  var kinds = []
  var missing = []
  for a in attempts {
    if not get(a, "ok", false) {
      let s = str(get(a, "said", ""))
      let b = str(get(a, "body", ""))
      for h in HINTS {
        if find_text(s, h.says) >= 0 and not (h.says in kinds) { kinds = push(kinds, h.says) }
      }
      let parts = split(s, "\"")
      // a missing piece is a function the try CALLED: name( outside a string. A variable it lacked, or a name inside a string's braces, is not
      // a gap to link in (EMB3 run 15: "body", a parameter, and "y", inside a string, were each linked in as a new function)
      if len(parts) >= 3 and find_text(parts[2], "is not defined") >= 0 and not (parts[1] in missing) and find_text(b, parts[1] + "(") >= 0 and not in_string(b, parts[1]) { missing = push(missing, parts[1]) }
    }
  }
  return { kinds: kinds, missing: missing }
}

// Emerge's own words: no function can carry one of these names, so a helper named so can never be filled (2026-11-25: the 3b proposed a helper
// named contains, and it was held on every rung)
let WORDS = ["contains", "starts_with", "ends_with", "and", "or", "not", "in", "fn", "let", "var", "if", "else", "for", "while", "return", "true", "false", "null", "test", "expect", "use", "as", "component", "emit", "send", "wire", "on", "break", "continue"]

// Emerge's builtins (emerge/emerge/lang/runtime.js def(...), and push and hex): a helper named so would shadow the builtin, and a one-letter
// name is a parameter or a loop variable, never a piece (2026-11-25, EMB11 on the 3b: helpers named push and t were linked in and "passed")
let BUILTINS = ["print", "eprint", "exit", "str", "num", "int", "floor", "sqrt", "min", "max", "len", "keys", "values", "has", "get", "slice", "range", "join", "split", "upper", "lower", "type_of", "freeze", "json", "parse_json", "random", "uid", "read_file", "write_file", "list_dir", "path_exists", "now_ms", "sleep_ms", "is_dir", "make_dir", "move_path", "remove_path", "bytes", "byte_len", "utf8", "sha256", "hex", "find_text", "repr", "push", "args", "raise", "truthy"]

// adversary_verdict(agree, holds, answered) → what one adversary's case means (EMB12, his 2026-11-25: "another compiler ... the other one
// treats success as a problem"): the second adversary did not answer → "unread"; the two adversaries read the sentence differently →
// "ambiguous" (a tension in the spec, his to settle); they agree and the piece gives the same → "keep" (the case joins its examples); they
// agree and the piece gives something else → "refuse" (the piece is wrong)
fn adversary_verdict(agree: bool, holds: bool, answered: bool): string {
  if not answered { return "unread" }
  if not agree { return "ambiguous" }
  if holds { return "keep" }
  return "refuse"
}

// may_name(n) → can a helper carry this name? Not one of Emerge's words, not a builtin, not one letter (the rung asks this before it makes a
// helper; link asks it too)
fn may_name(n: string): bool {
  return not (n in WORDS) and not (n in BUILTINS) and len(n) >= 2
}

fn link(order: list, before: string, add: string): list {
  if add in order { return order }
  if not may_name(add) { return order }
  var out = []
  for x in order {
    if x == before { out = push(out, add) }
    out = push(out, x)
  }
  if not (before in order) { out = push(out, add) }
  return out
}

fn guard(depth: num, gaps: num, max_depth: num, max_gaps: num): map {
  if depth >= max_depth { return { ok: false, why: "held: " + str(depth) + " gaps deep already, the limit is " + str(max_depth) + " (no endless splitting, §14.4)" } }
  if gaps >= max_gaps { return { ok: false, why: "held: " + str(gaps) + " gaps in this module, the limit is " + str(max_gaps) + " (§14.4)" } }
  return { ok: true, why: "a gap in between: depth " + str(depth + 1) + " of " + str(max_depth) }
}

// lesson(attempts, keep) → what a fresh chat is told before it tries a gap again: the last `keep` attempts at this gap (from its .gap file,
// across runs), each body that was refused, what refused it, and its fix. "" when the gap has never been tried.
// James, 2026-11-19: "gates need to inject the lesson, and failure mode from the previous attempt, and try again, like it needs to understand
// the problem before trying again, like it needs to start a new chat and inject the context, and lesson fix again"
fn lesson(attempts: list, keep: num): string {
  var refused = []
  for a in attempts {
    if not get(a, "ok", false) { refused = push(refused, a) }
  }
  let n = len(refused)
  if n == 0 { return "" }
  // each distinct body once, with how often it came back: a small model shown its own refused body repeats it word for word (DeepSeek 16b,
  // 2026-11-19: the same rename body three times in a row, each shown back to it)
  var seen = []
  var times = {}
  for a in refused {
    let b = str(get(a, "body", "(no body)"))
    if b in seen {
      times[b] = times[b] + 1
    } else {
      seen = push(seen, b)
      times[b] = 1
    }
  }
  var out = "This gap was tried " + str(n) + " time(s) before and refused. Do NOT write the same body again. Read what refused each try and its fix, then write a different body.\n"
  var i = 0
  if len(seen) > keep { i = len(seen) - keep }
  while i < len(seen) {
    let b = seen[i]
    var last = {}
    for a in refused {
      if str(get(a, "body", "(no body)")) == b { last = a }
    }
    let f = str(get(last, "fix", ""))
    if f != "" { out = out + "\nThe fix: " + f }
    // 2026-11-24 (EMB8, measured): the refused body is never shown. Shown it, the 3b wrote it back word for word, 6 tries of 6, even with
    // the piece's own examples in front of it. What refused it and the fix say what to change.
    out = out + "\nRefused (" + str(times[b]) + " time(s)): " + str(get(last, "said", "")) + "\n"
    i = i + 1
  }
  return out
}
