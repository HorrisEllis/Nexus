// idearium/lib/test/gaps.test.eg — the skeleton's gaps, in dependency order. eg test idearium/lib/test/gaps.test.eg
// James, 2026-11-19: "yes we could have the skeleton gaps, it needs to fill. using the dependancy graph."
use "../gaps.eg" as G

test "dependencies first, whatever order they are listed in" {
  let o = G.order([{ id: "c", depends_on: ["b"] }, { id: "a" }, { id: "b", depends_on: ["a"] }])
  expect join(o.order, ",") == "a,b,c", o.why
}

test "a missing dependency or a cycle is said" {
  let o = G.order([{ id: "a", depends_on: ["zz"] }, { id: "b" }])
  expect join(o.order, ",") == "b" and find_text(o.why, "stuck") == 0, o.why
}

test "retry on the rung, then escalate, then hold" {
  expect G.step({ tries: 1, per_rung: 2, rung: 1, rungs: 2 }).action == "retry"
  expect G.step({ tries: 2, per_rung: 2, rung: 1, rungs: 2 }).action == "escalate"
  expect G.step({ tries: 2, per_rung: 2, rung: 2, rungs: 2 }).action == "hold"
}

test "a gap is a pillar:gap: what is missing and the constraint it blocks, or refused as the contract says" {
  let g = G.as_gap({ id: "rename", missingVariable: "the body of rename", affectedConstraint: "the module compiles and its expectation passes" })
  expect g.severity == "blocking" and g.source == "emerge-rung", json(g)
  expect find_text(G.as_gap({ id: "x", affectedConstraint: "c" }).refused, "missingVariable") >= 0
}

test "the dependency graph from the plan's own words" {
  let d = G.needs(["rename", "idOf", "pathOf"], { rename: "uses idOf to find the entry", idOf: "finds a path", pathOf: "the path of an id" })
  expect join(d.rename, ",") == "idOf" and len(d.idOf) == 0, json(d)
}

test "a fresh chat gets the lesson: every earlier body, what refused it, its fix; the last few only" {
  expect G.lesson([], 3) == ""
  let a = [{ body: "  a", said: "s1", fix: "" }, { body: "  b", said: "s2", fix: "f2" }, { body: "  c", said: "s3", fix: "" }, { body: "  d", said: "s4", fix: "" }]
  let l = G.lesson(a, 3)
  expect find_text(l, "tried 4 time") >= 0 and find_text(l, "s1") < 0 and find_text(l, "  b") >= 0, l
  expect find_text(l, "The fix: f2") >= 0 and find_text(l, "s4") >= 0, l
  let same = [{ body: "  var id = 1", said: "already declared", fix: "rename it" }, { body: "  var id = 1", said: "already declared", fix: "rename it" }]
  let ls = G.lesson(same, 3)
  expect find_text(ls, "(2 time(s))") >= 0 and find_text(ls, "Do NOT write") >= 0, ls
  expect len(split(ls, "var id = 1")) == 2, "a repeated body is shown once"
  expect find_text(G.hint("main.eg:13:3: error: \"id\" is already declared in this scope (line 12)"), "new name") >= 0
  expect G.lesson([{ body: "  ok", said: "filled; compiles", ok: true }], 3) == "", "a body that was accepted is no lesson"
}

test "a refusal met before brings its fix; one never met brings nothing" {
  expect find_text(G.hint("main.eg:3:7: error: expected a loop variable, found ("), "for e in xs") >= 0
  expect G.hint("main.eg:1:1: error: something new") == ""
}
