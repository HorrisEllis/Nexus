{
  "manifest_version": "1.0.0",
  "pack_id": "eravos.core",
  "pack_version": "3.0.0",
  "pack_type": "mod_pack",
  "label": "ERAVOS Core",
  "icon": "🎛",
  "description": "ERAVOS kernel + 28 mods. Drop-in zip. Opens as file://.",
  "author": "James Brooks",
  "kernel_target": "3.0.0",
  "status": "canonical",

  "permissions": [
    "audio_out", "audio_in",
    "midi_in", "midi_out",
    "bus_publish", "bus_subscribe",
    "filesystem_read",
    "network_fetch",
    "serial_access"
  ],

  "provides": [
    "capability.audio_context",
    "capability.pad_trigger",
    "capability.sequencer",
    "capability.timeline",
    "capability.sample_source",
    "capability.lfo",
    "capability.audio_out",
    "capability.channel_strip",
    "capability.lead_voice",
    "capability.sidechain_duck",
    "capability.master_fx_control",
    "capability.image_edit",
    "capability.image_export",
    "capability.video_edit",
    "capability.video_export",
    "capability.serial_io",
    "capability.hardware_control",
    "capability.automation_record",
    "capability.automation_playback",
    "capability.external_automation"
  ],

  "requires": [],
  "dependencies": [],

  "contents": {
    "manifest": "manifest.json",
    "shell": "index.html",
    "kernel": [
      "kernel/kernel.js",
      "kernel/intake.js"
    ],
    "runtime": [
      "runtime/canvas-wm.js",
      "runtime/mod-factory.js"
    ],
    "mods": [
      {
        "id": "eravos.pads",
        "label": "Drum Machine",
        "engine": "mods/pads/pads.engine.js"
      },
