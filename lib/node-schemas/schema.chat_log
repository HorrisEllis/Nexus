    modelUsed:
      type: string
      required: false
      description: real model/provider identifier used for this exchange
    intent:
      type: string
      required: false
      description: real classified intent for this exchange
    channel:
      type: string
      required: false
      description: real channel id this exchange happened on
    componentId:
      type: string
      required: false
      description: real component id that produced this exchange
    hookId:
      type: string
      required: false
      description: real hook id this exchange routed through
    contextLayers:
      type: number
      required: false
      description: real count of context layers assembled for this exchange
    fromStream:
      type: boolean
      required: false
      description: real flag — whether this exchange came from a streaming response
    ts:
