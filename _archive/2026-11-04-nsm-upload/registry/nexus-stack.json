{
  "name": "nexus-stack",
  "description": "NEXUS Full Stack — bridge + testenv + ollama + watchdogs",
  "script": "service/stack-runner.js",
  "env": {
    "NEXUS_PORT": "3747",
    "NEXUS_STACK_MODE": "full"
