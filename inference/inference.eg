// inference/inference.eg — our own model server, as a component: known by its record in Emerge's component registry, reached only through
// its in hooks (the drawbridge, AXIOMS §5.16: the component registry is also the event bus, the interaction contract and the bridge into the
// compartment). What it offers is its hooks; there is no second list. Every answer leaves by the one out hook, answer.
// James Brooks, 2026-11-24: "also everything has to use the drawbridge" · "is it better decoupled?" · "Remeber no coupling".
use "./models.eg" as M
use "./settings.eg" as S
use "./server.eg" as V

let FILE = "inference/data/settings.json"

// the homes to look in: the one given first, then every user folder on this machine (2026-11-24: COS runs as a Windows service, SYSTEM's
// home has no models; his are under C:/Users/<him>). His saved store and engine paths win over all of these.
fn homes(home: string): list {
  var out = [home]
  for root in ["C:/Users/", "/home/", "/Users/"] {
    if path_exists(root) {
      for u in list_dir(root) { if is_dir(root + u) and not (out contains root + u) { out = push(out, root + u) } }
    }
  }
  return out
}

fn base(home: string): map {
  let mine = S.overrides(FILE)
  var store = home + "/.ollama/models"
  var cands = ["/usr/local/bin/llama-server", "/usr/bin/llama-server"]
  var found = false
  for h in homes(home) {
    cands = push(cands, h + "/AppData/Local/Programs/Ollama/lib/ollama/llama-server.exe")
    if not found and len(M.models(h + "/.ollama/models")) > 0 {
      store = h + "/.ollama/models"
      found = true
    }
  }
  if has(mine, "stores") and len(mine.stores) > 0 { store = mine.stores[0] }
  if has(mine, "engines") and len(mine.engines) > 0 and has(mine.engines[0], "paths") { cands = mine.engines[0].paths }
  // every store in his settings, not only the first (2026-11-25, his: "three different 3b": the two new ones went to D:, C: had 4 GB free;
  // his tiering, the HDD for models used less)
  var ms = M.models(store)
  if has(mine, "stores") {
    for st in mine.stores {
      if st != store { for m in M.models(st) { ms = push(ms, m) } }
    }
  }
  let e = M.engine(cands)
  return { models: ms, engine: e, defaults: S.defaults(ms, e, store) }
}

// PC20 (2026-11-24, his: "can you hook that into cos superviser?"): each model's engine is a process COS's supervisor owns (started when asked,
// stopped when idle, restarted on a crash, stopped with COS), declared by the model server itself in its own declaration file, from its settings.
// The file holds this PC's paths, so it is written here on each PC and never committed.
let DECL = "inference/inference.cos"

/** the process name COS knows a model's engine by */
fn process_of(model: string): string {
  var out = ""
  for c in split(lower(model), "") {
    if index_of("abcdefghijklmnopqrstuvwxyz0123456789", c) >= 0 { out = out + c } else if len(out) > 0 and not (out ends_with "-") { out = out + "-" }
  }
  return "model-" + out
}

/** the model server's own declaration: one engine per model that is on */
fn declare(b: map, s: map): list {
  var ps = []
  for m in b.models {
    if has(s.models, m.name) and s.models[m.name].on {
      let ms = s.models[m.name]
      ps = push(ps, { name: process_of(m.name), model: m.name, cmd: b.engine, args: V.args_for(m.file, ms), healthUrl: "http://127.0.0.1:" + str(ms.port) + "/health", onDemand: true, optional: true, critical: false, phase: 5 })
    }
  }
  write_file(DECL, json({ type: "cos", about: "written by inference/inference.eg from its settings (PC20); this PC's paths: never committed", payload: { name: "inference", runtime: { processes: ps } } }))
  return ps
}

component Inference {
  id = "inference.server"
  namespace = "inference"
  version = "0.1.0"
  intent = "our own model server: the models on this PC, each with its own engine server and settings; reached only through these hooks"

  in settings(q: { home: string }) {
    let b = base(q.home)
    let s = S.merge(b.defaults, S.overrides(FILE))
    emit out answer { hook: "settings", ok: true, value: { settings: s, overrides: S.overrides(FILE), models: b.models, engine: b.engine, problems: S.problems(s) }, why: null }
  }

  in save(q: { home: string, change: map }) {
    let r = S.save(FILE, base(q.home).defaults, q.change)
    var why = null
    if not r.ok { why = join(r.problems, "; ") }
    emit out answer { hook: "save", ok: r.ok, value: r, why: why }
  }

  in models(q: { home: string }) {
    let b = base(q.home)
    emit out answer { hook: "models", ok: true, value: { models: b.models, engine: b.engine }, why: null }
  }

  // 2026-11-24 PC25 b, his: "i just want to get back to the pipeline". How one model's engine is started: the engine, its options from the
  // model's own settings (server.eg args_for) and its port. The model server's process (the bridge, which stays running) starts it; a hook is
  // a short process, and an engine started from it would hold COS's call open.
  in launch(q: { home: string, model: string }) {
    let b = base(q.home)
    let s = S.merge(b.defaults, S.overrides(FILE))
    var file = ""
    for m in b.models { if m.name == q.model { file = m.file } }
    if file == "" or not has(s.models, q.model) {
      emit out answer { hook: "launch", ok: false, value: null, why: "no model " + q.model + " in the model server's store" }
    } else if b.engine == "" {
      emit out answer { hook: "launch", ok: false, value: null, why: "no engine found (llama-server)" }
    } else {
      let ms = s.models[q.model]
      declare(b, s)
      emit out answer { hook: "launch", ok: true, value: { model: q.model, engine: b.engine, args: V.args_for(file, ms), port: ms.port, on: ms.on, process: process_of(q.model) }, why: null }
    }
  }

  out answer: { hook: string, ok: bool, value: any, why: any }
}
