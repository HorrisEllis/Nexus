// inference/cli.eg — the model server's CLI (as pillar/cli.eg is Pillar's): eg run inference/cli.eg registry | <in hook> <query JSON>
// It reaches the model server only through its hooks (the drawbridge, §5.16): a command sends to the in hook of the same name, the answer
// comes back on "inference.answer". `registry` prints its record and its hooks from Emerge's component registry, components(): what a caller
// (COS, RAID, a gate) may ask is read there, never known ahead. James Brooks, 2026-11-24: "also everything has to use the drawbridge".
use "./inference.eg" as inference

wire inference.Inference.answer -> "inference.answer"
var last = null
on "inference.answer" (a) { last = a }

fn own_record(): map {
  for c in components().components { if c.namespace == "inference" { return c } }
  return null
}

fn hooks(): list {
  let r = own_record()
  var out = []
  if r == null { return out }
  for h in components().hooks { if h.component_id == r.id { out = push(out, { name: h.name, direction: h.direction }) } }
  return out
}

let a = args()
var cmd = "registry"
if len(a) > 0 { cmd = a[0] }
var q = {}
if len(a) > 1 { q = parse_json(a[1]) }

if cmd == "registry" { print(json({ ok: true, hook: "registry", value: { record: own_record(), hooks: hooks() }, why: null })) }
else if cmd == "settings" { send inference.Inference.settings { home: q.home } }
else if cmd == "save" { send inference.Inference.save { home: q.home, change: q.change } }
else if cmd == "models" { send inference.Inference.models { home: q.home } }
else { print(json({ ok: false, hook: cmd, value: null, why: "no in hook " + cmd + "; ask registry for the hooks" })) }

if last != null { print(json(last)) }
