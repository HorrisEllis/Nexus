{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "guardian-gap",
  "title": "Guardian Gap",
  "description": "A detected incompleteness, tension, or unresolved question in AI output. GapHunter v3: 16 types, 60+ domains, 9 reasons. Single writer: GUARDIAN_GAPS WS messages via guardian/gap gate. Read by: cockpit gap panel, timeline, Nexus Cobalt gap-finder.",
  "$comment": "VERSION: 1.0.0 — §5.4. Mirrors schema.sql gaps table.",
  "type": "object",
  "required": ["id", "type", "score", "opened_ts"],
  "additionalProperties": false,
  "properties": {
    "id":           { "type": "string",  "description": "UUID" },
    "type": {
      "type": "string",
      "description": "GapHunter v3 gap type (16 types)",
      "enum": [
        "ASSUMPTION",
        "MISSING_CONTEXT",
        "UNDEFINED_TERM",
        "INCOMPLETE_REASONING",
        "UNVERIFIED_CLAIM",
        "SCOPE_BOUNDARY",
        "DEPENDENCY_UNKNOWN",
        "TEMPORAL_GAP",
        "CAUSAL_AMBIGUITY",
        "PRECISION_LOSS",
        "CONTRADICTION",
        "OMITTED_EDGE_CASE",
        "IMPLEMENTATION_GAP",
        "KNOWLEDGE_LIMIT",
        "CONFIDENCE_MISMATCH",
        "STRUCTURAL_GAP"
      ]
    },
    "domain": {
      "type": ["string", "null"],
      "description": "Domain where gap was detected. 60+ domains from GapHunter v3 taxonomy.",
      "examples": ["code", "ai_ml", "epistemological", "systems", "architecture", "security", "data", "ux", "business", "science", "legal", "math"]
    },
    "reason": {
      "type": ["string", "null"],
      "description": "WHY this gap exists — 9 existence reasons",
      "enum": [
        "TRAINING_CUTOFF",
        "CONTEXT_WINDOW_LIMIT",
        "AMBIGUOUS_PROMPT",
        "INSUFFICIENT_EVIDENCE",
        "DOMAIN_BOUNDARY",
        "GENUINE_UNCERTAINTY",
        "OMITTED_FOR_BREVITY",
        "STRUCTURAL_COMPLEXITY",
        "UNKNOWN"
      ]
    },
    "description": { "type": ["string", "null"], "description": "Human-readable gap description" },
    "score":        { "type": "number",  "minimum": 0, "maximum": 1, "description": "Gap magnitude: 0 = negligible, 1 = critical" },
    "status":       { "type": "string",  "enum": ["open", "narrowing", "widening", "closed", "ignored"], "default": "open" },
    "job_id":       { "type": ["string", "null"] },
    "chat_id":      { "type": ["string", "null"] },
    "session_id":   { "type": ["string", "null"] },
    "account":      { "type": ["string", "null"] },
    "provider":     { "type": ["string", "null"] },
    "evidence": {
      "type": "object",
      "default": {},
      "description": "What triggered this gap detection",
      "properties": {
        "text_sample": { "type": ["string", "null"] },
        "metric":      { "type": ["number", "null"] },
        "pattern":     { "type": ["string", "null"] }
      }
    },
    "opened_ts":    { "type": "integer" },
    "closed_ts":    { "type": ["integer", "null"] },
    "proof":        { "type": ["string", "null"], "description": "Human-provided closure proof" },
    "ignore_reason":{ "type": ["string", "null"] },
    "meta":         { "type": "object", "default": {} }
  }
}
