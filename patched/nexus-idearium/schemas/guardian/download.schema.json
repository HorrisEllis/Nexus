{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "guardian-download",
  "title": "Guardian Download",
  "description": "A file downloaded from an AI provider session. Captured by download intercept in userscript. Optionally auto-uploaded to Dropzone.",
  "$comment": "VERSION: 1.0.0 — §5.4. Mirrors schema.sql downloads table.",
  "type": "object",
  "required": ["id", "filename", "ts"],
  "additionalProperties": false,
  "properties": {
    "id":           { "type": "string" },
    "filename":     { "type": "string", "minLength": 1 },
    "href":         { "type": ["string", "null"], "description": "Original download URL" },
    "mime_type":    { "type": ["string", "null"] },
    "size":         { "type": ["integer", "null"], "minimum": 0, "description": "File size in bytes" },
    "chat_url":     { "type": ["string", "null"] },
    "chat_id":      { "type": ["string", "null"] },
    "account":      { "type": ["string", "null"] },
    "job_id":       { "type": ["string", "null"] },
    "session_id":   { "type": ["string", "null"] },
    "provider":     { "type": ["string", "null"] },
    "dropzone_url": { "type": ["string", "null"], "description": "URL on the Dropzone server after auto-upload" },
    "ts":           { "type": "integer" }
  }
}
