{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "idearium-repo",
  "title": "Idearium Repo",
  "description": "A named container for a set of ideas, specs, artifacts, and gaps. The idea-first equivalent of a Git repository. Compresses to a single .nex file for transport, archival, and restoration. Every repo has its own versionium timeline (snapshot history). Repos can be nested (a spec can become its own repo when it grows).",
  "$comment": "VERSION: 1.0.0 — §5.4.",
  "type": "object",
  "required": ["uuid", "name", "source", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "uuid":        { "type": "string" },
    "name":        { "type": "string", "minLength": 1, "description": "Repo name — url-safe slug preferred (e.g. rheon.world, nexus-guardian)" },
    "description": { "type": ["string", "null"] },
    "tags":        { "type": "array", "items": { "type": "string" }, "default": [], "description": "Top-level repo tags" },
    "phase": {
      "type": "string",
      "enum": ["active", "paused", "archived", "frozen"],
      "default": "active",
      "description": "active=live, paused=no new commits, archived=historical, frozen=.nex export only"
    },
    "ideaIds":     { "type": "array", "items": { "type": "string" }, "default": [], "description": "UUIDs of ideas belonging to this repo" },
    "specIds":     { "type": "array", "items": { "type": "string" }, "default": [], "description": "UUIDs of specs belonging to this repo" },
    "artifactIds": { "type": "array", "items": { "type": "string" }, "default": [], "description": "UUIDs of artifacts (Guardian captures) linked to this repo" },
    "gapIds":      { "type": "array", "items": { "type": "string" }, "default": [], "description": "UUIDs of open gaps in this repo" },
    "snapshots": {
      "type": "array",
      "default": [],
      "description": "Versionium snapshot history for this repo (the commit log)",
      "items": {
        "type": "object",
        "required": ["uuid", "hash", "message", "ts"],
        "properties": {
          "uuid":      { "type": "string" },
          "hash":      { "type": "string" },
          "message":   { "type": "string" },
          "tag":       { "type": ["string", "null"] },
          "nexFile":   { "type": ["string", "null"], "description": "Path to .nex file for this snapshot" },
          "ideaCount": { "type": "integer" },
          "specCount": { "type": "integer" },
          "gapCount":  { "type": "integer" },
          "snr":       { "type": "number" },
          "ts":        { "type": "integer" }
        }
      }
    },
    "nexFiles": {
      "type": "array",
      "default": [],
      "description": "Known .nex files associated with this repo",
      "items": {
        "type": "object",
        "required": ["name", "type", "ts"],
        "properties": {
          "name":    { "type": "string", "description": "Filename (e.g. system.nex, spec-001.nex)" },
          "type":    { "type": "string", "enum": ["SNAP", "BP", "CLIP"], "description": "NEX-SNAP|NEX-BP|NEX-CLIP" },
          "size":    { "type": ["integer", "null"], "description": "Bytes" },
          "hash":    { "type": ["string", "null"] },
          "source":  { "type": "string", "enum": ["dropzone", "local", "vortex-push", "import"], "default": "local" },
          "dropzoneUrl": { "type": ["string", "null"] },
          "ts":      { "type": "integer" }
        }
      }
    },
    "parentRepoId": { "type": ["string", "null"], "description": "For nested repos — parent repo UUID" },
    "nexusPort":    { "type": ["integer", "null"], "description": "Associated Nexus Cobalt port (default 3748)" },
    "guardianUrl":  { "type": ["string", "null"], "description": "Associated Guardian instance URL" },
    "causedBy":     { "type": ["string", "null"] },
    "source":       { "type": "string" },
    "createdAt":    { "type": "integer" },
    "updatedAt":    { "type": "integer", "default": 0 }
  }
}
