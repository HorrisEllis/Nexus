{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nexus-toast",
  "title": "NEXUS Toast",
  "description": "LAW VI: Every failure, every success, every significant state change MUST emit a toast. Toasts are the user's runtime nervous system. Silent = violation. Written by any module. Read by cockpit SSE → UI renderer.",
  "$comment": "VERSION: 1.0.0 — §5.4.",
  "type": "object",
  "required": ["uuid", "type", "module", "message", "ts"],
  "additionalProperties": false,
  "properties": {
    "uuid":      { "type": "string", "description": "UUID — permanent" },
    "type": {
      "type": "string",
      "description": "Toast type determines color and behavior",
      "enum": [
        "toast.error",    
        "toast.warn",     
        "toast.info",     
        "toast.success",  
        "toast.gap",      
        "toast.crystal",  
        "toast.snapshot", 
        "toast.agent",    
        "toast.boot"      
      ]
    },
    "module":    { "type": "string",  "description": "Module ID that emitted this toast (e.g. 'gate.gap-finder')" },
    "message":   { "type": "string",  "minLength": 1, "description": "Human-readable message — must include module name, operation, and relevant UUIDs" },
    "causedBy":  { "type": ["string", "null"], "description": "UUID of the JAA row or event that caused this toast" },
    "actions": {
      "type": "array",
      "default": [],
      "description": "Actionable CLI commands shown as toast buttons",
      "items": {
        "type": "object",
        "required": ["label", "command"],
        "properties": {
          "label":   { "type": "string" },
          "command": { "type": "string", "description": "nexus CLI command to execute" }
        }
      }
    },
    "autoClose": { "type": "integer", "minimum": 0, "default": 5000, "description": "ms before auto-dismiss. 0 = stays until manually dismissed (errors)." },
    "ts":        { "type": "integer" }
  },
  "definitions": {
    "color_map": {
      "description": "Toast type → display color",
      "type": "object",
      "properties": {
        "toast.error":    { "const": "RED",    "description": "Unrecoverable failure — action required immediately" },
        "toast.warn":     { "const": "AMBER",  "description": "Recoverable — logged, watch this" },
        "toast.info":     { "const": "BLUE",   "description": "Status update — no action needed" },
        "toast.success":  { "const": "GREEN",  "description": "Operation complete successfully" },
        "toast.gap":      { "const": "RED",    "description": "Gap detected — always has CLI action" },
        "toast.crystal":  { "const": "TEAL",   "description": "New crystal formed — memory stabilized" },
        "toast.snapshot": { "const": "GREY",   "description": ".nex snapshot written" },
        "toast.agent":    { "const": "PURPLE", "description": "Agent call dispatched or received" },
        "toast.boot":     { "const": "CYAN",   "description": "Service started or stopped" }
      }
    }
  }
}
