{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nexus-cobalt-module",
  "title": "NEXUS COBALT Module Declaration",
  "description": "Every module in NEXUS declares a COBALT record. This is the source of truth for: what the module does, what tables it reads/writes, what CLI commands it exposes, what events it emits, and what gaps it creates/fills. Written by each module's init(). Read by: cobalt-registry, CLI router, gap-finder, spec-builder.",
  "$comment": "VERSION: 1.0.0 — §5.4.",
  "type": "object",
  "required": ["id", "uuid", "file", "layer", "version", "intent", "reads", "writes"],
  "additionalProperties": false,
  "properties": {
    "id":      { "type": "string", "description": "Dot-namespaced module ID (e.g. 'gate.gap-finder', 'guardian.pulse')" },
    "uuid":    { "type": "string", "description": "Permanent UUID — never reuse, never change. Format: nexus-mod-<name>-<timestamp>" },
    "file":    { "type": "string", "description": "Absolute file path (__filename)" },
    "layer": {
      "type": "string",
      "enum": ["foundation", "core", "gate", "healer", "memory", "agent", "guardian", "signal", "idearium", "cognition", "automation", "playground", "ui"],
      "description": "Architectural layer — determines load order (§3.1 bottom-up)"
    },
    "version":   { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semver. Same as project version (§5.4)." },
    "intent":    { "type": "string", "description": "One sentence — what this module does. No weasel words." },
    "reads":     { "type": "array", "items": { "type": "string" }, "description": "JAA tables this module reads (§M2 compliance)" },
    "writes":    { "type": "array", "items": { "type": "string" }, "description": "JAA tables this module writes. No writes to tables not listed here." },
    "pollMs":    { "type": "integer", "minimum": 100, "description": "Default poll interval in ms. Can be overridden by poll-registry." },
    "bootPhase": { "type": "integer", "minimum": 0, "maximum": 20, "description": "Boot phase (0=system, 3=JAA, 8=agents, 11=guardian, 13=idearium, 15=cognition)" },
    "cli": {
      "type": "array",
      "default": [],
      "description": "CLI commands this module contributes. LAW V: every feature has a CLI command.",
      "items": {
        "type": "object",
        "required": ["command", "intent"],
        "properties": {
          "command":         { "type": "string", "description": "e.g. 'gap list'" },
          "args":            { "type": "array",  "items": { "type": "string" } },
          "flags":           { "type": "array",  "items": { "type": "string" } },
          "intent":          { "type": "string" },
          "emits":           { "type": "string", "description": "Event type emitted on execution" },
          "example":         { "type": "string" },
          "toastOnSuccess":  { "type": "string", "enum": ["toast.success", "toast.info"] },
          "toastOnFail":     { "type": "string", "enum": ["toast.error", "toast.warn"] }
        }
      }
    },
    "hooks": {
      "type": "object",
      "default": {},
      "description": "Event channels this module subscribes to → handler method name. No wildcards in hooks.",
      "additionalProperties": { "type": "string" }
    },
    "expectation": {
      "type": "object",
      "description": "Observable success/failure conditions for gap-finder",
      "properties": {
        "summary":          { "type": "string" },
        "successCondition": { "type": "string" },
        "failureCondition": { "type": "string" },
        "slaMs":            { "type": "integer", "description": "Max acceptable latency for this module's operation" }
      }
    },
    "gapContract": {
      "type": "object",
      "description": "What gap this module bridges, fills, and creates",
      "properties": {
        "bridges": { "type": "string" },
        "fills":   { "type": "string" },
        "creates": { "type": "string" }
      }
    },
    "registeredAt": { "type": "integer", "description": "Unix ms — set on insert" }
  }
}
