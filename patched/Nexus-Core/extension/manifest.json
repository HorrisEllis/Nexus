{
  "manifest_version": 3,
  "name": "NEXUS Guardian Bridge",
  "version": "1.0.0",
  "description": "Bridges NEXUS pipeline to browser AI services. Injects prompts, scrapes responses, observes usage signals.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],

  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:7771/*",
    "http://localhost:11434/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-scripts/injector.js", "content-scripts/scraper.js", "content-scripts/observer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content-scripts/injector.js", "content-scripts/scraper.js", "content-scripts/observer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-scripts/injector.js", "content-scripts/scraper.js", "content-scripts/observer.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "NEXUS Guardian"
  },

  "web_accessible_resources": [
    {
      "resources": ["popup/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
