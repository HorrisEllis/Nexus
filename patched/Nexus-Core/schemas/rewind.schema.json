{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "nexus/schemas/rewind.schema.json",
  "title": "NEXUS Module Rewind",
  "description": "Schema for a module rewind operation payload. §1.2: validated before fork.",
  "type": "object",
  "required": ["module", "tick", "found", "prefixes"],
  "additionalProperties": false,
  "properties": {
    "module": {
      "type": "string",
      "enum": ["manifest","raid","gate","healer","agent","guardian","crystalball","memory","automation","translation","index"],
      "description": "The module being rewound"
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "description": "Target tick to rewind to"
    },
    "found": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of events found in range"
    },
    "prefixes": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Event type prefixes matched for this module"
    },
    "fork": {
      "type": "boolean",
      "description": "Whether to re-run from this point"
    },
    "streamId": {
      "type": ["integer", "null"],
      "description": "Optional stream to scope the rewind"
    }
  }
}
