{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS Automation Schedule",
  "type": "object",
  "required": ["name","trigger","steps"],
  "properties": {
    "uuid":   { "type": "string" },
    "name":   { "type": "string", "minLength": 1 },
    "enabled":{ "type": "boolean" },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type":       { "type": "string", "enum": ["cron","interval","event","condition","chain","manual"] },
        "expression": { "type": "string" },
        "every":      { "type": "integer", "minimum": 100 },
        "channel":    { "type": "string" },
        "filter":     { "type": "string" },
        "check":      { "type": "string" },
        "checkEvery": { "type": "integer" },
        "after":      { "type": "string" },
        "onStatus":   {}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id","type"],
        "properties": {
          "id":      { "type": "string" },
          "type":    { "type": "string", "enum": ["emit","agent_call","loop","condition","store","memory","delay","notify","cli"] },
          "timeout": { "type": "integer" },
          "skip":    { "type": "boolean" },
          "continueOnFail": { "type": "boolean" }
        }
      }
    }
  }
}