{
  "id": "gate-healer-flow-v1",
  "module": "gate",
  "version": "1.0.0",
  "description": "When a gate fails, a healer must start. When healer starts, it must resolve or exhaust. No silent gaps.",
  "active": true,

  "flows": [
    {
      "id": "gate-fail-triggers-healer",
      "description": "gate.failed must be followed by healer.started within 2s",
      "trigger": { "channel": "gate.failed" },
      "expects": [
        {
          "channel": "gap.found",
          "withinMs": 500,
          "causallyLinked": true
        },
        {
          "channel": "healer.started",
          "withinMs": 2000,
          "causallyLinked": false
        }
      ],
      "totalWindowMs": 2500,
      "onViolation": {
        "emit": "gap.found",
        "severity": "high",
        "message": "gate.failed was not followed by healer.started — gap-finder may be broken or healer is not subscribed"
      },
      "tags": ["law-ii", "causal", "timing"]
    },
    {
      "id": "healer-must-resolve-or-exhaust",
      "description": "healer.started must be followed by healer.resolved or healer.exhausted within 30s",
      "trigger": { "channel": "healer.started" },
      "expects": [
        {
          "channel": "healer.resolved",
          "withinMs": 30000,
          "optional": true
        },
        {
          "channel": "healer.exhausted",
          "withinMs": 30000,
          "optional": true
        }
      ],
      "totalWindowMs": 30000,
      "onViolation": {
        "emit": "gap.found.fatal",
        "severity": "fatal",
        "message": "healer.started but neither healer.resolved nor healer.exhausted arrived within 30s — healer is stuck",
        "suppress": { "afterN": 3, "resetOnSuccess": true }
      },
      "tags": ["timing", "liveness"]
    },
    {
      "id": "healer-exhausted-escalates",
      "description": "healer.exhausted must be followed by a human escalation event",
      "trigger": { "channel": "healer.exhausted" },
      "expects": [
        {
          "channel": "nexus.human.escalation",
          "withinMs": 1000
        }
      ],
      "onViolation": {
        "emit": "gap.found",
        "severity": "high",
        "message": "healer.exhausted was not followed by escalation — human never notified"
      },
      "tags": ["escalation", "law-ii"]
    }
  ],

  "invariantChecks": [
    {
      "id": "gate-events-have-nodeId",
      "description": "Every gate.passed and gate.failed must have a nodeId in payload",
      "on": "gate.passed",
      "check": "payload.has_required_fields",
      "onFail": "gap.found"
    },
    {
      "id": "gate-failed-has-nodeId",
      "on": "gate.failed",
      "check": "payload.has_required_fields",
      "onFail": "gap.found"
    },
    {
      "id": "gap-found-has-uuid",
      "on": "gap.found",
      "check": "payload.has_uuid",
      "onFail": "gap.found.fatal"
    },
    {
      "id": "gap-found-valid-schema",
      "on": "gap.found",
      "check": "schema.valid",
      "schemaRef": "schemas/gap.schema.json",
      "onFail": "gap.found"
    }
  ]
}
