{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS Gap",
  "type": "object",
  "required": ["type", "path", "body", "severity"],
  "properties": {
    "uuid":       { "type": "string" },
    "type":       { "type": "string", "enum": ["missing","broken","shadow","weak"] },
    "path":       { "type": "string", "minLength": 1 },
    "body":       { "type": "string", "minLength": 1 },
    "severity":   { "type": "string", "enum": ["fatal","high","medium","low"] },
    "nodeId":     { "type": "string" },
    "manifestId": { "type": "string" },
    "status":     { "type": "string", "enum": ["open","filled","ignored","escalated"] },
    "causedBy":   { "type": ["string","null"] }
  }
}