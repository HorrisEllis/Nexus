{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS MCL Crystal",
  "type": "object",
  "required": ["uuid","state","coreEventId","stabilityScore"],
  "properties": {
    "uuid":               { "type": "string" },
    "state":              { "type": "string", "enum": ["candidate","stable"] },
    "coreEventId":        { "type": "string" },
    "coreEventType":      { "type": "string" },
    "stabilityScore":     { "type": "number", "minimum": 0, "maximum": 1 },
    "crossLaneCount":     { "type": "integer" },
    "recurrenceHalfLife": { "type": "number" },
    "feedbackAlignment":  { "type": "number" },
    "causalIntegration":  { "type": "number" },
    "contradictionScore": { "type": "number" },
    "accessCount":        { "type": "integer" },
    "fields":             { "type": "object" },
    "promotedAt":         { "type": ["number","null"] },
    "createdAt":          { "type": "number" }
  }
}