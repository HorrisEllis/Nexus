// automation-queue.eg — workflow queue manager
// UUID: automation-queue-v1-0-0 | source: automation/queue-manager.js
compartment "automation-queue" {
  id = automation-queue-001
  uuid = automation-queue-001-xxxx
  intent = manage_workflow_queue_priority_retry_backpressure
  reads  = [ workflow_runs schedules ]
  writes = [ workflow_runs event_log ]
  component "queue-manager" {
    interval = 1000
    // Schedule-triggered runs
    due_schedules = jaa.schedules where enabled and cron_matches_now
    for each sched in due_schedules
      insert jaa.workflow_runs { uuid = uid pipelineId = sched.pipelineId status = pending steps = sched.steps ts = now }
      record
    // Retry failed runs (max 3)
    failed_runs = jaa.workflow_runs where status == failed and retries < 3
    for each run in failed_runs
      update jaa.workflow_runs set status = pending retries = retries + 1
      record
  }
}
