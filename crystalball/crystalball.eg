// crystalball.eg — LatticeBridge + BEP + MCL + MQL wiring
// UUID: crystalball-v1-0-0 | source: crystalball/index.js
compartment "crystalball" {
  id = crystalball-001
  uuid = crystalball-001-xxxx
  intent = wire_lattice_bep_mcl_mql_onto_cobalt_bus
  component "boot" {
    on init
      lattice_bridge.attach(cobalt_bus)
      bep_engine.init(jaa cobalt_bus)
      mcl.init(jaa cobalt_bus lattice_bridge)
      mql.init(jaa cobalt_bus)
      emit "crystalball.ready"
      record
  }
}
