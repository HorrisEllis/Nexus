// bep-engine.eg — Behavioral Execution Pattern Engine
// UUID: bep-engine-v1-0-0 | source: crystalball/bep-engine.js
// BEP = code memory. Patterns carry behaviorGraph not just input/output.
// Reuse = skip Ollama. Mutation = send only delta. Partial = graph as scaffold.
compartment "bep-engine" {
  id = bep-engine-001
  uuid = bep-engine-001-xxxx
  intent = code_memory_behavior_graph_reuse_mutation_partial_scaffold
  reads  = [ agent_calls bep_patterns ]
  writes = [ bep_patterns event_log ]
  component "pattern-matcher" {
    input prompt
    tokens = tokenize(prompt)
    for each pattern in jaa.bep_patterns
      score = jaccard(tokens pattern.tokens)
      if score >= 0.7
        output pattern reason = "bep-match score=" + score
        record
    output null
    record
  }
  component "pattern-recorder" {
    on agent.call.complete {
      input call response
      graph = extract_behavior_graph(call response)
      hash = fnv1a(canonicalize(call.prompt))
      existing = jaa.bep_patterns.find(hash)
      if existing
        update jaa.bep_patterns set confidence = ema(existing.confidence 1.0) callCount = callCount + 1
      else
        insert jaa.bep_patterns { uuid = uid pattern = hash tokens = tokenize(call.prompt) behaviorGraph = graph confidence = 0.5 calltoId = call.uuid ts = now }
      record
    }
  }
}
