// mcl.eg — Memory Crystallization Layer
// UUID: mcl-v1-0-0 | source: crystalball/mcl.js
// Distills event streams into durable crystals.
compartment "mcl" {
  id = mcl-001
  uuid = mcl-001-xxxx
  intent = distill_event_streams_into_durable_crystals
  reads  = [ event_log agent_calls crystals ]
  writes = [ crystals event_log ]
  component "crystallizer" {
    interval = 60000
    sigma observe patterns = analyze_event_window(jaa.event_log.tail(500))
    for each pattern in patterns
      if pattern.confidence >= 0.7 and not already_crystallized(pattern)
        insert jaa.crystals { uuid = uid content = pattern.summary pattern_type = pattern.type source_ids = pattern.sources confidence = pattern.confidence state = candidate ts = now }
        emit "crystal.formed" { uuid = crystal.uuid type = pattern.type }
        record
  }
}
