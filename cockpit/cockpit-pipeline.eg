// cockpit-pipeline.eg — 14 node types + SEAM condition evaluator
// UUID: cockpit-pipeline-v1-0-0 | source: forge-pipeline.js
compartment "cockpit-pipeline" {
  id = cockpit-pipeline-001
  uuid = cockpit-pipeline-001-xxxx
  version = 1.0.0
  intent = pipeline_engine_14_node_types_safe_condition_evaluator_no_eval
  node_types { trigger condition transform api_call agent_call store emit loop delay seam_compile gap notify merge fork webhook_out }
  condition_evaluator {
    operators  = [ === !== < > <= >= && || ! ]
    ternary    = true dot_paths = true indexing = true
    methods    = [ includes startsWith endsWith indexOf length toString trim ]
    arithmetic = [ + - * / ]
    max_expr   = 2048 max_depth = 32 no_eval = true
  }
  component "runner" {
    input pipeline_id payload
    insert jaa.workflow_runs { pipelineId status = running startedAt = now }
    for each node in pipeline
      try
        result = dispatch_node(node context)
        context.outputs[node.id] = result
        insert jaa.pipeline_steps { nodeId status = complete output = result }
      else
        insert jaa.pipeline_steps { nodeId status = failed }
        insert jaa.failures
        if not node.continueOnError { break }
    update jaa.workflow_runs status = complete completedAt = now
    emit "pipeline.complete"
    record
  }
}
