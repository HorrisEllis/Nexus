// pillar/test/pillar.test.eg — PIL1_pillar_stands: Pillar stands, its registry lists what it offers (GATE-PIL1-002). eg test pillar/test/pillar.test.eg
use "../pillar.eg" as pillar
use "../registry.eg" as registry

test "the registry is Pillar's own" {
  expect registry.system == "pillar"
}

// A module is not a map in Emerge (has/keys refuse it), so the two-way check, registry ⇄ pillar.eg's top level, is test-pillar PI-02's,
// read with Emerge's own parser. Here: each registered name answers.
test "every registered export answers" {
  expect registry.names() == ["version", "contracts", "contract", "check", "identity_of"]
  expect pillar.version == "0.1.0"
  expect type_of(pillar.contracts()) == "list"
}

test "no contracts yet, and nothing pretends" {
  expect len(pillar.contracts()) == 0
  expect pillar.contract("pillar:constraint") == null
  expect not pillar.check("pillar:constraint", "x").ok
  expect not pillar.identity_of("pillar:constraint", "x").ok
}
