// userscript-artifact-store.eg — artifact capture + dedup + hash
// UUID: userscript-artifact-store-v1-0-0
compartment "userscript-artifact-store" {
  id = userscript-artifact-store-001
  uuid = userscript-artifact-store-001-xxxx
  intent = dedup_by_hash_store_500_max_auto_push_to_memory
  state { artifactStore = [] seenHashes = Set max = 500 }
  component "save" {
    on artifactSave {
      input entry
      if store.find hash == entry.hash { return null }
      full = { id = uid hash name type lang content context chatUrl chatId account jobId ts direction }
      store.unshift full
      if store.length > max { store.pop }
      if CFG.memory_auto_push { sendToMemory { type = ARTIFACT payload = full } }
      sisoEmit "guardian.artifact" full
      evLog "artifact.saved"
      toast "Artifact: " + name + " [" + lang + "]"
      output full
      record
    }
  }
}
