// userscript-tab-claim.eg — tab ownership + multi-tab coordination
// UUID: userscript-tab-claim-v1-0-0
compartment "userscript-tab-claim" {
  id = userscript-tab-claim-001
  uuid = userscript-tab-claim-001-xxxx
  intent = single_claimed_tab_receives_jobs_passive_tabs_ignore
  state { MY_TAB_ID = sessionStorage.TAB_ID CLAIM_KEY = guardian_claimed_tab_claude isClaimed = false }
  component "claim" {
    on claim    { localStorage.set CLAIM_KEY MY_TAB_ID isClaimed = true updateBadge emit "tab.claimed" record }
    on release  { if amIClaimed { localStorage.remove CLAIM_KEY } isClaimed = false updateBadge emit "tab.released" record }
    on auto-claim {
      existing = localStorage.get CLAIM_KEY
      if not existing  { claim record }
      if existing == MY_TAB_ID { isClaimed = true record }
      else { addLog "Another tab claimed — passive mode" record }
    }
  }
}
