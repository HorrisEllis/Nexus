// userscript-greeting.eg — session greeting + name watcher
// UUID: userscript-greeting-v1-0-0
compartment "userscript-greeting" {
  id = userscript-greeting-001
  uuid = userscript-greeting-001-xxxx
  intent = auto_inject_greeting_on_blank_chat_extract_session_name
  component "greeter" {
    on navigate {
      chatId = chatIdFromUrl()
      if chatId != home and chatId not_in greetedChats and isChatBlank
        wait CFG.greeting_delay_ms
        explicitInject(CFG.session_greeting_text greeting_job)
        greetedChats.add chatId
        watchForSessionName(chatId)
        record
    }
  }
  component "name-watcher" {
    input chatId
    poll every 500ms up to 60 attempts
    text = last_assistant_message
    if text matches /"([^"]{3,60})"/ or calling this (.+) or session: (.+)
      sessionName = match[1]
      apiPost /sessions/chatId/name { name = sessionName }
      sendToServerAndCortex { type = GUARDIAN_SESSION_NAMED chatId sessionName }
      emit "session.named" { name = sessionName }
      record
  }
}
