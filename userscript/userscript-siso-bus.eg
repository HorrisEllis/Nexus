// userscript-siso-bus.eg — BroadcastChannel SISO + seam channels
// UUID: userscript-siso-bus-v1-0-0
compartment "userscript-siso-bus" {
  id = userscript-siso-bus-001
  uuid = userscript-siso-bus-001-xxxx
  intent = broadcast_channel_siso_cross_tab_event_bus
  channels { sisoChannel = BroadcastChannel guardian-siso-v8 seamChannel = BroadcastChannel guardian-seam-v1 }
  component "emitter" {
    on sisoEmit { input type data try { sisoChannel.postMessage { type data ts = now provider = claude } } record }
    on seamEmit { input type data seamChannel.postMessage { type data ts = now } record }
  }
  component "listener" {
    seamChannel.onmessage {
      if type == chunk_verified { seamLoadState if seamTab { renderSeamTab } }
      if type == state_updated  { seamLoadState if seamTab { renderSeamTab } }
      record
    }
  }
}
