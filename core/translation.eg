// translation.eg — NL → intent IR + concept graph
// UUID: translation-v1-0-0 | source: core/translation/index.js
compartment "translation" {
  id = translation-001
  uuid = translation-001-xxxx
  intent = nl_to_intent_ir_concept_grounding_ambiguity_quantification
  reads  = [ agent_calls ]
  writes = [ agent_calls event_log ]
  component "translator" {
    input text context
    concepts = extract_concepts(text concept_graph)
    ambiguous = concepts.filter(c => c.ambiguous)
    if ambiguous.length > 0
      for each amb in ambiguous
        gap "ambiguous-term" { pressure = 0.6 description = amb.term }
    intent_ir = ground_concepts(concepts context)
    emit "translation.complete" { intentIr = intent_ir causality = causedBy }
    record
  }
  concept_graph {
    auth           = { resolves = authentication implies = [users sessions] ambiguous = false }
    fast           = { resolves = performance metric = latency target = null ambiguous = true }
    scalable       = { resolves = performance metric = throughput ambiguous = true }
  }
}
