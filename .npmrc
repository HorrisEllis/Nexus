# §2026-09-19 — James's Windows box has no Visual Studio C++ toolchain, so
# better-sqlite3's node-gyp postinstall fails. Before this file, that single
# native build aborted the ENTIRE install and npm rolled the tree back, so
# js-yaml never landed and guardian crashed 6/6 into the circuit breaker.
#
# better-sqlite3 is now an optionalDependency (package.json) — npm continues
# past a failed optional build instead of failing the whole install. This is
# not a workaround: the codebase already runs without it, and says so itself.
# guardian/jaa-store.js is a pure-JS store that mirrors better-sqlite3's call
# shapes; clear-glass/src/history/store.js's own header reads "better-sqlite3
# confirmed not installed". The only two real require() sites (clear-glass
# cookies/vault.js and downloads/artifact-chat-index.js) are try/catch-guarded
# and lazy respectively.
#
# omit=optional makes that explicit rather than relying on npm's tolerance.
# Drop this line (or run `npm i better-sqlite3`) once VS Build Tools are
# installed and you want the native path back.
omit=optional

# node-gyp prints its Visual Studio hunt as a wall of ERR! lines even when the
# build is optional and the install succeeds. Nothing is wrong; it is noise.
foreground-scripts=false
