// guardian-ir-layer.eg — Intent routing layer, ALL callto through here
// UUID: guardian-ir-layer-v1-0-0 | source: Guardian-v5/ir-layer.js
compartment "guardian-ir-layer" {
  id = guardian-ir-layer-001
  uuid = guardian-ir-layer-001-xxxx
  intent = all_callto_dispatch_must_go_through_ir_no_bypass
  route_types { nexus local mesh device analyze pipeline conditional custom }
  delivery_modes { fire_and_forget at_least_once exactly_once guarded_pipeline }
  callto_states { created routed dispatched in_transit acknowledged stored archived failed }
  callto_packet {
    id          = "callto-" + uid
    source      = guardian
    instanceId  = IR_STATE.instanceId
    intent      = capture or listen or inspect or forward or replay or analyze
    route       = RouteSpec
    delivery    = at_least_once
    payload     = frozen
    fingerprint = payload.fingerprint
    state       = created
    createdAt   = now
    ttl         = 30000
    retryCount  = 0
    routeTrace  = []
  }
  component "validate-route" {
    input spec
    if spec.type not_in route_types { gap "unknown-route-type" { pressure = 0.9 } }
    if spec.type == pipeline and steps.length == 0 { gap "empty-pipeline" { pressure = 0.8 } }
    record
  }
  component "dispatch" {
    input callto
    validate_route callto.route
    callto.state = dispatched
    callto.routeTrace.push { ts = now step = dispatch }
    if callto.route.type == nexus    { POST 3748/api/event callto.payload }
    if callto.route.type == local    { browser.storage.set callto }
    if callto.route.type == mesh     { nexusChannel.postMessage callto }
    if callto.route.type == device   { POST 3748/callto/instanceId callto }
    if callto.route.type == analyze  { cfr.ingest callto.payload }
    if callto.route.type == pipeline { execute_pipeline(callto.route.steps callto) }
    if callto.route.type == conditional { evaluate_rules(callto.route.rules callto) }
    if callto.route.type == custom   { callto.route.fn(callto) }
    callto.state = in_transit
    emit "ir.callto.dispatched"
    record
  }
}
