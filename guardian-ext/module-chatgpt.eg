// module-chatgpt.eg — chatgpt.com site module + CESL
// UUID: module-chatgpt-v1-0-0 | source: modules/chatgpt.js
compartment "module-chatgpt" {
  id = module-chatgpt-001
  uuid = module-chatgpt-001-xxxx
  intent = capture_chatgpt_responses_cesl_trace_stop_button_aware
  targets = [ chatgpt.com chat.openai.com ]
  selectors {
    message  = [data-message-author-role]
    stop     = [data-testid=stop-button]
    input    = #prompt-textarea
    send     = [data-testid=send-button]
  }
  component "observer" {
    dom_watch document.body
    on mutation {
      last = [data-message-author-role]:last
      text = last.innerText.trim()
      role = last.getAttribute(data-message-author-role)
      if text and text != last_message
        last_message = text
        event = role == assistant ? guardian.chat.response : guardian.chat.message
        emit event { text role provider = chatgpt conversationId = convId complete = role == assistant and not stop_button }
        if CFR { CFR.cesl.record({ type = observe provider = chatgpt } { type = Observe }) }
        record
    }
  }
}
