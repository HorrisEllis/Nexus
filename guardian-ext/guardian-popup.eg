// guardian-popup.eg — extension popup UI
// UUID: guardian-popup-v1-0-0 | source: Guardian-v5/popup.js
compartment "guardian-popup" {
  id = guardian-popup-001
  uuid = guardian-popup-001-xxxx
  intent = extension_popup_status_display_guardian_nexus_health
  layout {
    header   = { title = Guardian version status_dot }
    nexus    = { label = NEXUS tick uptime adminPort }
    guardian = { label = Guardian instances tabCount }
    actions  = { open_cockpit open_ide }
  }
  component "state" {
    channel.onmessage {
      if NEXUS_CORE_PULSE   { update nexus_status tick uptime }
      if NEXUS_CORE_OFFLINE { show_offline_indicator }
      if guardian.status    { update guardian_status }
      record
    }
  }
}
