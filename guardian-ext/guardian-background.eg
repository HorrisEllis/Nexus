// guardian-background.eg — WSS connection + NEXUS pulse polling
// UUID: guardian-background-v1-0-0 | source: Guardian-v5/background.js
compartment "guardian-background" {
  id = guardian-background-001
  uuid = guardian-background-001-xxxx
  intent = wss_7821_connection_nexus_3748_health_poll_tab_session_tracking
  state {
    sessions    = Map tabId -> session
    listeners   = Map listenerId -> config
    channel     = BroadcastChannel guardian-bridge
    nexusChannel = BroadcastChannel nexus-core
    bridgeUrl   = http://127.0.0.1:7820
    nexusUrl    = http://127.0.0.1:3748
  }
  component "nexus-poll" {
    interval = 8000
    try GET nexusUrl/health
    if ok { relay NEXUS_CORE_PULSE to popup via channel record }
    if stale > 25000 { channel.postMessage { type = NEXUS_CORE_OFFLINE } record }
  }
  component "tab-tracker" {
    on tab.created   { sessions.set tabId { sessionId = uid url ts = now } record }
    on tab.removed   { sessions.delete tabId record }
    on tab.activated { update session lastSeen = now record }
  }
}
