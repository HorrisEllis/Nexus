  invariants:
    - id: INV-compat
      says: every real v1 contract loads and stays v1
      check:
        gate: verify
    - id: INV-evidence
      says: missing proof is never a pass; a free sentence is unverifiable
      check:
        gate: verify
    - id: INV-invalidate
      says: a changed ref invalidates its gates and only their downstream
      check:
        gate: verify
