spec:
  meta:
    name:        reflection-engine
    version:     1.0.0
    foundation:  nexus-system-foundation@1.0.0
    uuid:        nexus-reflection-v1-0000-2026-0615-jamesbrooks-001
    purpose: >
      Phase C of the request handler. After execution.
      Not logging — reflection. Was this worth doing?
      Decision + reason + outcome. Not event streams.
      UNRESOLVED as first-class state.

  questions:
    - "Did it advance a goal?"
    - "Did it reduce friction or create future work?"
    - "Did it increase complexity?"
    - "Did it violate optimization targets?"

  strategic_memory:
    format: "decision + reason + outcome"
    not:    "event + event + event"
    note:   "Most memories are noise. Highest value is judgment trails."

  unresolved_state:
    description: "Insufficient evidence. Not failure. Not success."
    behavior: "held open in liminal space. system comfortable not knowing."
    note: "Reality contains insufficient evidence. Sovereign systems say so."

  phase: 11
