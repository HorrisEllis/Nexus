{
  "name": "bridge-node",
  "version": "1.4.0",
  "build": "1.3.0-NEXUS",
  "date": "2026-05-03",
  "description": "Bridge OS v1.4.0 \u2014 Cobalt Core + Key Rotation + Sovereignty Controls integrated",
  "author": "James Brooks \u2014 Erosmancer / SISO Development Co.",
  "axioms": [
    "Local first \u2014 all computation attempted locally before any cloud route",
    "Pulse authority \u2014 no state change valid unless emitted as immutable bus event",
    "Layer sovereignty \u2014 each module has exactly one job, never bleeds into another",
    "Constraint over code \u2014 behavior emerges from gates and fields, not conditionals",
    "Causal memory \u2014 every bus event ingested into 1M-entry causal ring buffer",
    "Identity is cryptographic \u2014 UUID = SHA256(Ed25519 pubKey), unforgeable",
    "Trust is earned \u2014 Bayesian per-peer scoring, Sybil-resistant, contradiction-detected",
    "Score alone never blocks \u2014 bridge-sngate requires a matching rule to deny"
  ],
  "boot": {
    "entrypoint": "index.js",
    "phases": [
      {
        "phase": 1,
        "name": "identity",
        "vital": true,
        "module": "bridge-identity",
        "desc": "Ed25519 keypair, UUID=SHA256(pubKey), keystore"
      },
      {
        "phase": 2,
        "name": "core",
        "vital": true,
        "module": "bridge-core + bridge-appid",
        "desc": "SISO bus, callto registry, node registry, AppID"
      },
      {
        "phase": 3,
        "name": "IME",
        "vital": true,
        "module": "bridge-IME",
        "desc": "behavioral memory, trust scoring, probationary ramp"
      },
      {
        "phase": 4,
        "name": "sngate",
        "vital": true,
        "module": "bridge-sngate",
        "desc": "three-state gate (allow/deny/observe), rule introspection"
      },
      {
        "phase": 5,
        "name": "bus+data",
        "vital": true,
        "module": "bridge-core/bus + bridge-data",
        "desc": "SISO bus live, universal intake pipeline"
      },
      {
        "phase": 6,
        "name": "heartbeat",
        "vital": true,
        "module": "bridge-heartbeat",
        "desc": "BPM tracker, UDP pulse :7777, liveness monitoring"
      },
      {
        "phase": 7,
        "name": "plugin",
        "vital": false,
        "module": "bridge-plugin",
        "desc": "WS gateway for Guardian/Tampermonkey"
      },
      {
        "phase": "7b",
        "name": "eros",
        "vital": false,
        "module": "eros-shim",
        "desc": "ErosmancerOS CDP shim"
      },
      {
        "phase": "7c",
        "name": "mesh",
        "vital": false,
        "module": "bridge-mesh + trust-mesh",
        "desc": "ECDH channels, Bayesian peer trust"
      },
      {
        "phase": "7d",
        "name": "magnet",
        "vital": false,
        "module": "bridge-magnet",
        "desc": "nexus:// URI cascade resolution"
      },
      {
        "phase": 8,
        "name": "causal",
        "vital": false,
        "module": "bridge-causal",
        "desc": "causal-nexus v5.0.1, 1M ring buffer, CQL, sigma"
      },
      {
        "phase": "9a",
        "name": "bayesian",
        "vital": false,
        "module": "bridge-bayesian",
        "desc": "Beta belief engine"
      },
      {
        "phase": "9b",
        "name": "ollama",
        "vital": false,
        "module": "bridge-ollama",
        "desc": "Ollama local LLM driver, bus-driven streaming"
      },
      {
        "phase": "9c",
        "name": "routing",
        "vital": false,
        "module": "bridge-routing",
        "desc": "TCP mesh router :3749"
      },
      {
        "phase": "9d",
        "name": "gateway",
        "vital": false,
        "module": "bridge-gateway",
        "desc": "HTTP API gateway :3748, rate limiting, CORS, proxy"
      },
      {
        "phase": "9e",
        "name": "canvas",
        "vital": false,
        "module": "bridge-canvas",
        "desc": "canvas state persistence"
      },
      {
        "phase": 10,
        "name": "http",
        "vital": true,
        "module": "unified route table",
        "desc": "HTTP server :3747, all routes mounted"
      }
    ]
  },
  "modules": {
    "bridge-identity": {
      "version": "2.0.0",
