// guardian-memory-7823.eg — memory server LAN :7823
// UUID: guardian-memory-7823-v1-0-0 | source: guardian-final/guardian-memory.js
compartment "guardian-memory-7823" {
  id = guardian-memory-7823-001
  uuid = guardian-memory-7823-001-xxxx
  intent = lan_accessible_memory_query_surface_shares_jaa_with_7820
  port { bind = 0.0.0.0 number = 7823 protocol = http }
  component "routes" {
    route POST /ingest      { input type payload source route to jaa insert emit guardian.memory record }
    route GET  /artifacts   { input limit query jaa.artifacts output json record }
    route POST /artifacts   { insert jaa.artifacts record }
    route GET  /memory      { input search limit query jaa.memory_index output json record }
    route POST /memory      { insert jaa.memory_index record }
    route GET  /crystals    { query jaa.crystals output json record }
    route GET  /gaps        { query jaa.gaps output json record }
    route GET  /ledger      { query jaa.ledger_entries output json record }
    route GET  /files       { query jaa.files output json record }
    route POST /upload      { input file drag_drop insert jaa.files emit guardian.file record }
    route GET  /status      { output jaa.counts json record }
    route GET  /sse         { output sse stream live_tail all_tables record }
    record
  }
}
