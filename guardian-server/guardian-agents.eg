// guardian-agents.eg — Guardian agent dispatcher
// UUID: guardian-agents-v1-0-0 | source: guardian-final/agents/index.js
compartment "guardian-agents" {
  id = guardian-agents-001
  uuid = guardian-agents-001-xxxx
  intent = dispatch_guardian_jobs_to_correct_agent_via_guardian_api
  component "dispatcher" {
    on GUARDIAN_JOB {
      input jobId provider prompt command
      agent_api = GuardianAPI({ port = 7820 })
      result = agent_api.dispatch(provider prompt { command timeout = 60000 })
      emit GUARDIAN_COMPLETE { jobId response = result }
      record
    }
  }
}
