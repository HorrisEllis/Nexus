// guardian-dropzone-7822.eg — dropzone file server :7822
// UUID: guardian-dropzone-7822-v1-0-0 | source: guardian-final/dropzone.js
compartment "guardian-dropzone-7822" {
  id = guardian-dropzone-7822-001
  uuid = guardian-dropzone-7822-001-xxxx
  intent = lan_file_server_drag_drop_upload_token_based_download
  port { bind = 0.0.0.0 number = 7822 protocol = http }
  component "routes" {
    route GET  /                  { output dropzone_html record }
    route POST /api/upload        { input file multer insert jaa.files emit guardian.file output { token url size } record }
    route GET  /api/files         { query jaa.files output json record }
    route GET  /d/:token          { get jaa.files serve file record }
    route DELETE /api/files/:token { archive jaa.files record }
    route POST /api/files/:token/tags { update jaa.files.tags record }
    route GET  /api/specs         { query jaa.files where type = spec output json record }
    route POST /api/spec          { input spec_text insert jaa.files type=spec record }
    route POST /api/paste         { input text insert jaa.files type=paste record }
    record
  }
}
