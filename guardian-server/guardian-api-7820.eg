// guardian-api-7820.eg — Guardian HTTP API all routes
// UUID: guardian-api-7820-v1-0-0 | source: server-v9.js HTTP routes
compartment "guardian-api-7820" {
  id = guardian-api-7820-001
  uuid = guardian-api-7820-001-xxxx
  port { bind = 127.0.0.1 number = 7820 protocol = http }
  component "routes" {
    route POST /command           { input provider command prompt content creates job dispatches via wss record }
    route GET  /status/:jobId     { get jaa.jobs output json record }
    route GET  /response/:jobId   { get jaa.jobs output response json record }
    route GET  /stream/:jobId     { output sse stream chunks record }
    route GET  /jobs              { input status provider limit query output json record }
    route DELETE /jobs/:jobId     { archive record }
    route GET  /log               { input limit query jaa.jobs output json record }
    route GET  /providers         { output provider_connection_status json record }
    route GET  /artifacts         { input lang chatId account limit after q output json record }
    route GET  /artifacts/:hash   { get jaa.artifacts output json record }
    route POST /artifacts         { insert emit guardian.artifact record }
    route DELETE /artifacts/:hash { archive record }
    route PUT  /artifacts/:hash/tags { update tags record }
    route GET  /gaps              { input type domain status limit output json record }
    route GET  /gaps/summary      { output { total byType drift velocity } record }
    route GET  /gaps/catalogue    { output gap_taxonomy record }
    route POST /gaps/:id/close    { update status=closed record }
    route POST /gaps/:id/ignore   { update status=ignored record }
    route GET  /gap-questions     { input status output json record }
    route GET  /ledger            { input category limit after output json record }
    route GET  /ledger/metrics    { output { total upgrades ideas gaps } record }
    route POST /ledger            { insert emit guardian.ledger record }
    route GET  /sessions          { input account provider limit output json record }
    route GET  /sessions/:id      { get output json record }
    route POST /sessions/:id/name { update emit guardian.session record }
    route GET  /sessions/:id/timeline { get jaa.timeline_events output json record }
    route GET  /timeline          { input personId channel from to output json record }
    route GET  /memory/query      { input q search jaa.memory_index output json record }
    route GET  /memory/context    { input chatId output composite json record }
    route GET  /memory/stats      { output { tables rowCounts storeDir } record }
    route POST /memory/ingest     { input type payload source emit guardian.memory record }
    route GET  /settings          { output json record }
    route GET  /settings/:key     { get output json record }
    route PUT  /settings/:key     { update emit guardian.setting record }
    route POST /settings/reset    { reset to defaults emit guardian.setting record }
    route GET  /pa                { input limit chatId output json record }
    route GET  /pa/:id            { get output json record }
    route GET  /cockpit           { output cockpit_html record }
    route GET  /events            { output sse stream all_events record }
    route GET  /health            { output { ok uptime jobs providers wsClients } record }
    route POST /api/complete      { forward to 3748/api/complete record }
    record
  }
}
