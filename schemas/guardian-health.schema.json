{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NEXUS Guardian Health Schema",
  "$comment": "VERSION: 5.1.0 — §5.4. Covers guardian_health table. Written by watchman.js every 5s.",
  "type": "object",
  "required": ["uuid", "connected", "listenerCount", "sessionCount", "healthScore", "ts", "source"],
  "additionalProperties": true,
  "properties": {
    "uuid":          { "type": "string", "minLength": 1 },
    "connected":     { "type": "boolean" },
    "listenerCount": { "type": "integer", "minimum": 0 },
    "sessionCount":  { "type": "integer", "minimum": 0 },
    "staleNodes":    {
      "type": "array",
      "items": { "type": "string" },
      "description": "instanceIds of stale nodes (no heartbeat >25s)"
    },
    "lostListeners": {
      "type": "array",
      "items": { "type": "string" },
      "description": "instanceIds that lost listeners since last poll"
    },
    "healthScore":   { "type": "number", "minimum": 0, "maximum": 1 },
    "ts":            { "type": "integer" },
    "source":        { "type": "string" },
    "causedBy":      { "type": ["string", "null"] }
  }
}
