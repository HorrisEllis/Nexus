  fields:
    uuid:
      type: string
      required: true
      description: real row id
    signature:
      type: string
      required: true
      description: real pair/sequence this pattern represents
    patternType:
      type: string
      required: true
      description: >-
        'cross_system_causal' | 'co_occurrence' | others per scan type (see intelligence/index.js's
        real scan functions)
    typeA:
      type: string
      required: true
      description: real event type
    typeB:
      type: string
      required: true
      description: real event type
    systemA:
      type: string
      required: false
      description: real originating system, null if not applicable
    systemB:
      type: string
      required: false
      description: real originating system, null if not applicable
    crossSystem:
      type: boolean
      required: true
      description: real flag for whether typeA/typeB span two different systems
    count:
      type: number
      required: true
      description: real, observed occurrence count
    confidence:
      type: number
      required: true
      description: real 0..1, count-derived, not independently modeled
    description:
      type: string
      required: true
      description: real, human-readable summary, generated at write time
    actionable:
      type: boolean
      required: true
      description: real flag
    crystallised:
      type: boolean
      required: true
      description: real flag — crosses the real threshold for this pattern type
    noiseTainted:
      type: boolean
      required: true
      description: real suppression flag, set when a pattern is statistically noise, not signal
    source:
      type: string
      required: true
      description: real writing module id
    ts:
      type: number
      required: true
      description: real epoch ms
