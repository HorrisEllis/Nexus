// agent-gemini.eg — Gemini selectors and URCK surface
// UUID: agent-gemini-v1-0-0 | source: Nexus-Core agents/gemini/selectors.js
compartment "agent-gemini" {
  id = agent-gemini-001
  uuid = agent-gemini-001-xxxx
  intent = gemini_ui_selectors_and_adversarial_test_routing
  selectors {
    input   = .ql-editor
    submit  = button[aria-label="Send message"]
    output  = .response-content
    loading = .loading-indicator
  }
  routing { purpose = adversarial_testing priority = 3 }
}
