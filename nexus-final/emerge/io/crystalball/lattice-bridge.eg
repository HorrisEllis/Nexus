// lattice-bridge.eg — entity index + wildcard bus subscriber
// UUID: lattice-bridge-v1-0-0 | source: crystalball/lattice-bridge.js
compartment "lattice-bridge" {
  id = lattice-bridge-001
  uuid = lattice-bridge-001-xxxx
  intent = entity_index_from_all_bus_events_wildcard_subscriber
  reads  = [ event_log memory_index ]
  writes = [ memory_index ]
  component "indexer" {
    on cobalt_bus.** {
      input event
      entities = extract_entities(event.payload)
      for each entity in entities
        index.set(entity event.uuid)
      record
    }
  }
  component "entity-query" {
    input term output index.get(term) record
  }
}
