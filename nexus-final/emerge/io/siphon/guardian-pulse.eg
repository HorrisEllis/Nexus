// guardian-pulse.eg — heartbeats → live node topology
// UUID: guardian-pulse-v1-0-0
compartment "guardian-pulse" {
  id = guardian-pulse-001
  uuid = guardian-pulse-001-xxxx
  intent = build_live_guardian_node_topology_detect_stale_at_25s
  reads  = [ event_log ]
  writes = [ guardian_nodes event_log ]
  stale_threshold = 25000
  component "topology" {
    interval = 3000
    for each hb in jaa.event_log.query(type == guardian.heartbeat)
      upsert jaa.guardian_nodes { uuid = hb.payload.instanceId lastSeen = hb.ts capabilities = hb.payload.capabilities tabCount listenerCount }
      record
    stale = jaa.guardian_nodes.query(now - lastSeen > stale_threshold)
    for each node in stale
      insert jaa.event_log { type = guardian.node.stale payload = { instanceId = node.instanceId } source = pulse ts = now }
      emit "nexus-core" NEXUS_CORE_OFFLINE { instanceId = node.instanceId }
      record
  }
}
