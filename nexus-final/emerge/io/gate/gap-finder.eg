// gap-finder.eg — stale/stuck/recurring gap detection
// UUID: gap-finder-v1-0-0 | source: gate/gap-finder.js
compartment "gap-finder" {
  id = gap-finder-001
  uuid = gap-finder-001-xxxx
  intent = detect_stale_stuck_recurring_write_to_gaps_once_deduped
  reads  = [ project_registry agent_calls failures ]
  writes = [ gaps event_log ]
  stale_ms   = 60000
  stuck_ms   = 35000
  recurring_n = 3
  component "scanner" {
    interval = 2000
    // Stale modules
    for each mod in jaa.project_registry
      if now - mod.lastSeenAt > stale_ms and mod.status != stale
        if not jaa.gaps.find(path = "modules/" + mod.name type = stale_module)
          insert jaa.gaps { uuid = uid path = "modules/" + mod.name type = stale_module severity = medium body = mod.name + " silent " + elapsed(mod.lastSeenAt) status = pending source = gap-finder causedBy = mod.uuid ts = now }
          record
    // Stuck calls
    for each call in jaa.agent_calls where status == processing and elapsed > stuck_ms
      if not jaa.gaps.find(path = "agent_calls/" + call.uuid type = stuck_call)
        insert jaa.gaps { uuid = uid path = "agent_calls/" + call.uuid type = stuck_call severity = high body = "stuck " + elapsed(call.startedAt) + "s" status = pending source = gap-finder causedBy = call.uuid ts = now }
        record
    // Recurring failures
    sources = group_by_source(jaa.failures.tail(50))
    for each source in sources where count >= recurring_n
      if not jaa.gaps.find(path = source type = recurring_failure)
        insert jaa.gaps { uuid = uid path = source type = recurring_failure severity = high body = source + " failed " + count + "x" status = pending source = gap-finder ts = now }
        record
  }
}
