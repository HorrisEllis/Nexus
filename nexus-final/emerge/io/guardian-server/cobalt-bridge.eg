// cobalt-bridge.eg — Guardian 7820 ↔ Nexus Cortex 3748 bridge
// UUID: cobalt-bridge-v1-0-0
compartment "cobalt-bridge" {
  id = cobalt-bridge-001
  uuid = cobalt-bridge-001-xxxx
  intent = forward_all_guardian_events_to_cortex_3748_fire_and_forget
  component "forwarder" {
    on guardian.job.complete { POST 3748/guardian/event record }
    on guardian.artifact     { POST 3748/guardian/event record }
    on guardian.gap          { POST 3748/guardian/event record }
    on guardian.session      { POST 3748/guardian/event record }
    on guardian.input        { POST 3748/guardian/event record }
    on guardian.ledger       { POST 3748/guardian/event record }
    on any_guardian_event    { POST 3748/guardian/event fire_and_forget record }
    record
  }
}
