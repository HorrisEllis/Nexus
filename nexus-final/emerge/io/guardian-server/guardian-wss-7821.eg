// guardian-wss-7821.eg — Guardian WSS provider channel
// UUID: guardian-wss-7821-v1-0-0 | source: server-v9.js WSS handler
compartment "guardian-wss-7821" {
  id = guardian-wss-7821-001
  uuid = guardian-wss-7821-001-xxxx
  port { bind = 127.0.0.1 number = 7821 protocol = wss }
  component "provider-channel" {
    on GUARDIAN_REGISTER      { validate register emit GUARDIAN_READY insert jaa.sessions record }
    on GUARDIAN_HEARTBEAT     { emit GUARDIAN_HEARTBEAT_ACK record }
    on GUARDIAN_DELIVERED     { update jaa.jobs status=delivered record }
    on GUARDIAN_CHUNK         { update jaa.jobs streaming=true broadcast_sse record }
    on GUARDIAN_COMPLETE      {
      update jaa.jobs status=complete
      emit guardian.job
      POST 3748/guardian/event
      record
    }
    on GUARDIAN_ARTIFACT      { emit guardian.artifact insert jaa.artifacts record }
    on GUARDIAN_FILE_UPLOAD   { emit guardian.file save dropzone record }
    on GUARDIAN_LEDGER_EVENT  { emit guardian.ledger insert jaa.ledger_entries record }
    on GUARDIAN_ERROR         { update jaa.jobs status=failed insert jaa.failures record }
    on GUARDIAN_PA_SESSION    { insert jaa.pa_sessions emit guardian.pa record }
    on GUARDIAN_GAPS          { for each gap insert jaa.gaps emit guardian.gap record }
    on GUARDIAN_DOM_SYSTEMS   { insert jaa.event_log record }
    on GUARDIAN_DOWNLOAD      { insert jaa.downloads emit guardian.download record }
    on GUARDIAN_SESSION_NAMED { update jaa.sessions emit guardian.session record }
    on GUARDIAN_QUEUE_EVENT   { POST 4800/api/queue/progress record }
    on GUARDIAN_INPUT         {
      insert jaa.ledger_entries { category = INPUT }
      emit GUARDIAN_INPUT_ACK { jobId status = pending }
      channel.keep_open jobId
      POST 3748/guardian/event { type = guardian.input }
      record
    }
    on GUARDIAN_DONE          {
      channel.close jobId
      POST 3748/guardian/event { type = guardian.job.done }
      record
    }
    record
  }
}
