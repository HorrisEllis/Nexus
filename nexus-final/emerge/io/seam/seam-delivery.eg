// seam-delivery.eg — chunk delivery + retry + escalate
// UUID: seam-delivery-v1-0-0
compartment "seam-delivery" {
  id = seam-delivery-001
  uuid = seam-delivery-001-xxxx
  intent = deliver_spec_chunks_via_guardian_seam_contract_checkpoints
  component "deliverer" {
    on deliver {
      input chunk_idx provider
      chunk = seamState.chunks[chunk_idx]
      prompt = spec_parser.prompt_builder(chunk chunk_idx total sysKey)
      discover_tab(provider)
      explicitInject(prompt job_id)
      update chunk.status = injected deliveredAt = now
      watch_response(job_id)
      record
    }
  }
  component "verifier" {
    on response {
      input response job_id
      verdict = seam_verdict_detector.detect(response)
      if verdict == pass
        update chunk.status = verified verifiedAt = now
        POST 4800/api/queue/progress { state = VERIFIED }
        POST 3748/api/event { type = seam.chunk.verified }
        if auto_inject { after 2000ms deliver(next_pending) }
        record
      if verdict == fail
        if retries < max_retries { deliver_retry }
        else { POST 4800/api/gaps escalate record }
      if verdict == null
        update chunk.status = pending
        record
    }
  }
}
