// module-claude.eg — claude.ai site module + CESL tracing
// UUID: module-claude-v1-0-0 | source: modules/claude.js
compartment "module-claude" {
  id = module-claude-001
  uuid = module-claude-001-xxxx
  intent = capture_claude_responses_cesl_trace_streaming_aware
  targets = [ claude.ai ]
  selectors {
    response  = .font-claude-message
    streaming = [data-is-streaming]
    input     = [contenteditable=true]
    send      = button[data-testid=send-button]
  }
  component "observer" {
    dom_watch document.body
    on mutation {
      text = .font-claude-message:last.innerText.trim()
      isStreaming = !!document.querySelector([data-is-streaming])
      if text and text != last_text and text.length > 10
        last_text = text
        emit "guardian.chat.response" { text role = assistant provider = claude conversationId complete = not isStreaming }
        if CFR { CFR.cesl.record({ type = observe provider = claude gate = chat } { type = Observe eventType = chat.response }) }
        record
    }
  }
}
