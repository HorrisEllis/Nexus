// userscript-snr-detector.eg — sigma + delta + truncation
// UUID: userscript-snr-detector-v1-0-0
compartment "userscript-snr-detector" {
  id = userscript-snr-detector-001
  uuid = userscript-snr-detector-001-xxxx
  intent = composite_sigma_delta_truncation_score_threshold_0_35
  weights { truncation = 0.5 sigma = 0.3 delta = 0.2 threshold = 0.35 }
  component "truncation" {
    if response.length < 40 { output { truncated = true reason = empty_or_tiny score = 1.0 } }
    if lastLine not ends_with [.!?:)\]'"] and lastLine.length < 80 { output { truncated = true reason = mid_sentence_end } }
    if response.length < profile.minResponseChars { output { truncated = true reason = too_short } }
    if profile.hasSeamContract and not /SEAM VERDICT/i { output { truncated = true reason = missing_seam_verdict } }
    output { truncated = false score = 0 }
  }
  component "sigma" {
    if expected_code_blocks > 0 and actual == 0 { score += 0.3 }
    if ratio < 0.3 { score += 0.25 }
    if lexical_diversity < 0.25 { score += 0.2 }
    if hedge_rate > 0.08 { score += 0.15 }
    if musts > 2 and no_action_verbs { score += 0.2 }
    output { score deviating = score >= 0.4 signals }
  }
  component "delta" {
    for each axiom { if axiom starts_with ! and response contains { score += 0.35 } else if not contains { score += 0.2 } }
    if keyword_coverage < 0.4 { score += coverage * 0.3 }
    if stubs > 0 { score += min(0.4 stubs * 0.12) }
    output { score deviating = score >= 0.35 issues }
  }
  component "evaluate" {
    composite = truncation.score * 0.5 + sigma.score * 0.3 + delta.score * 0.2
    passed = composite < 0.35 and not truncation.truncated
    output { passed composite truncation sigma delta summary }
  }
}
