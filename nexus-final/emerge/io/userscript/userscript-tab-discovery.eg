// userscript-tab-discovery.eg — find or auto-open agent tab
// UUID: userscript-tab-discovery-v1-0-0
compartment "userscript-tab-discovery" {
  id = userscript-tab-discovery-001
  uuid = userscript-tab-discovery-001-xxxx
  intent = claim_existing_tab_or_open_new_one_for_provider
  component "discovery" {
    on discoverOrOpenTab {
      input provider
      if isClaimed { output true record }
      if localStorage[claimKey] exists { output false record }
      if location.hostname == providerHostname(provider) { claimTab output true record }
      // No tab found — open one
      addLog sys "Opening tab for " + provider
      toast "Opening " + provider + " tab..."
      url = providerUrl(provider)
      window.open url "_guardian_" + provider
      wait 3000
      output false record
    }
  }
  provider_map {
    claude    = https://claude.ai/new
    chatgpt   = https://chat.openai.com/
    gemini    = https://gemini.google.com/
    ollama    = http://localhost:11434
  }
}
