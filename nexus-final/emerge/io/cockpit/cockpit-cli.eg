// cockpit-cli.eg — CLI interaction contract, same hooks as UI
// UUID: cockpit-cli-v1-0-0 | source: forge-cli.js
compartment "cockpit-cli" {
  id = cockpit-cli-001
  uuid = cockpit-cli-001-xxxx
  version = 1.0.0
  intent = cli_same_hooks_as_ui_me2_all_commands_via_siso_bus
  interaction_contract {
    version = 1.0.0
    name    = forge-cli
    uuid    = forge-cli-contract-0003-2026-0530-jamesbrooks
  }
  component "commands" {
    on "forge pipeline list"       { GET /api/pipelines record }
    on "forge pipeline create"     { input name POST /api/pipelines record }
    on "forge pipeline run"        { input id payload POST /api/pipelines/id/run record }
    on "forge pipeline add-node"   { input pid type config POST /api/pipelines/pid/nodes record }
    on "forge pipeline connect"    { input pid from to condition POST /api/pipelines/pid/edges record }
    on "forge pipeline arm"        { input id PUT /api/pipelines/id/arm record }
    on "forge pipeline disarm"     { input id PUT /api/pipelines/id/disarm record }
    on "forge seam compile"        { input file emit "seam.compile" record }
    on "forge seam validate"       { input file emit "seam.validate" record }
    on "forge idea list"           { GET /api/ideas record }
    on "forge idea create"         { input title POST /api/ideas record }
    on "forge gap list"            { GET /api/gaps record }
    on "forge gap resolve"         { input id resolution POST /api/gaps/id/resolve record }
    on "forge snapshot create"     { input message POST /api/snapshots record }
    on "forge trust list"          { GET /api/trust record }
    on "forge guardian dispatch"   { input provider prompt POST /api/guardian/dispatch record }
    on "forge idearium health"     { GET 4800/health record }
    on "forge bus emit"            { input channel payload emit channel payload record }
    on "forge bus history"         { GET /api/bus/history record }
    on "forge jaa stats"           { GET /api/jaa/stats record }
    on "forge jaa query"           { input table GET /api/jaa/table record }
    on "forge help"                { output command_list record }
    record
  }
}
