// cfr-render.eg — Canvas2D render loop
// UUID: cfr-render-v1-0-0 | source: canvas/spec-a/cfr-render.js
compartment "cfr-render" {
  id = cfr-render-001
  uuid = cfr-render-001-xxxx
  intent = canvas2d_perspective_render_loop_particle_world
  component "renderer" {
    on draw { input particles ctx W H project_3d_to_2d(particles) draw_points fade_trail record }
    on resize { input w h update canvas.width canvas.height record }
  }
}
