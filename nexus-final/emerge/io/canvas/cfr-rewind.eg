// cfr-rewind.eg — time rewind scrubber
// UUID: cfr-rewind-v1-0-0 | source: canvas/spec-a/cfr-rewind.js
compartment "cfr-rewind" {
  id = cfr-rewind-001
  uuid = cfr-rewind-001-xxxx
  intent = record_frames_allow_scrub_rewind_to_any_point
  state { frames = Ring(300) recording = true }
  component "recorder" {
    on step { if recording { frames.push snapshot_state } record }
    on scrub { input t restore_state(frames[t]) record }
    on play  { recording = true record }
    on pause { recording = false record }
  }
}
