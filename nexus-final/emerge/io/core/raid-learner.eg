// raid-learner.eg — routing weight learner from outcomes
// UUID: raid-learner-v1-0-0 | source: core/raid/learner.js
compartment "raid-learner" {
  id = raid-learner-001
  uuid = raid-learner-001-xxxx
  intent = update_agent_weights_from_call_outcomes
  reads  = [ agent_calls feedback_scores ]
  writes = [ feedback_scores bep_patterns ]
  component "learner" {
    interval = 10000
    query jaa.agent_calls where status == complete and learned == false limit 50
    for each call in calls
      trust.record(call.routedTo passed = call.success)
      update jaa.agent_calls set learned = true
      record
  }
}
