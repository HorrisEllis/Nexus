// raid-weights.eg — agent routing weight tables
// UUID: raid-weights-v1-0-0 | source: core/raid/weights.js
compartment "raid-weights" {
  id = raid-weights-001
  uuid = raid-weights-001-xxxx
  intent = trust_band_to_routing_weight_table
  weights {
    wilson_0_00_0_35 = 0.2
    wilson_0_35_0_60 = 0.6
    wilson_0_60_0_80 = 1.0
    wilson_0_80_1_00 = 1.2
    cold_start       = 0.2
    confidence_n_min = 5
  }
  on weight.lookup { input agentId output bayesian_trust.weight(agentId) record }
}
