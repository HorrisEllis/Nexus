// idearium-core.eg — IdeaOS + tension engine + SNR
// UUID: idearium-core-v1-0-0 | source: idearium/core/index.js
compartment "idearium-core" {
  id = idearium-core-001
  uuid = idearium-core-001-xxxx
  version = 2.0.0
  port { bind = 127.0.0.1 number = 4800 protocol = http }
  intent = idea_os_every_idea_is_jaa_node_with_tension_and_spec
  phases  { seed expanding tensioned specced building complete archived }
  tension_engine {
    gap_density      = 0.30
    contradiction    = 0.25
    novelty          = 0.20
    resource_cost    = 0.15
    dependency_depth = 0.10
  }
  snr_weights {
    idea.created  = 0.9  spec.created = 0.95 spec.built = 1.0
    gap.resolved  = 0.85 push.complete = 0.95 idea.tensioned = 0.7
    guardian.health = 0.15
  }
  jaa { backend = jsonl tables = { ideas specs gaps snapshots links idea_links } }
}
