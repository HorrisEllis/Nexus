// cobalt-watchdog.eg — Silence detector
// UUID: cobalt-watchdog-v1-0-0 | source: foundation/cobalt-core.js
compartment "cobalt-watchdog" {
  id = cobalt-watchdog-001
  uuid = cobalt-watchdog-001-xxxx
  intent = detect_bus_silence_emit_gap_after_threshold
  component "watchdog" {
    state { lastActivity = now threshold = 30000 }
    interval = 5000
    on bus.ingest { lastActivity = now record }
    on tick {
      if now - lastActivity > threshold
        gap "cobalt-silence" { pressure = 0.8 }
        emit "cobalt.watchdog.silence"
        record
    }
  }
}
