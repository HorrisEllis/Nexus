// siso-gate.eg — SISOGate primitive
// UUID: siso-gate-v1-0-0 | source: foundation/siso/Gate.js
compartment "siso-gate" {
  id = siso-gate-001
  uuid = siso-gate-001-xxxx
  intent = named_typed_event_transformer_with_match_function
  invariant { axiom NO_SILENT_DROP if signature.collision { gap "gate-collision" { pressure = 1.0 } } }
  component "gate" {
    fields { signature = string matchFn = function transformFn = function }
    on matches { input event output bool record }
    on transform { input event stream if matches(event) { apply transformFn(event stream) } record }
  }
}
