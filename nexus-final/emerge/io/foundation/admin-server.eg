// admin-server.eg — HTTP+SSE admin server on 3748
// UUID: admin-server-v1-0-0 | source: foundation/admin-server.js
compartment "admin-server" {
  id = admin-server-001
  uuid = admin-server-001-xxxx
  intent = http_sse_admin_surface_3748_zero_deps
  port { bind = 127.0.0.1 number = 3748 protocol = http }
  component "routes" {
    route GET  /health               { output { status ok uptime jaa.counts cobalt.stats } json record }
    route GET  /api/ring             { input n output cobalt_bus.ring(n) json record }
    route GET  /api/gaps             { input status output jaa.gaps json record }
    route GET  /api/failures         { output jaa.failures json record }
    route GET  /api/events           { input n output jaa.event_log.tail(n) json record }
    route GET  /api/memory           { input table n output jaa[table].tail(n) json record }
    route POST /api/memory/search    { input query output jaa.cortex_memory.search(query) json record }
    route POST /api/memory/forget    { input uuid update jaa.cortex_memory set tier = forgotten record }
    route POST /api/event            { input type payload source insert jaa.event_log cobalt_bus.ingest emit sse record }
    route GET  /api/requests         { input status output jaa.requests json record }
    route GET  /api/modules          { output poll_registry.modules json record }
    route POST /api/agent/call       { input prompt agent insert jaa.agent_calls cobalt_bus.ingest record }
    route GET  /sse                  { output sse stream cobalt_bus.ring live_tail record }
    route GET  /guardian/event       { output jaa.bridge_messages json record }
    route POST /guardian/event       { input type payload insert jaa.bridge_messages cobalt_bus.ingest record }
    record
  }
}
