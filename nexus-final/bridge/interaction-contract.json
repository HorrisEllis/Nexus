{
  "id": "bridge-v1",
  "version": "1.0.0",
  "namespace": "bridge",
  "port": 9999,
  "uuid": "bridge-contract-v1-0000-4000-0000-000000000001",
  "role": "message-router — tag engine, request queue, SSE relay",
  "health": { "method": "GET", "path": "/bridge/health", "returns": { "ok": true, "bridge": "nexus-bridge-v1", "sessions": 0, "pendingRequests": 0 } },
  "handshake": { "method": "POST", "path": "/bridge/handshake", "body": { "systemId": "string", "appId": "string", "secret": "string" }, "returns": { "ok": true, "token": "uuid", "sessionId": "uuid", "expiresAt": "ts" } },
  "siso": {
    "emits": ["bridge.request.created","bridge.request.accepted","bridge.request.complete","bridge.request.expired","bridge.request.rejected","bridge.handshake","bridge.tag.added"],
    "consumes": []
  },
  "routes": [
    { "method": "POST", "path": "/bridge/handshake",          "body": ["systemId","appId","secret"] },
    { "method": "GET",  "path": "/bridge/health" },
    { "method": "GET",  "path": "/bridge/stats" },
    { "method": "POST", "path": "/bridge/broadcast",          "body": ["type","payload"] },
    { "method": "GET",  "path": "/bridge/requests",           "params": ["status","from","to","type"] },
    { "method": "POST", "path": "/bridge/requests",           "body": ["type","from","to","payload"] },
    { "method": "GET",  "path": "/bridge/requests/:uuid" },
    { "method": "POST", "path": "/bridge/requests/:uuid/accept",   "body": ["by"] },
    { "method": "POST", "path": "/bridge/requests/:uuid/reject",   "body": ["by","reason"] },
    { "method": "POST", "path": "/bridge/requests/:uuid/complete", "body": ["result"] },
    { "method": "GET",  "path": "/bridge/tags",               "params": ["entityId","system","tag"] },
    { "method": "POST", "path": "/bridge/tags",               "body": ["entityId","entityType","system","tags","addedBy"] },
    { "method": "GET",  "path": "/bridge/tags/:id" },
    { "method": "GET",  "path": "/bridge/subscribe",          "params": ["channel"], "returns": "SSE" },
    { "method": "GET",  "path": "/bridge/pull",               "params": ["channel","since"] },
    { "method": "POST", "path": "/bridge/forward",            "body": ["to","path","payload"] },
    { "method": "POST", "path": "/bridge/purge" }
  ],
  "valid_request_types": ["job.dispatch","job.result","memory.ingest","spec.review","seam.deliver","idea.link","gap.notify"]
}
