// clear-glass/src/profiles/main.eg — Clear Glass's door into profiles.eg: eg run main.eg <file.json> { state, op }, one line of JSON back (AC10).
use "./profiles.eg" as P
let a = args()
if len(a) < 1 { raise("usage: eg run main.eg <file.json>") }
let q = parse_json(read_file(a[0]))
if q.op.op == "resolve" {
  print(json({ ok: true, profile: P.resolve(get(q, "state", {}), str(q.op.account), get(q.op, "wanted", null)) }))
} else {
  print(json(P.apply(get(q, "state", {}), q.op)))
}
