// clear-glass/src/profiles/test/profiles.test.eg — a profile is the source of truth (AC10). eg test clear-glass/src/profiles/test/profiles.test.eg
// James Brooks, 2026-11-18: "the profiles are the source of truth." · "accounts can be used across profiles."
use "../profiles.eg" as P

let ACC = [{ id: "a", label: "Gemini 1", providers: ["gemini"] }, { id: "b", label: "Claude 1", providers: ["claude"] }, { id: "c", label: "Gemini 2", providers: ["gemini"] }]
let INFO = { a: { providers: ["gemini"] }, b: { providers: ["claude"] }, c: { providers: ["gemini"] }, d: { providers: ["chatgpt"] } }
fn start(): map = P.apply({}, { op: "ensure", accounts: ACC, ids: ["p1", "p2", "p3"], now: 1 }).state

test "first run: one default profile on the normal session; a second account on one provider gets its own jar" {
  let s = start()
  expect s.defaultId == "p1" and s.profiles.p1.partition == "default" and s.profiles.p1.accounts == ["a", "b"]
  expect s.profiles.p2.name == "Gemini 2" and s.profiles.p2.partition == "persist:profile-p2" and s.profiles.p2.accounts == ["c"]
}

test "ensure again changes nothing, and places only a new account" {
  let s = start()
  expect P.apply(s, { op: "ensure", accounts: ACC, ids: ["x"], now: 2 }).state == s
  let more = push(ACC, { id: "d", label: "ChatGPT 1", providers: ["chatgpt"] })
  expect P.apply(s, { op: "ensure", accounts: more, ids: ["x"], now: 2 }).state.profiles.p1.accounts == ["a", "b", "d"]
}

test "an account can be in several profiles, but a jar holds one sign-in per site" {
  let s = start()
  let r = P.apply(s, { op: "link", profile: "p2", account: "b", info: INFO, now: 2 })
  expect r.ok and r.state.profiles.p2.accounts == ["c", "b"]
  let no = P.apply(s, { op: "link", profile: "p1", account: "c", info: INFO, now: 2 })
  expect not no.ok and no.why contains "already holds a gemini account"
  expect not P.apply(s, { op: "link", profile: "p1", account: "ghost", info: INFO, now: 2 }).ok
}

test "no account is ever left without a profile" {
  let s = start()
  expect not P.apply(s, { op: "unlink", profile: "p2", account: "c", now: 2 }).ok
  expect not P.apply(s, { op: "delete", profile: "p2", now: 2 }).ok
  expect not P.apply(s, { op: "delete", profile: "p1", now: 2 }).ok
  let two = P.apply(s, { op: "link", profile: "p2", account: "b", info: INFO, now: 2 }).state
  expect P.apply(two, { op: "unlink", profile: "p1", account: "b", now: 3 }).state.profiles.p1.accounts == ["a"]
  let e = P.apply(s, { op: "create", id: "p9", name: "Empty", now: 2 }).state
  expect not has(P.apply(e, { op: "delete", profile: "p9", now: 3 }).state.profiles, "p9")
}

test "names are one each; renames and the default are kept" {
  let s = start()
  expect not P.apply(s, { op: "create", id: "z", name: " default ", now: 2 }).ok
  expect P.apply(s, { op: "rename", profile: "p2", name: "Work", now: 2 }).state.profiles.p2.name == "Work"
  expect not P.apply(s, { op: "rename", profile: "p2", name: "DEFAULT", now: 2 }).ok
  expect P.apply(s, { op: "default", profile: "p2", now: 2 }).state.defaultId == "p2"
}

test "a job runs in the profile asked for when it holds the account, else the default, else the one that does" {
  let s = P.apply(start(), { op: "link", profile: "p2", account: "b", info: INFO, now: 2 }).state
  expect P.resolve(s, "b", "p2").id == "p2"
  expect P.resolve(s, "b", null).id == "p1"
  expect P.resolve(s, "a", "p2").id == "p1"
  expect P.resolve(s, "c", null).id == "p2"
  expect P.resolve(s, "ghost", null) == null
}

test "logins: every signed-in site and saved password, not every site with a cookie" {
  let p = { accounts: ["a"] }
  let cookies = [{ site: "proton.me", name: "AUTH-1" }, { site: "fiverr.com", name: "logged_in" }, { site: "ads.com", name: "_ga_x" }, { site: "news.com", name: "theme" }, { site: "site.com", name: "csrf-token" }, { site: "facebook.com", name: "c_user" }]
  let pw = [{ id: "1", site: "chatgpt.com", username: "u", accountId: null }, { id: "2", site: "proton.me", username: "v", accountId: "a" }, { id: "3", site: "other.com", username: "w", accountId: "zz" }]
  let l = P.logins(p, true, cookies, pw)
  expect map(l, fn(x) = x.site) == ["chatgpt.com", "facebook.com", "fiverr.com", "proton.me"]
  expect l[3].signedIn and l[3].passwords[0].username == "v" and not l[0].signedIn
  expect map(P.logins(p, false, [], pw), fn(x) = x.site) == ["proton.me"]
}

test "one account per login: a site group is one account, its id stays, a provider keeps its existing id" {
  let p = { accounts: ["a"], siteIds: {} }
  let info = { a: { providers: ["gemini"] } }
  let row = fn(site) = { site: site, signedIn: true, cookies: 1, signIns: 1, passwords: [] }
  let one = P.site_accounts(p, [row("google.com"), row("youtube.com"), row("fiverr.com"), row("mp3cut.net")], info, ["n1", "n2"])
  expect map(one.accounts, fn(x) = x.name) == ["fiverr.com", "Google"] or map(one.accounts, fn(x) = x.name) == ["Google", "fiverr.com"]
  expect one.siteIds.google == "a" and one.siteIds["fiverr.com"] == "n1" and one.minted == 1
  let g = filter(one.accounts, fn(x) = x.key == "google")[0]
  expect g.sites == ["google.com", "youtube.com"]
  let two = P.site_accounts({ accounts: ["a"], siteIds: one.siteIds }, [row("fiverr.com")], info, ["other"])
  expect two.accounts[0].id == "n1" and two.minted == 0
  let kept = P.site_accounts(p, [{ site: "mp3cut.net", signedIn: false, cookies: 0, signIns: 0, passwords: [{ id: "1", username: "u" }] }], info, ["n9"])
  expect len(kept.accounts) == 1
  let s = P.apply(start(), { op: "site-ids", profile: "p1", ids: { google: "a" }, now: 2 }).state
  expect s.profiles.p1.siteIds.google == "a"
}
