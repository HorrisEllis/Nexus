payload:
  uuid: fiverr-gig-choose-delivery-v2
  name: Fiverr gig - choose delivery
  urlPattern: fiverr.com
  steps:
    - action: wait_for
      data:
        selector: body
    - action: choose
      data:
        column: '{{tier}}'
        shows: DELIVERY TIME
        option: '{{delivery}}'
        pick: auto
      gate:
        choice:
          column: '{{tier}}'
          is: '{{delivery}}'
        retries: 2
        timeoutMs: 4000
  params:
    - tier
    - delivery
  profile: null
