# The Fiverr gig as a pipeline — bundled with Clear Glass (2026-10-30 PN4). James: "should we rebuild the fiverr plugin?"
envelope: 1
uuid: nexus-export-pipeline-dc4e9d22-077f-482c-9381-6ee1ca5f9d28
type: pipeline
id: dc4e9d22-077f-482c-9381-6ee1ca5f9d28
context: Clear Glass → Settings → Pipelines
intent: >-
  A new Fiverr gig, page by page: Overview (category, subcategory, with your choose-category macro),
  then — after you press Save & Continue — Scope & Pricing (each package). Each page waits at a
  gate. Publish, Save and Continue stay yours.
summary: 3 tasks for https://www.fiverr.com; bundles 2 macro(s), 1 workflow(s), 0 pipeline(s)
system: clear-glass.automation
tags:
  - pipeline
  - site:https://www.fiverr.com
  - step:macro
  - step:gate
  - step:workflow
  - fiverr
  - bundled
exported_at: 1793770469552
source: lib/automation-nodes.js
occurrences: 1
firstSeenAt: 1793770469552
lastSeenAt: 1793770469552
fingerprint: null
payload:
  id: dc4e9d22-077f-482c-9381-6ee1ca5f9d28
  format: nexus-pipeline
  version: 1
  name: Fiverr gig
  description: >-
    A new Fiverr gig, page by page: Overview (category, subcategory, with your choose-category
    macro), then — after you press Save & Continue — Scope & Pricing (each package). Each page waits
    at a gate. Publish, Save and Continue stay yours.
  site: https://www.fiverr.com
  vars:
    category: ''
    subcategory: ''
    basic_name: ''
    basic_description: ''
    basic_delivery: ''
    standard_name: ''
    standard_description: ''
    standard_delivery: ''
    premium_name: ''
    premium_description: ''
    premium_delivery: ''
  settings:
    parallel: 1
  tasks:
    - id: overview
      label: 'Overview: category and subcategory'
      depends_on: []
      step:
        type: macro
        config:
          name: Fiverr gig - choose category
          agentId: default
          params:
            category: '{{vars.category}}'
            subcategory: '{{vars.subcategory}}'
      gate:
        element:
          xpath: >-
            //*[not(ancestor-or-self::a)][not(ancestor-or-self::*[@role='option' or @role='listbox'
            or @role='menu' or
            @id='__cg_spot__'])][translate(normalize-space(text()),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')=translate('{{vars.subcategory}}','ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')]
          visible: true
          timeoutMs: 8000
      retries: 1
      onFail: stop
    - id: on-pricing
      label: You press Save & Continue (your click)
      depends_on:
        - overview
      step:
        type: gate
        config:
          condition: page_text
          value: Scope & Pricing
          timeoutMs: 600000
      retries: 0
      onFail: stop
    - id: pricing
      label: 'Scope & Pricing: each package'
      depends_on:
        - on-pricing
      step:
        type: workflow
        config:
          workflow: Fiverr gig - Scope & Pricing (steps)
          vars:
            basic_name: '{{vars.basic_name}}'
            basic_description: '{{vars.basic_description}}'
            basic_delivery: '{{vars.basic_delivery}}'
            standard_name: '{{vars.standard_name}}'
            standard_description: '{{vars.standard_description}}'
            standard_delivery: '{{vars.standard_delivery}}'
            premium_name: '{{vars.premium_name}}'
            premium_description: '{{vars.premium_description}}'
            premium_delivery: '{{vars.premium_delivery}}'
      retries: 0
      onFail: stop
  requires:
    macros:
      - uuid: fiverr-gig-choose-category-v1
        name: Fiverr gig - choose category
        urlPattern: fiverr.com
        steps:
          - action: wait_for
            data:
              selector: body
          - action: choose
            data:
              shows: SELECT A CATEGORY
              option: '{{category}}'
              pick: auto
            gate:
              xpath: >-
                //*[not(ancestor-or-self::a)][not(ancestor-or-self::*[@role='option' or
                @role='listbox' or @role='menu' or
                @id='__cg_spot__'])][translate(normalize-space(text()),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')=translate('{{category}}','ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')]
              visible: true
              retries: 2
              timeoutMs: 4000
          - action: choose
            data:
              shows: SELECT A SUBCATEGORY
              option: '{{subcategory}}'
              pick: auto
            gate:
              xpath: >-
                //*[not(ancestor-or-self::a)][not(ancestor-or-self::*[@role='option' or
                @role='listbox' or @role='menu' or
                @id='__cg_spot__'])][translate(normalize-space(text()),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')=translate('{{subcategory}}','ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')]
              visible: true
              retries: 2
              timeoutMs: 4000
        params:
          - category
          - subcategory
        profile: null
        description: >-
          Overview of a new gig: pick {{category}} in SELECT A CATEGORY, then {{subcategory}} in
          SELECT A SUBCATEGORY, each gated on the dropdown itself showing the value (GF6).
        createdAt: 1793770469552
        runCount: 0
        lastRunAt: null
      - uuid: fiverr-gig-choose-delivery-v2
        name: Fiverr gig - choose delivery
        urlPattern: fiverr.com
        steps:
          - action: wait_for
            data:
              selector: body
          - action: choose
            data:
              column: '{{tier}}'
              shows: DELIVERY TIME
              option: '{{delivery}}'
              pick: auto
            gate:
              choice:
                column: '{{tier}}'
                is: '{{delivery}}'
              retries: 2
              timeoutMs: 4000
        params:
          - tier
          - delivery
        profile: null
        description: >-
          Scope & Pricing: in the BASIC / STANDARD / PREMIUM column named by {{tier}}, open the
          DELIVERY TIME dropdown and pick {{delivery}} (e.g. "3 Days"). What _gigFill does for each
          *.delivery part.
        createdAt: 1793207566448
        runCount: 0
        lastRunAt: null
    workflows:
      - ref: 2a1a97e1-4e3b-4e22-97cd-f38a6d9df879
        name: Fiverr gig - Scope & Pricing (steps)
        description: >-
          Scope & Pricing page, as editable steps: stops at a human check, types each package name
          and description by its placeholder, picks each delivery time with the "choose delivery"
          macro. A step that cannot find its field is skipped, not fatal. Never saves or publishes.
        vars:
          basic_name: ''
          basic_description: ''
          basic_delivery: ''
          standard_name: ''
          standard_description: ''
          standard_delivery: ''
          premium_name: ''
          premium_description: ''
          premium_delivery: ''
        settings:
          concurrency: queue
          timeoutMs: 120000
        steps:
          - id: 352f87ad-9c9e-4ea7-819a-1d7f351ce0d3
            type: trigger
            config: {}
          - id: f60211b6-7ee9-47fe-8589-f3bf56680cd8
            type: extract
            config:
              page: auto
              mode: page
            label: Page
          - id: 0f2fe3d4-08c4-4c6b-9c56-ec13c9904b53
            type: condition
            config:
              left: '{{steps.Page.output.text}}'
              op: matches
              value: >-
                /press\s*(&|and)\s*hold|px-captcha|verify you are human|checking if the site
                connection is secure/i
              onTrue: 780af295-f7d5-4eed-81b8-5f7a5ee25066
              onFalse: next
            label: Human check?
          - id: b2b7eac4-b292-4366-b78c-2f283cf92c37
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Name your package"])[1]
              value: '{{vars.basic_name}}'
            label: BASIC name
            onError: continue
          - id: d4210c76-fbe5-49b1-bd4e-689bfc83adcc
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Describe the details of your offering"])[1]
              value: '{{vars.basic_description}}'
            label: BASIC description
            onError: continue
          - id: da5beef8-beba-436a-a7bd-ce955f7a809d
            type: macro
            config:
              name: Fiverr gig - choose delivery
              agentId: default
              params: |-
                tier = BASIC
                delivery = {{vars.basic_delivery}}
            label: BASIC delivery
            onError: continue
          - id: 93f7781b-44ca-422b-b290-06fff7681e05
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Name your package"])[2]
              value: '{{vars.standard_name}}'
            label: STANDARD name
            onError: continue
          - id: fce9b9b5-c788-42a5-9eb9-ec3d5b1f6c35
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Describe the details of your offering"])[2]
              value: '{{vars.standard_description}}'
            label: STANDARD description
            onError: continue
          - id: c50601e4-fe49-49d6-a737-a8b7a8b06889
            type: macro
            config:
              name: Fiverr gig - choose delivery
              agentId: default
              params: |-
                tier = STANDARD
                delivery = {{vars.standard_delivery}}
            label: STANDARD delivery
            onError: continue
          - id: f4db6f80-ddbb-480c-9e0f-6d9a5da2cdd0
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Name your package"])[3]
              value: '{{vars.premium_name}}'
            label: PREMIUM name
            onError: continue
          - id: 889f24f3-ec20-421a-9f8a-1ffbd2233a23
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Describe the details of your offering"])[3]
              value: '{{vars.premium_description}}'
            label: PREMIUM description
            onError: continue
          - id: b4f6e044-a041-4907-b229-76fe223b1e9f
            type: macro
            config:
              name: Fiverr gig - choose delivery
              agentId: default
              params: |-
                tier = PREMIUM
                delivery = {{vars.premium_delivery}}
            label: PREMIUM delivery
            onError: continue
          - id: 9729e5c8-9303-4da2-b5e4-56c1b6e78783
            type: stop
            config: {}
            label: Done
          - id: 780af295-f7d5-4eed-81b8-5f7a5ee25066
            type: notify
            config:
              title: 'Fiverr: a human check is up'
              body: Nothing was typed. The check is yours to pass; run this again after.
            label: Held
          - id: 2b7f22ef-1585-4e05-ad71-8a7eddaa2e84
            type: stop
            config: {}
            label: Stop
    pipelines: []
