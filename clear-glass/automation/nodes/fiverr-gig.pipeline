# The Fiverr gig as a pipeline — bundled with Clear Glass (2026-10-30 PN4). James: "should we rebuild the fiverr plugin?"
envelope: 1
uuid: nexus-export-pipeline-035e79d4-6546-403c-a67f-f7319bcd0b39
type: pipeline
id: 035e79d4-6546-403c-a67f-f7319bcd0b39
context: Clear Glass → Settings → Pipelines
intent: >-
  A new Fiverr gig, page by page: Overview (category, subcategory, with your choose-category macro),
  then — after you press Save & Continue — Scope & Pricing (each package). Each page waits at a
  gate. Publish, Save and Continue stay yours.
summary: 3 tasks for https://www.fiverr.com; bundles 2 macro(s), 1 workflow(s), 0 pipeline(s)
system: clear-glass.automation
tags:
  - pipeline
  - site:https://www.fiverr.com
  - step:macro
  - step:gate
  - step:workflow
  - fiverr
  - bundled
exported_at: 1793363036821
source: lib/automation-nodes.js
occurrences: 1
firstSeenAt: 1793363036821
lastSeenAt: 1793363036821
fingerprint: null
payload:
  id: 035e79d4-6546-403c-a67f-f7319bcd0b39
  format: nexus-pipeline
  version: 1
  name: Fiverr gig
  description: >-
    A new Fiverr gig, page by page: Overview (category, subcategory, with your choose-category
    macro), then — after you press Save & Continue — Scope & Pricing (each package). Each page waits
    at a gate. Publish, Save and Continue stay yours.
  site: https://www.fiverr.com
  vars:
    category: ''
    subcategory: ''
    basic_name: ''
    basic_description: ''
    basic_delivery: ''
    standard_name: ''
    standard_description: ''
    standard_delivery: ''
    premium_name: ''
    premium_description: ''
    premium_delivery: ''
  settings:
    parallel: 1
  tasks:
    - id: overview
      label: 'Overview: category and subcategory'
      depends_on: []
      step:
        type: macro
        config:
          name: Fiverr gig - choose category
          agentId: default
          params:
            category: '{{vars.category}}'
            subcategory: '{{vars.subcategory}}'
      gate:
        element:
          xpath: >-
            //*[not(ancestor-or-self::a)][not(ancestor-or-self::*[@role='option' or @role='listbox'
            or
            @role='menu'])][translate(normalize-space(text()),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')=translate('{{vars.subcategory}}','ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')]
          visible: true
          timeoutMs: 8000
      retries: 1
      onFail: stop
    - id: on-pricing
      label: You press Save & Continue (your click)
      depends_on:
        - overview
      step:
        type: gate
        config:
          condition: page_text
          value: Scope & Pricing
          timeoutMs: 600000
      retries: 0
      onFail: stop
    - id: pricing
      label: 'Scope & Pricing: each package'
      depends_on:
        - on-pricing
      step:
        type: workflow
        config:
          workflow: Fiverr gig - Scope & Pricing (steps)
          vars:
            basic_name: '{{vars.basic_name}}'
            basic_description: '{{vars.basic_description}}'
            basic_delivery: '{{vars.basic_delivery}}'
            standard_name: '{{vars.standard_name}}'
            standard_description: '{{vars.standard_description}}'
            standard_delivery: '{{vars.standard_delivery}}'
            premium_name: '{{vars.premium_name}}'
            premium_description: '{{vars.premium_description}}'
            premium_delivery: '{{vars.premium_delivery}}'
      retries: 0
      onFail: stop
  requires:
    macros:
      - uuid: fiverr-gig-choose-category-v1
        name: Fiverr gig - choose category
        urlPattern: fiverr.com
        steps:
          - action: wait_for
            data:
              selector: body
          - action: choose
            data:
              shows: SELECT A CATEGORY
              option: '{{category}}'
              pick: auto
            gate:
              xpath: >-
                //*[not(ancestor-or-self::a)][not(ancestor-or-self::*[@role='option' or
                @role='listbox' or
                @role='menu'])][translate(normalize-space(text()),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')=translate('{{category}}','ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')]
              visible: true
              retries: 2
              timeoutMs: 4000
          - action: choose
            data:
              shows: SELECT A SUBCATEGORY
              option: '{{subcategory}}'
              pick: auto
            gate:
              xpath: >-
                //*[not(ancestor-or-self::a)][not(ancestor-or-self::*[@role='option' or
                @role='listbox' or
                @role='menu'])][translate(normalize-space(text()),'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')=translate('{{subcategory}}','ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz')]
              visible: true
              retries: 2
              timeoutMs: 4000
        params:
          - category
          - subcategory
        profile: null
        description: >-
          Overview of a new gig: pick {{category}} in SELECT A CATEGORY, then {{subcategory}} in
          SELECT A SUBCATEGORY, each gated on the dropdown itself showing the value (GF6).
        createdAt: 1793363036821
        runCount: 0
        lastRunAt: null
      - uuid: fiverr-gig-choose-delivery-v2
        name: Fiverr gig - choose delivery
        urlPattern: fiverr.com
        steps:
          - action: wait_for
            data:
              selector: body
          - action: choose
            data:
              column: '{{tier}}'
              shows: DELIVERY TIME
              option: '{{delivery}}'
              pick: auto
            gate:
              choice:
                column: '{{tier}}'
                is: '{{delivery}}'
              retries: 2
              timeoutMs: 4000
        params:
          - tier
          - delivery
        profile: null
        description: >-
          Scope & Pricing: in the BASIC / STANDARD / PREMIUM column named by {{tier}}, open the
          DELIVERY TIME dropdown and pick {{delivery}} (e.g. "3 Days"). What _gigFill does for each
          *.delivery part.
        createdAt: 1793207566448
        runCount: 0
        lastRunAt: null
    workflows:
      - ref: 48026490-c0d5-41a2-b5f8-5d85a62e0a2a
        name: Fiverr gig - Scope & Pricing (steps)
        description: >-
          Scope & Pricing page, as editable steps: stops at a human check, types each package name
          and description by its placeholder, picks each delivery time with the "choose delivery"
          macro. A step that cannot find its field is skipped, not fatal. Never saves or publishes.
        vars:
          basic_name: ''
          basic_description: ''
          basic_delivery: ''
          standard_name: ''
          standard_description: ''
          standard_delivery: ''
          premium_name: ''
          premium_description: ''
          premium_delivery: ''
        settings:
          concurrency: queue
          timeoutMs: 120000
        steps:
          - id: 648d4e9e-4fb5-4e6d-9575-eec81ecdba50
            type: trigger
            config: {}
          - id: 36017a13-b5ff-41cd-a731-581bcf7d567c
            type: extract
            config:
              page: auto
              mode: page
            label: Page
          - id: 5f957d7e-8151-4d9b-ac3f-1f0b73d79cc7
            type: condition
            config:
              left: '{{steps.Page.output.text}}'
              op: matches
              value: >-
                /press\s*(&|and)\s*hold|px-captcha|verify you are human|checking if the site
                connection is secure/i
              onTrue: e479876b-b6f2-4e99-b955-0366a41b1e76
              onFalse: next
            label: Human check?
          - id: 4faef9ac-d2c9-435e-b2e9-17efeec284a0
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Name your package"])[1]
              value: '{{vars.basic_name}}'
            label: BASIC name
            onError: continue
          - id: 70a5f9c6-a343-4d53-a03a-8557cdd15354
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Describe the details of your offering"])[1]
              value: '{{vars.basic_description}}'
            label: BASIC description
            onError: continue
          - id: 7e2d8813-3dc2-4d5a-a7e1-395fce7cddb3
            type: macro
            config:
              name: Fiverr gig - choose delivery
              agentId: default
              params: |-
                tier = BASIC
                delivery = {{vars.basic_delivery}}
            label: BASIC delivery
            onError: continue
          - id: 22fb8959-1636-4e4f-bb6f-ae1454998caa
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Name your package"])[2]
              value: '{{vars.standard_name}}'
            label: STANDARD name
            onError: continue
          - id: b2cc6131-6414-45b8-a43d-55398ab67bb0
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Describe the details of your offering"])[2]
              value: '{{vars.standard_description}}'
            label: STANDARD description
            onError: continue
          - id: 61a8a1e9-c47d-4cfd-a49d-acc1544c888f
            type: macro
            config:
              name: Fiverr gig - choose delivery
              agentId: default
              params: |-
                tier = STANDARD
                delivery = {{vars.standard_delivery}}
            label: STANDARD delivery
            onError: continue
          - id: cdeff3f5-8da8-4811-b375-bb9d62366c35
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Name your package"])[3]
              value: '{{vars.premium_name}}'
            label: PREMIUM name
            onError: continue
          - id: db56e96c-76e0-422c-9a80-5f3751fc1979
            type: browser
            config:
              action: fill
              page: auto
              selector: (//*[@placeholder="Describe the details of your offering"])[3]
              value: '{{vars.premium_description}}'
            label: PREMIUM description
            onError: continue
          - id: 33437e72-ed76-4201-a9b1-7032f540839e
            type: macro
            config:
              name: Fiverr gig - choose delivery
              agentId: default
              params: |-
                tier = PREMIUM
                delivery = {{vars.premium_delivery}}
            label: PREMIUM delivery
            onError: continue
          - id: 8d80c8b9-5545-449e-ab49-8b7cced2b6c9
            type: stop
            config: {}
            label: Done
          - id: e479876b-b6f2-4e99-b955-0366a41b1e76
            type: notify
            config:
              title: 'Fiverr: a human check is up'
              body: Nothing was typed. The check is yours to pass; run this again after.
            label: Held
          - id: e41a7f44-d2f5-444a-99b9-29e98152a1b8
            type: stop
            config: {}
            label: Stop
    pipelines: []
