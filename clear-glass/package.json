{
  "name": "clear-glass",
  "version": "3.15.0",
  "description": "NEXUS sovereign browser — SISO-native →E→E→",
  "main": "src/main/index.js",
  "author": "James Brooks (Erosmancer)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "node test/bus.test.js && node test/storage-jaa.test.js && node test/watchdog.test.js && node test/downloads-intake-bridge.test.js && node test/userscripts-manifest.test.js && node test/network-install.test.js",
    "test:bus": "node test/bus.test.js",
    "test:storage-jaa": "node test/storage-jaa.test.js",
    "test:watchdog": "node test/watchdog.test.js",
    "test:downloads-intake-bridge": "node test/downloads-intake-bridge.test.js",
    "test:userscripts-manifest": "node test/userscripts-manifest.test.js",
    "test:network-install": "node test/network-install.test.js",
    "wire": "node wire/nexus-wire.js",
    "build": "electron-builder",
    "start:headless": "CG_HEADLESS=1 electron .",
    "start:tray": "CG_HEADLESS=1 electron . --tray-only"
  },
  "dependencies": {
    "electron": "^42.5.0",
    "express": "^4.22.2",
    "js-yaml": "^5.4.1",
    "node-fetch": "^2.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "world.rheon.clear-glass",
    "productName": "Clear Glass",
    "directories": {
      "output": "dist"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
