{
  "name": "erosmancer-os",
  "version": "0.3.0",
  "description": "ErosmancerOS — CDP-native browser orchestration engine",
  "type": "commonjs",
  "main": "src/index.ts",
  "scripts": {
    "start": "npx tsx src/api/server.ts",
    "dev": "npx tsx watch src/api/server.ts",
    "test": "npx tsx tests/suite.ts",
