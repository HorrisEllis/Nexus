// continuous-stream.eg — LLM session ring buffer 4096 chunks
// UUID: continuous-stream-v1-0-0 | source: memory/continuous-stream.js
compartment "continuous-stream" {
  id = continuous-stream-001
  uuid = continuous-stream-001-xxxx
  intent = ring_4096_chunks_per_session_crash_safe_partial_recovery
  component "ring" {
    state { ring = Ring(4096) ringHead = 0 sessions = Map(64) subscribers = [] }
    on chunk {
      input sessionId agentId text isFinal
      record = { seq = uid sessionId agentId text isFinal wall = now }
      ring[ringHead % 4096] = record
      ringHead++
      session = sessions.get(sessionId)
      session.chunks.push record
      for each sub in subscribers { sub(record) }
      if isFinal
        assembled = session.chunks.map(c => c.text).join("")
        update jaa.agent_calls where sessionId set assembled = assembled
        emit "stream.session.complete" { sessionId assembled }
        record
    }
    on subscribe { input fn subscribers.push fn record }
  }
}
