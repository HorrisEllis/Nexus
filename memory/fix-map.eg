// fix-map.eg — healer resolution record store
// UUID: fix-map-v1-0-0 | source: memory/fix-map.js
compartment "fix-map" {
  id = fix-map-001
  uuid = fix-map-001-xxxx
  intent = persist_healer_prescriptions_feed_conditioning_loop
  reads  = [ gaps ]
  writes = [ fix_map conditioning_log event_log ]
  component "writer" {
    on healer.prescription {
      input gap strategy action automated
      insert jaa.fix_map { uuid = uid gapUuid = gap.uuid gapType = gap.type strategy action automated status = applied causedBy = gap.uuid ts = now }
      if strategy == condition_the_agent
        insert jaa.conditioning_log { uuid = uid agentId = preferred_agent instruction = action.instruction ts = now }
      emit "fix_map.written"
      record
    }
  }
}
