// feedback-weighter.eg — human ratings → EMA retrieval weight
// UUID: feedback-weighter-v1-0-0 | source: memory/feedback-weighter.js
compartment "feedback-weighter" {
  id = feedback-weighter-001
  uuid = feedback-weighter-001-xxxx
  intent = ratings_close_the_loop_good_recall_surfaces_higher
  reads  = [ feedback_scores memory_index ]
  writes = [ feedback_scores memory_index ]
  component "weighter" {
    on feedback.submitted {
      input traceId score
      normalised = (score - 1) / 9
      recall_trace = get_recall_trace(traceId)
      for each item in recall_trace.items
        current = jaa.memory_index.get(item.uuid).retrievalWeight
        updated = ema(current normalised alpha = 0.25)
        update jaa.memory_index where uuid == item.uuid set retrievalWeight = updated
        insert jaa.feedback_scores { uuid = uid agentId = recall_trace.agentId score = normalised source = feedback traceId = traceId ts = now }
        record
    }
  }
}
