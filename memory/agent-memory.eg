// agent-memory.eg — event_log → memory_index distiller
// UUID: agent-memory-v1-0-0 | source: memory/agent-memory.js
compartment "agent-memory" {
  id = agent-memory-001
  uuid = agent-memory-001-xxxx
  intent = scan_event_log_distill_significant_events_to_memory_index
  invariant { axiom NO_SILENT_DROP }
  reads  = [ event_log failures gaps ]
  writes = [ memory_index memory_queries cortex_memory ]
  component "distiller" {
    interval = 4000
    sigma observe new_events = jaa.event_log where _rowId > last_rowId
    for each ev in new_events
      if significant(ev)
        if not exists jaa.memory_index where sourceEventUuid == ev.uuid
          tags = tags_for(ev)
          summary = summarize(ev)
          insert jaa.memory_index { uuid = uid content = summary tags = tags source = agent-memory sourceEventUuid = ev.uuid sourceEventType = ev.type retrievalWeight = 1.0 causedBy = ev.uuid ts = now }
          record
      last_rowId = ev._rowId
  }
  component "crystal-builder" {
    interval = 30000
    sigma observe patterns
    if pattern.confidence >= 0.7
      insert jaa.crystals { content = pattern.summary pattern_type = pattern.type source_ids = pattern.sources confidence = pattern.confidence state = candidate ts = now }
      record
  }
}
