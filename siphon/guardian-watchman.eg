// guardian-watchman.eg — health score < 0.3 → gap + toast.error
// UUID: guardian-watchman-v1-0-0
compartment "guardian-watchman" {
  id = guardian-watchman-001
  uuid = guardian-watchman-001-xxxx
  intent = health_monitor_score_below_0_3_emits_gap_toast_error
  reads  = [ guardian_nodes ]
  writes = [ guardian_health gaps event_log ]
  component "monitor" {
    interval = 5000
    nodes = jaa.guardian_nodes.all
    connected = nodes.filter(now - lastSeen < 25000)
    stale = nodes.filter(now - lastSeen >= 25000)
    healthScore = connected.length / max(1 nodes.length)
    insert jaa.guardian_health { uuid = uid connected = connected.length > 0 listenerCount = sum(connected.listenerCount) sessionCount = count(open_sessions) staleNodes = stale.map(n => n.instanceId) healthScore ts = now }
    if healthScore < 0.3
      insert jaa.gaps { uuid = uid type = guardian_health_critical severity = high body = "health " + healthScore status = open source = watchman ts = now }
      emit "toast.error" { msg = "Guardian health critical: " + healthScore }
      record
  }
}
