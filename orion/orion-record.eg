// orion-record.eg — feature extraction from measured sessions
// UUID: orion-record-v1-0-0 | source: orion/record.js
compartment "orion-record" {
  id = orion-record-001
  uuid = orion-record-001-xxxx
  intent = extract_behavioral_features_from_measured_session
  reads  = [ orion_sessions ]
  writes = [ orion_sessions shape_samples ]
  component "extractor" {
    interval = 1000
    query jaa.orion_sessions where status == measured limit 10
    for each session in measured
      update jaa.orion_sessions set status = recording
      features = extract_features(session.events)
      insert jaa.shape_samples { uuid = uid calltoId = session.calltoId features regime = classify(features) sigma = compute_sigma(features) committed = false ts = now }
      update jaa.orion_sessions set features = features status = recorded
      emit "orion.session.recorded" { uuid = session.uuid }
      record
  }
}
