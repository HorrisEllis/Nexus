// orion-verify.eg — verdict confirmation
// UUID: orion-verify-v1-0-0 | source: orion/verify.js
compartment "orion-verify" {
  id = orion-verify-001
  uuid = orion-verify-001-xxxx
  intent = confirm_policy_verdict_update_trust_emit_final_event
  reads  = [ orion_sessions ]
  writes = [ orion_sessions event_log ]
  component "verifier" {
    interval = 3000
    query jaa.orion_sessions where status == evaluated limit 10
    for each session in evaluated
      if session.verdict.passed
        trust.record(session.calltoId passed = true)
        update jaa.orion_sessions set status = verified
        emit "orion.session.verified" { uuid = session.uuid }
        record
      else
        trust.record(session.calltoId passed = false)
        insert jaa.gaps { type = orion_policy_violation severity = medium body = session.verdict.reason status = pending }
        update jaa.orion_sessions set status = rejected
        emit "orion.session.rejected" { uuid = session.uuid reason = session.verdict.reason }
        record
  }
}
